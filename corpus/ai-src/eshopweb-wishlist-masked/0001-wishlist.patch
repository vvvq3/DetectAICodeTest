+}
diff --git a/src/ApplicationCore/Services/WishlistService.cs b/src/ApplicationCore/Services/WishlistService.cs
new file mode 100644
index 0000000..138d597
--- /dev/null
+++ b/src/ApplicationCore/Services/WishlistService.cs
@@ -0,0 +1,60 @@
+using Ardalis.GuardClauses;
+using Microsoft.eShopWeb.ApplicationCore.Entities;
+using Microsoft.eShopWeb.ApplicationCore.Entities.WishlistAggregate;
+using Microsoft.eShopWeb.ApplicationCore.Interfaces;
+using Microsoft.eShopWeb.ApplicationCore.Specifications;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace Microsoft.eShopWeb.ApplicationCore.Services
+{
+    public class WishlistService : IWishlistService
+    {
+        private readonly IAsyncRepository<Wishlist> _wishlistRepository;
+        private readonly IAsyncRepository<CatalogItem> _itemRepository;
+        private readonly IAppLogger<WishlistService> _logger;
+
+        public WishlistService(IAsyncRepository<Wishlist> wishlistRepository,
+            IAsyncRepository<CatalogItem> itemRepository,
+            IAppLogger<WishlistService> logger)
+        {
+            _wishlistRepository = wishlistRepository;
+            _itemRepository = itemRepository;
+            _logger = logger;
+        }
+
+        public async Task<Wishlist> GetOrCreateWishlistAsync(string buyerId, CancellationToken cancellationToken = default)
+        {
+            Guard.Against.NullOrEmpty(buyerId, nameof(buyerId));
+
+            var spec = new WishlistWithItemsSpecification(buyerId);
+            var wishlist = await _wishlistRepository.FirstOrDefaultAsync(spec, cancellationToken);
+            if (wishlist != null)
+            {
+                return wishlist;
+            }
+
+            wishlist = new Wishlist(buyerId);
+            return await _wishlistRepository.AddAsync(wishlist, cancellationToken);
+        }
+
+        public async Task AddItemAsync(string buyerId, int catalogItemId, CancellationToken cancellationToken = default)
+        {
+            var catalogItem = await _itemRepository.GetByIdAsync(catalogItemId, cancellationToken);
+            Guard.Against.Null(catalogItem, nameof(catalogItem));
+
+            var wishlist = await GetOrCreateWishlistAsync(buyerId, cancellationToken);
+            wishlist.AddItem(catalogItemId);
+            await _wishlistRepository.UpdateAsync(wishlist, cancellationToken);
+
+            _logger.LogInformation("Item {catalogItemId} added to wishlist of {buyerId}", catalogItemId, buyerId);
+        }
+
+        public async Task RemoveItemAsync(string buyerId, int catalogItemId, CancellationToken cancellationToken = default)
+        {
+            var wishlist = await GetOrCreateWishlistAsync(buyerId, cancellationToken);
+            wishlist.RemoveItem(catalogItemId);
+            await _wishlistRepository.UpdateAsync(wishlist, cancellationToken);
+        }
+    }
+}
diff --git a/src/ApplicationCore/Specifications/WishlistWithItemsSpecification.cs b/src/ApplicationCore/Specifications/WishlistWithItemsSpecification.cs
