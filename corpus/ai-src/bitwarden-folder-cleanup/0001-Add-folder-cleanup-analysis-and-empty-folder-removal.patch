+using System;
+using System.Threading;
+using System.Threading.Tasks;
+using Bit.Core.Models.Data;
+
+namespace Bit.Core.Services
+{
+    /// <summary>
+    /// Provides operations for detecting and removing empty or duplicate folders.
+    /// </summary>
+    public interface IFolderCleanupService
+    {
+        /// <summary>
+        /// Analyzes the folders of the specified user without modifying them.
+        /// </summary>
+        /// <param name="userId">The identifier of the user.</param>
+        /// <param name="cancellationToken">A token to cancel the operation.</param>
+        /// <returns>A summary of empty and duplicate folders.</returns>
+        Task<FolderCleanupSummary> AnalyzeAsync(Guid userId, CancellationToken cancellationToken = default);
+
+        /// <summary>
+        /// Deletes all empty folders of the specified user.
+        /// </summary>
+        /// <param name="userId">The identifier of the user.</param>
+        /// <param name="cancellationToken">A token to cancel the operation.</param>
+        /// <returns>The number of deleted folders.</returns>
+        Task<int> DeleteEmptyFoldersAsync(Guid userId, CancellationToken cancellationToken = default);
+    }
+}
