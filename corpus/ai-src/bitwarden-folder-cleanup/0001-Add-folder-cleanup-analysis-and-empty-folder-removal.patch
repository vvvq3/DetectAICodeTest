+using System;
+using System.Collections.Generic;
+using Bit.Core.Models.Data;
+
+namespace Bit.Core.Models.Api
+{
+    public class FolderCleanupResponseModel : ResponseModel
+    {
+        public FolderCleanupResponseModel(FolderCleanupSummary summary)
+            : base("folderCleanup")
+        {
+            if (summary == null)
+            {
+                throw new ArgumentNullException(nameof(summary));
+            }
+
+            TotalFolders = summary.TotalFolders;
+            EmptyFolderIds = summary.EmptyFolderIds;
+            DuplicateFolderGroups = summary.DuplicateFolderGroups;
+        }
+
+        public int TotalFolders { get; set; }
+        public IEnumerable<Guid> EmptyFolderIds { get; set; }
+        public IEnumerable<IEnumerable<Guid>> DuplicateFolderGroups { get; set; }
+    }
+}
