new file mode 100644
index 000000000..8f358e78d
--- /dev/null
+++ b/src/Core/Services/Implementations/FolderCleanupService.cs
@@ -0,0 +1,102 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+using Bit.Core.Models.Data;
+using Bit.Core.Repositories;
+using Microsoft.Extensions.Logging;
+
+namespace Bit.Core.Services
+{
+    public class FolderCleanupService : IFolderCleanupService
+    {
+        private readonly IFolderRepository _folderRepository;
+        private readonly ICipherRepository _cipherRepository;
+        private readonly ILogger<FolderCleanupService> _logger;
+
+        public FolderCleanupService(
+            IFolderRepository folderRepository,
+            ICipherRepository cipherRepository,
+            ILogger<FolderCleanupService> logger)
+        {
+            _folderRepository = folderRepository ?? throw new ArgumentNullException(nameof(folderRepository));
+            _cipherRepository = cipherRepository ?? throw new ArgumentNullException(nameof(cipherRepository));
+            _logger = logger ?? throw new ArgumentNullException(nameof(logger));
+        }
+
+        public async Task<FolderCleanupSummary> AnalyzeAsync(Guid userId, CancellationToken cancellationToken = default)
+        {
+            if (userId == Guid.Empty)
+            {
+                throw new ArgumentException("User id must not be empty.", nameof(userId));
+            }
+
+            var folders = await _folderRepository.GetManyByUserIdAsync(userId);
+            cancellationToken.ThrowIfCancellationRequested();
+
+            var ciphers = await _cipherRepository.GetManyByUserIdAsync(userId, withOrganizations: false);
+            var usedFolderIds = new HashSet<Guid>(ciphers
+                .Where(c => c.Folders != null)
+                .SelectMany(c => ExtractFolderIds(c.Folders, userId)));
+
+            var emptyFolderIds = folders
+                .Where(f => !usedFolderIds.Contains(f.Id))
+                .Select(f => f.Id)
+                .ToList();
+
+            // Folder names are encrypted client-side, so duplicates can only be detected by identical cipher strings.
+            var duplicateGroups = folders
+                .GroupBy(f => f.Name, StringComparer.Ordinal)
+                .Where(g => g.Count() > 1)
+                .Select(g => (IReadOnlyList<Guid>)g.Select(f => f.Id).ToList())
+                .ToList();
+
+            _logger.LogInformation(
+                "Folder cleanup analysis for user {UserId}: {TotalFolders} folders, {EmptyFolders} empty, {DuplicateGroups} duplicate groups",
+                userId,
+                folders.Count,
+                emptyFolderIds.Count,
+                duplicateGroups.Count);
+
+            return new FolderCleanupSummary
+            {
+                TotalFolders = folders.Count,
+                EmptyFolderIds = emptyFolderIds,
+                DuplicateFolderGroups = duplicateGroups
+            };
+        }
+
+        public async Task<int> DeleteEmptyFoldersAsync(Guid userId, CancellationToken cancellationToken = default)
+        {
+            var summary = await AnalyzeAsync(userId, cancellationToken);
+            var deleted = 0;
+
+            foreach (var folderId in summary.EmptyFolderIds)
+            {
+                cancellationToken.ThrowIfCancellationRequested();
+
+                var folder = await _folderRepository.GetByIdAsync(folderId, userId);
+                if (folder is null)
+                {
+                    continue;
+                }
+
+                await _folderRepository.DeleteAsync(folder);
+                deleted++;
+            }
+
+            _logger.LogInformation("Deleted {DeletedCount} empty folders for user {UserId}", deleted, userId);
+            return deleted;
+        }
+
+        private static IEnumerable<Guid> ExtractFolderIds(string foldersJson, Guid userId)
+        {
+            var folders = CoreHelpers.LoadClassFromJsonData<Dictionary<Guid, Guid>>(foldersJson);
+            if (folders != null && folders.TryGetValue(userId, out var folderId))
+            {
+                yield return folderId;
+            }
+        }
+    }
+}
