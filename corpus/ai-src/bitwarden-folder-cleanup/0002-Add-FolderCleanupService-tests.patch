+using System;
+using System.Collections.Generic;
+using System.Threading.Tasks;
+using Bit.Core.Models.Table;
+using Bit.Core.Repositories;
+using Bit.Core.Services;
+using Microsoft.Extensions.Logging.Abstractions;
+using NSubstitute;
+using Xunit;
+
+namespace Bit.Core.Test.Services
+{
+    public class FolderCleanupServiceTests
+    {
+        private readonly IFolderRepository _folderRepository = Substitute.For<IFolderRepository>();
+        private readonly ICipherRepository _cipherRepository = Substitute.For<ICipherRepository>();
+        private readonly FolderCleanupService _sut;
+
+        public FolderCleanupServiceTests()
+        {
+            _sut = new FolderCleanupService(_folderRepository, _cipherRepository, NullLogger<FolderCleanupService>.Instance);
+        }
+
+        [Fact]
+        public async Task AnalyzeAsync_EmptyUserId_ThrowsArgumentException()
+        {
+            await Assert.ThrowsAsync<ArgumentException>(() => _sut.AnalyzeAsync(Guid.Empty));
+        }
+
+        [Fact]
+        public async Task AnalyzeAsync_FolderWithoutCiphers_IsReportedAsEmpty()
+        {
+            // Arrange
+            var userId = Guid.NewGuid();
+            var folder = new Folder { Id = Guid.NewGuid(), UserId = userId, Name = "2.abc|def" };
+            _folderRepository.GetManyByUserIdAsync(userId).Returns(new List<Folder> { folder });
+            _cipherRepository.GetManyByUserIdAsync(userId, false).Returns(new List<Bit.Core.Models.Data.CipherDetails>());
+
+            // Act
+            var summary = await _sut.AnalyzeAsync(userId);
+
+            // Assert
+            Assert.Equal(1, summary.TotalFolders);
+            Assert.Contains(folder.Id, summary.EmptyFolderIds);
+        }
+
+        [Fact]
+        public async Task AnalyzeAsync_FoldersWithSameName_AreGroupedAsDuplicates()
+        {
+            // Arrange
+            var userId = Guid.NewGuid();
+            var folders = new List<Folder>
+            {
+                new Folder { Id = Guid.NewGuid(), UserId = userId, Name = "2.same" },
+                new Folder { Id = Guid.NewGuid(), UserId = userId, Name = "2.same" },
+                new Folder { Id = Guid.NewGuid(), UserId = userId, Name = "2.other" },
+            };
+            _folderRepository.GetManyByUserIdAsync(userId).Returns(folders);
+            _cipherRepository.GetManyByUserIdAsync(userId, false).Returns(new List<Bit.Core.Models.Data.CipherDetails>());
+
+            // Act
+            var summary = await _sut.AnalyzeAsync(userId);
+
+            // Assert
+            Assert.Single(summary.DuplicateFolderGroups);
+            Assert.Equal(2, summary.DuplicateFolderGroups[0].Count);
+        }
+    }
+}
