+using System;
+using System.Linq;
+using Nop.Core.Domain.Orders;
+using Nop.Core.Domain.Payments;
+using Nop.Data;
+using Nop.Services.Common;
+using Nop.Services.Localization;
+using Nop.Services.Logging;
+using Nop.Services.Tasks;
+
+namespace Nop.Services.Orders
+{
+    /// <summary>
+    /// Represents a task to cancel pending orders that were not paid in time
+    /// </summary>
+    public partial class AutoCancelPendingOrdersTask : IScheduleTask
+    {
+        #region Fields
+
+        private readonly IGenericAttributeService _genericAttributeService;
+        private readonly ILocalizationService _localizationService;
+        private readonly ILogger _logger;
+        private readonly IOrderProcessingService _orderProcessingService;
+        private readonly IRepository<Order> _orderRepository;
+        private readonly OrderSettings _orderSettings;
+
+        #endregion
+
+        #region Ctor
+
+        public AutoCancelPendingOrdersTask(IGenericAttributeService genericAttributeService,
+            ILocalizationService localizationService,
+            ILogger logger,
+            IOrderProcessingService orderProcessingService,
+            IRepository<Order> orderRepository,
+            OrderSettings orderSettings)
+        {
+            _genericAttributeService = genericAttributeService;
+            _localizationService = localizationService;
+            _logger = logger;
+            _orderProcessingService = orderProcessingService;
+            _orderRepository = orderRepository;
+            _orderSettings = orderSettings;
+        }
+
+        #endregion
+
+        #region Utilities
+
+        /// <summary>
+        /// Gets pending unpaid orders created before the specified date
+        /// </summary>
+        /// <param name="createdBeforeUtc">Date</param>
+        /// <returns>Orders</returns>
+        protected virtual IQueryable<Order> GetExpiredPendingOrders(DateTime createdBeforeUtc)
+        {
+            return _orderRepository.Table.Where(o =>
+                !o.Deleted &&
+                o.OrderStatusId == (int)OrderStatus.Pending &&
+                o.PaymentStatusId == (int)PaymentStatus.Pending &&
+                o.CreatedOnUtc < createdBeforeUtc);
+        }
+
+        #endregion
+
+        #region Methods
+
+        /// <summary>
+        /// Executes a task
+        /// </summary>
+        public virtual void Execute()
+        {
+            //task is disabled
+            if (_orderSettings.AutoCancelPendingOrdersAfterHours <= 0)
+                return;
+
+            var createdBeforeUtc = DateTime.UtcNow.AddHours(-_orderSettings.AutoCancelPendingOrdersAfterHours);
+            var orders = GetExpiredPendingOrders(createdBeforeUtc).Take(500).ToList();
+
+            foreach (var order in orders)
+            {
+                //order could be paid by another process in the meantime
+                if (!_orderProcessingService.CanCancelOrder(order))
+                    continue;
+
+                try
+                {
+                    _orderProcessingService.CancelOrder(order, true);
+
+                    //save reason
+                    _genericAttributeService.SaveAttribute(order, NopOrderDefaults.AutoCancelledAttribute, true);
+                }
+                catch (Exception exc)
+                {
+                    _logger.Error(string.Format(_localizationService.GetResource("ScheduleTasks.AutoCancelPendingOrders.Error"), order.Id), exc);
+                }
+            }
+        }
+
+        #endregion
+    }
+}
