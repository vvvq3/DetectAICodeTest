+using System;
+
+namespace Jellyfin.Api.Models.WatchHistoryDtos
+{
+    /// <summary>
+    /// Represents a single entry in the user's watch history export.
+    /// </summary>
+    public class WatchHistoryEntryDto
+    {
+        /// <summary>
+        /// Gets or sets the item id.
+        /// </summary>
+        public Guid ItemId { get; set; }
+
+        /// <summary>
+        /// Gets or sets the item name.
+        /// </summary>
+        public string Name { get; set; } = string.Empty;
+
+        /// <summary>
+        /// Gets or sets the series name, if the item is an episode.
+        /// </summary>
+        public string? SeriesName { get; set; }
+
+        /// <summary>
+        /// Gets or sets the item type.
+        /// </summary>
+        public string ItemType { get; set; } = string.Empty;
+
+        /// <summary>
+        /// Gets or sets the date the item was last played, in UTC.
+        /// </summary>
+        public DateTime? LastPlayedDate { get; set; }
+
+        /// <summary>
+        /// Gets or sets the number of times the item was played.
+        /// </summary>
+        public int PlayCount { get; set; }
+    }
+}
