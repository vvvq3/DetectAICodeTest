+using Notifications.API.Models;
+using Notifications.API.Services;
+
+namespace Notifications.API.Endpoints;
+
+public static class NotificationEndpoints
+{
+    public static IEndpointRouteBuilder MapNotificationEndpoints(this IEndpointRouteBuilder app)
+    {
+        var group = app.MapGroup("/api/v1/notifications").WithTags("Notifications");
+
+        group.MapGet("/{buyerId}", async (string buyerId, int? pageIndex, int? pageSize, INotificationService service, CancellationToken cancellationToken) =>
+        {
+            var page = await service.GetPageAsync(buyerId, pageIndex ?? 0, pageSize ?? 20, cancellationToken);
+            return TypedResults.Ok(page);
+        })
+        .WithName("GetNotifications");
+
+        group.MapPost("/", async (CreateNotificationRequest request, INotificationService service, CancellationToken cancellationToken) =>
+        {
+            var notification = await service.CreateAsync(request, cancellationToken);
+            return TypedResults.Created($"/api/v1/notifications/{notification.BuyerId}", notification);
+        })
+        .WithName("CreateNotification");
+
+        group.MapPut("/{buyerId}/{notificationId:guid}/read", async Task<IResult> (string buyerId, Guid notificationId, INotificationService service, CancellationToken cancellationToken) =>
+        {
+            var updated = await service.MarkAsReadAsync(buyerId, notificationId, cancellationToken);
+            return updated ? TypedResults.NoContent() : TypedResults.NotFound();
+        })
+        .WithName("MarkNotificationAsRead");
+
+        return app;
+    }
+}
