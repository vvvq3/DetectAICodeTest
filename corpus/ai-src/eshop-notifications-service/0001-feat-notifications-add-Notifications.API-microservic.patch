+namespace Notifications.API.Models;
+
+/// <summary>
+/// Represents a notification delivered to a buyer.
+/// </summary>
+public sealed record Notification
+{
+    public required Guid Id { get; init; }
+
+    public required string BuyerId { get; init; }
+
+    public required string Title { get; init; }
+
+    public string Message { get; init; } = string.Empty;
+
+    public NotificationType Type { get; init; } = NotificationType.Info;
+
+    public required DateTimeOffset CreatedAt { get; init; }
+
+    public DateTimeOffset? ReadAt { get; init; }
+
+    public bool IsRead => ReadAt is not null;
+}
+
+public enum NotificationType
+{
+    Info,
+    OrderStatusChanged,
+    PriceDrop,
+}
+
+public sealed record CreateNotificationRequest(string BuyerId, string Title, string? Message, NotificationType Type = NotificationType.Info);
+
+public sealed record NotificationPage(IReadOnlyList<Notification> Items, int TotalCount, int UnreadCount);
