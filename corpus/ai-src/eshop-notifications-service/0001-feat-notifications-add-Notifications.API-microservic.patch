+namespace Notifications.API.Options;
+
+/// <summary>
+/// Configuration options for the notifications service.
+/// </summary>
+public sealed class NotificationOptions
+{
+    public const string SectionName = "Notifications";
+
+    /// <summary>
+    /// Gets or sets the maximum number of notifications returned in a single page.
+    /// </summary>
+    public int MaxPageSize { get; set; } = 50;
+
+    /// <summary>
+    /// Gets or sets how long read notifications are retained before cleanup.
+    /// </summary>
+    public TimeSpan RetentionPeriod { get; set; } = TimeSpan.FromDays(30);
+}
