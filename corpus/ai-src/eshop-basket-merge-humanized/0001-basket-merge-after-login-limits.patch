@@ -0,0 +1,89 @@
+using Microsoft.eShopOnContainers.Services.Basket.API.Model;
+using Microsoft.Extensions.Logging;
+using Microsoft.Extensions.Options;
+using System;
+using System.Linq;
+using System.Threading.Tasks;
+
+namespace Microsoft.eShopOnContainers.Services.Basket.API.Services
+{
+    public class BasketMergeService : IBasketMergeService
+    {
+        private readonly IBasketRepository _repository;
+        private readonly BasketSettings _settings;
+        private readonly ILogger<BasketMergeService> _logger;
+
+        public BasketMergeService(IBasketRepository repository, IOptions<BasketSettings> settings, ILogger<BasketMergeService> logger)
+        {
+            _repository = repository;
+            _settings = settings.Value;
+            _logger = logger;
+        }
+
+        public async Task<CustomerBasket> MergeAsync(string anonymousId, string buyerId)
+        {
+            if (string.IsNullOrEmpty(anonymousId) || string.IsNullOrEmpty(buyerId))
+                throw new ArgumentException("anonymousId and buyerId are required");
+
+            var anonymous = await _repository.GetBasketAsync(anonymousId);
+            var target = await _repository.GetBasketAsync(buyerId) ?? new CustomerBasket(buyerId);
+
+            if (anonymous == null || anonymous.Items.Count == 0)
+                return target;
+
+            foreach (var item in anonymous.Items)
+            {
+                var existing = target.Items.FirstOrDefault(i => i.ProductId == item.ProductId);
+                if (existing == null)
+                {
+                    item.Quantity = Math.Min(item.Quantity, _settings.MaxQuantityPerItem);
+                    target.Items.Add(item);
+                    continue;
+                }
+
+                existing.Quantity = Math.Min(existing.Quantity + item.Quantity, _settings.MaxQuantityPerItem);
+                existing.UnitPrice = item.UnitPrice;
+            }
+
+            if (target.Items.Count > _settings.MaxItems)
+                target.Items = target.Items.Take(_settings.MaxItems).ToList();
+
+            var updated = await _repository.UpdateBasketAsync(target);
+            await _repository.DeleteBasketAsync(anonymousId);
+
+            _logger.LogInformation("Merged basket {AnonymousId} into {BuyerId}, {ItemCount} items", anonymousId, buyerId, updated.Items.Count);
+            return updated;
+        }
+
+        public bool Validate(CustomerBasket basket, out string error)
+        {
+            error = null;
+            if (basket.Items.Count > _settings.MaxItems)
+            {
+                error = $"Basket can contain at most {_settings.MaxItems} different products";
+                return false;
+            }
+
+            var tooMany = basket.Items.FirstOrDefault(i => i.Quantity > _settings.MaxQuantityPerItem);
+            if (tooMany != null)
+            {
+                error = $"Quantity of {tooMany.ProductName} can not exceed {_settings.MaxQuantityPerItem}";
+                return false;
+            }
+
+            if (basket.Items.Any(i => i.Quantity <= 0))
+            {
+                error = "Quantity must be positive";
+                return false;
+            }
+
+            return true;
+        }
+    }
+
+    public interface IBasketMergeService
+    {
+        Task<CustomerBasket> MergeAsync(string anonymousId, string buyerId);
+        bool Validate(CustomerBasket basket, out string error);
+    }
+}
