+using System;
+
+namespace Microsoft.eShopOnContainers.Services.Catalog.API.Model
+{
+    /// <summary>
+    /// Represents a customer review for a catalog item.
+    /// </summary>
+    public class CatalogItemReview
+    {
+        public int Id { get; set; }
+
+        public int CatalogItemId { get; set; }
+
+        public CatalogItem CatalogItem { get; set; }
+
+        public string BuyerId { get; set; }
+
+        public string BuyerName { get; set; }
+
+        /// <summary>
+        /// Gets or sets the rating from 1 to 5.
+        /// </summary>
+        public int Rating { get; set; }
+
+        public string Comment { get; set; }
+
+        public DateTime CreatedAtUtc { get; set; }
+    }
+}
diff --git a/src/Services/Catalog/Catalog.API/Services/CatalogReviewService.cs b/src/Services/Catalog/Catalog.API/Services/CatalogReviewService.cs
new file mode 100644
index 00000000..b5f5534b
--- /dev/null
+++ b/src/Services/Catalog/Catalog.API/Services/CatalogReviewService.cs
@@ -0,0 +1,107 @@
+using Microsoft.EntityFrameworkCore;
+using Microsoft.eShopOnContainers.Services.Catalog.API.Infrastructure;
+using Microsoft.eShopOnContainers.Services.Catalog.API.Infrastructure.Exceptions;
+using Microsoft.eShopOnContainers.Services.Catalog.API.Model;
+using Microsoft.eShopOnContainers.Services.Catalog.API.ViewModel;
+using Microsoft.Extensions.Logging;
+using System;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace Microsoft.eShopOnContainers.Services.Catalog.API.Services
+{
+    public class CatalogReviewService : ICatalogReviewService
+    {
+        private readonly CatalogContext _catalogContext;
+        private readonly ILogger<CatalogReviewService> _logger;
+
+        public CatalogReviewService(CatalogContext catalogContext, ILogger<CatalogReviewService> logger)
+        {
+            _catalogContext = catalogContext ?? throw new ArgumentNullException(nameof(catalogContext));
+            _logger = logger ?? throw new ArgumentNullException(nameof(logger));
+        }
+
+        public async Task<PaginatedItemsViewModel<CatalogItemReview>> GetReviewsAsync(int catalogItemId, int pageIndex, int pageSize, CancellationToken cancellationToken = default)
+        {
+            var query = _catalogContext.CatalogItemReviews
+                .AsNoTracking()
+                .Where(r => r.CatalogItemId == catalogItemId);
+
+            var totalItems = await query.LongCountAsync(cancellationToken);
+
+            var reviews = await query
+                .OrderByDescending(r => r.CreatedAtUtc)
+                .Skip(pageSize * pageIndex)
+                .Take(pageSize)
+                .ToListAsync(cancellationToken);
+
+            return new PaginatedItemsViewModel<CatalogItemReview>(pageIndex, pageSize, totalItems, reviews);
+        }
+
+        public async Task<ReviewSummaryViewModel> GetSummaryAsync(int catalogItemId, CancellationToken cancellationToken = default)
+        {
+            var ratings = await _catalogContext.CatalogItemReviews
+                .AsNoTracking()
+                .Where(r => r.CatalogItemId == catalogItemId)
+                .GroupBy(r => r.Rating)
+                .Select(g => new { Rating = g.Key, Count = g.Count() })
+                .ToListAsync(cancellationToken);
+
+            var total = ratings.Sum(r => r.Count);
+            var average = total == 0 ? 0 : ratings.Sum(r => r.Rating * r.Count) / (double)total;
+
+            return new ReviewSummaryViewModel
+            {
+                CatalogItemId = catalogItemId,
+                TotalReviews = total,
+                AverageRating = Math.Round(average, 2),
+                RatingDistribution = Enumerable.Range(1, 5)
+                    .ToDictionary(rating => rating, rating => ratings.FirstOrDefault(r => r.Rating == rating)?.Count ?? 0)
+            };
+        }
+
+        public async Task<CatalogItemReview> AddReviewAsync(int catalogItemId, string buyerId, string buyerName, CreateReviewRequest request, CancellationToken cancellationToken = default)
+        {
+            if (string.IsNullOrWhiteSpace(buyerId))
+            {
+                throw new ArgumentException("Buyer id must be provided.", nameof(buyerId));
+            }
+
+            if (request is null)
+            {
+                throw new ArgumentNullException(nameof(request));
+            }
+
+            var itemExists = await _catalogContext.CatalogItems.AnyAsync(i => i.Id == catalogItemId, cancellationToken);
+            if (!itemExists)
+            {
+                throw new CatalogDomainException($"Catalog item {catalogItemId} does not exist.");
+            }
+
+            var alreadyReviewed = await _catalogContext.CatalogItemReviews
+                .AnyAsync(r => r.CatalogItemId == catalogItemId && r.BuyerId == buyerId, cancellationToken);
+            if (alreadyReviewed)
+            {
+                throw new CatalogDomainException($"Buyer '{buyerId}' has already reviewed catalog item {catalogItemId}.");
+            }
+
+            var review = new CatalogItemReview
+            {
+                CatalogItemId = catalogItemId,
+                BuyerId = buyerId,
+                BuyerName = buyerName,
+                Rating = request.Rating,
+                Comment = request.Comment?.Trim(),
+                CreatedAtUtc = DateTime.UtcNow
+            };
+
+            _catalogContext.CatalogItemReviews.Add(review);
+            await _catalogContext.SaveChangesAsync(cancellationToken);
+
+            _logger.LogInformation("Buyer {BuyerId} added a {Rating}-star review for catalog item {CatalogItemId}", buyerId, request.Rating, catalogItemId);
+
+            return review;
+        }
+    }
+}
