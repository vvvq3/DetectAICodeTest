+using Microsoft.AspNetCore.Authorization;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.eShopOnContainers.Services.Catalog.API.Infrastructure.Exceptions;
+using Microsoft.eShopOnContainers.Services.Catalog.API.Model;
+using Microsoft.eShopOnContainers.Services.Catalog.API.Services;
+using Microsoft.eShopOnContainers.Services.Catalog.API.ViewModel;
+using System.Net;
+using System.Security.Claims;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace Microsoft.eShopOnContainers.Services.Catalog.API.Controllers
+{
+    [Route("api/v1/catalog/items/{catalogItemId:int}/reviews")]
+    [ApiController]
+    public class CatalogReviewsController : ControllerBase
+    {
+        private const int MaxPageSize = 50;
+
+        private readonly ICatalogReviewService _reviewService;
+
+        public CatalogReviewsController(ICatalogReviewService reviewService)
+        {
+            _reviewService = reviewService;
+        }
+
+        // GET api/v1/catalog/items/5/reviews?pageSize=10&pageIndex=0
+        [HttpGet]
+        [ProducesResponseType(typeof(PaginatedItemsViewModel<CatalogItemReview>), (int)HttpStatusCode.OK)]
+        [ProducesResponseType((int)HttpStatusCode.BadRequest)]
+        public async Task<IActionResult> GetReviewsAsync(int catalogItemId, [FromQuery] int pageSize = 10, [FromQuery] int pageIndex = 0, CancellationToken cancellationToken = default)
+        {
+            if (pageSize <= 0 || pageSize > MaxPageSize || pageIndex < 0)
+            {
+                return BadRequest($"pageSize must be between 1 and {MaxPageSize}, pageIndex must be non-negative.");
+            }
+
+            var reviews = await _reviewService.GetReviewsAsync(catalogItemId, pageIndex, pageSize, cancellationToken);
+            return Ok(reviews);
+        }
+
+        // GET api/v1/catalog/items/5/reviews/summary
+        [HttpGet("summary")]
+        [ProducesResponseType(typeof(ReviewSummaryViewModel), (int)HttpStatusCode.OK)]
+        public async Task<ActionResult<ReviewSummaryViewModel>> GetSummaryAsync(int catalogItemId, CancellationToken cancellationToken)
+        {
+            return await _reviewService.GetSummaryAsync(catalogItemId, cancellationToken);
+        }
+
+        // POST api/v1/catalog/items/5/reviews
+        [HttpPost]
+        [Authorize]
+        [ProducesResponseType(typeof(CatalogItemReview), (int)HttpStatusCode.Created)]
+        [ProducesResponseType((int)HttpStatusCode.BadRequest)]
+        [ProducesResponseType((int)HttpStatusCode.Conflict)]
+        public async Task<IActionResult> CreateReviewAsync(int catalogItemId, [FromBody] CreateReviewRequest request, CancellationToken cancellationToken)
+        {
+            var buyerId = User.FindFirstValue("sub");
+            var buyerName = User.FindFirstValue("name");
+
+            try
+            {
+                var review = await _reviewService.AddReviewAsync(catalogItemId, buyerId, buyerName, request, cancellationToken);
+                return CreatedAtAction(nameof(GetReviewsAsync), new { catalogItemId }, review);
+            }
+            catch (CatalogDomainException ex)
+            {
+                return Conflict(ex.Message);
+            }
+        }
+    }
+}
