+using System;
+using System.Threading;
+using System.Threading.Tasks;
+using FakeItEasy;
+using Microsoft.Extensions.Logging.Abstractions;
+using Squidex.Infrastructure;
+using Xunit;
+
+namespace Squidex.Domain.Apps.Entities.Apps
+{
+    public class AppImageCleanupServiceTests
+    {
+        private readonly IAppImageStore appImageStore = A.Fake<IAppImageStore>();
+        private readonly IAppProvider appProvider = A.Fake<IAppProvider>();
+        private readonly AppImageCleanupService sut;
+
+        public AppImageCleanupServiceTests()
+        {
+            sut = new AppImageCleanupService(appImageStore, appProvider, NullLogger<AppImageCleanupService>.Instance);
+        }
+
+        [Fact]
+        public async Task Should_delete_image_of_deleted_app()
+        {
+            var appId = DomainId.NewGuid();
+
+            A.CallTo(() => appProvider.GetAppAsync(appId, true))
+                .Returns(Task.FromResult<IAppEntity?>(null));
+
+            var deleted = await sut.CleanupAsync(new[] { appId });
+
+            Assert.Equal(1, deleted);
+
+            A.CallTo(() => appImageStore.DeleteAsync(appId, A<CancellationToken>._))
+                .MustHaveHappened();
+        }
+
+        [Fact]
+        public async Task Should_not_delete_image_of_existing_app()
+        {
+            var appId = DomainId.NewGuid();
+            var app = A.Fake<IAppEntity>();
+
+            A.CallTo(() => appProvider.GetAppAsync(appId, true))
+                .Returns(app);
+
+            var deleted = await sut.CleanupAsync(new[] { appId });
+
+            Assert.Equal(0, deleted);
+
+            A.CallTo(() => appImageStore.DeleteAsync(A<DomainId>._, A<CancellationToken>._))
+                .MustNotHaveHappened();
+        }
+
+        [Fact]
+        public async Task Should_continue_if_deletion_fails()
+        {
+            var appId1 = DomainId.NewGuid();
+            var appId2 = DomainId.NewGuid();
+
+            A.CallTo(() => appImageStore.DeleteAsync(appId1, A<CancellationToken>._))
+                .Throws(new InvalidOperationException());
+
+            var deleted = await sut.CleanupAsync(new[] { appId1, appId2 });
+
+            Assert.Equal(1, deleted);
+        }
+    }
+}
