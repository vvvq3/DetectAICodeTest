+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+using Microsoft.Extensions.Logging;
+using Squidex.Infrastructure;
+
+namespace Squidex.Domain.Apps.Entities.Apps
+{
+    /// <summary>
+    /// Removes stored app images that no longer belong to an existing app.
+    /// </summary>
+    public sealed class AppImageCleanupService
+    {
+        private readonly IAppImageStore appImageStore;
+        private readonly IAppProvider appProvider;
+        private readonly ILogger<AppImageCleanupService> logger;
+
+        public AppImageCleanupService(IAppImageStore appImageStore, IAppProvider appProvider, ILogger<AppImageCleanupService> logger)
+        {
+            Guard.NotNull(appImageStore, nameof(appImageStore));
+            Guard.NotNull(appProvider, nameof(appProvider));
+            Guard.NotNull(logger, nameof(logger));
+
+            this.appImageStore = appImageStore;
+            this.appProvider = appProvider;
+            this.logger = logger;
+        }
+
+        /// <summary>
+        /// Deletes the images of all apps from <paramref name="candidateAppIds"/> that do not exist anymore.
+        /// </summary>
+        /// <param name="candidateAppIds">The app ids that have stored images.</param>
+        /// <param name="ct">The cancellation token.</param>
+        /// <returns>The number of deleted images.</returns>
+        public async Task<int> CleanupAsync(IEnumerable<DomainId> candidateAppIds, CancellationToken ct = default)
+        {
+            Guard.NotNull(candidateAppIds, nameof(candidateAppIds));
+
+            var deleted = 0;
+
+            foreach (var appId in candidateAppIds.Distinct())
+            {
+                ct.ThrowIfCancellationRequested();
+
+                var app = await appProvider.GetAppAsync(appId, true);
+
+                if (app != null && !app.IsArchived)
+                {
+                    continue;
+                }
+
+                try
+                {
+                    await appImageStore.DeleteAsync(appId, ct);
+
+                    deleted++;
+                }
+                catch (Exception ex)
+                {
+                    logger.LogWarning(ex, "Failed to delete image of app {AppId}.", appId);
+                }
+            }
+
+            logger.LogInformation("Deleted {Count} orphaned app images.", deleted);
+
+            return deleted;
+        }
+    }
+}
