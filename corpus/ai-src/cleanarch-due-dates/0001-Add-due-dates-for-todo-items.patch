 create mode 100644 src/Application/TodoItems/Commands/SetTodoItemDueDate/SetTodoItemDueDateCommandValidator.cs
 create mode 100644 src/Application/TodoItems/Queries/GetOverdueTodoItems/GetOverdueTodoItemsQuery.cs

diff --git a/src/Application/TodoItems/Commands/SetTodoItemDueDate/SetTodoItemDueDateCommand.cs b/src/Application/TodoItems/Commands/SetTodoItemDueDate/SetTodoItemDueDateCommand.cs
new file mode 100644
