+using System;
+using NLog;
+using NzbDrone.Core.Blacklisting;
+using NzbDrone.Core.Configuration;
+
+namespace NzbDrone.Core.Housekeeping.Housekeepers
+{
+    /// <summary>
+    /// Removes blacklist entries that are older than the configured retention period.
+    /// </summary>
+    public class CleanupExpiredBlacklist : IHousekeepingTask
+    {
+        private readonly IBlacklistRepository _blacklistRepository;
+        private readonly IConfigService _configService;
+        private readonly Logger _logger;
+
+        public CleanupExpiredBlacklist(IBlacklistRepository blacklistRepository, IConfigService configService, Logger logger)
+        {
+            _blacklistRepository = blacklistRepository;
+            _configService = configService;
+            _logger = logger;
+        }
+
+        public void Clean()
+        {
+            var retentionDays = _configService.BlacklistRetentionDays;
+
+            if (retentionDays <= 0)
+            {
+                _logger.Debug("Blacklist retention is disabled, skipping cleanup.");
+                return;
+            }
+
+            var cutoff = DateTime.UtcNow.AddDays(-retentionDays);
+            var removed = _blacklistRepository.DeleteOlderThan(cutoff);
+
+            if (removed > 0)
+            {
+                _logger.Info("Removed {0} blacklist entries older than {1} days.", removed, retentionDays);
+            }
+        }
+    }
+}
