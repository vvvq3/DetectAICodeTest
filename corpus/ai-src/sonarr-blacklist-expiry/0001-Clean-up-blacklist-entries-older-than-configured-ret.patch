+using System;
+using FluentAssertions;
+using Moq;
+using NUnit.Framework;
+using NzbDrone.Core.Blacklisting;
+using NzbDrone.Core.Configuration;
+using NzbDrone.Core.Housekeeping.Housekeepers;
+using NzbDrone.Core.Test.Framework;
+
+namespace NzbDrone.Core.Test.Housekeeping.Housekeepers
+{
+    [TestFixture]
+    public class CleanupExpiredBlacklistFixture : CoreTest<CleanupExpiredBlacklist>
+    {
+        private void GivenRetentionDays(int days)
+        {
+            Mocker.GetMock<IConfigService>()
+                  .SetupGet(s => s.BlacklistRetentionDays)
+                  .Returns(days);
+        }
+
+        [Test]
+        public void should_not_delete_anything_when_retention_is_disabled()
+        {
+            GivenRetentionDays(0);
+
+            Subject.Clean();
+
+            Mocker.GetMock<IBlacklistRepository>()
+                  .Verify(v => v.DeleteOlderThan(It.IsAny<DateTime>()), Times.Never());
+        }
+
+        [Test]
+        public void should_delete_entries_older_than_retention()
+        {
+            GivenRetentionDays(30);
+
+            Mocker.GetMock<IBlacklistRepository>()
+                  .Setup(s => s.DeleteOlderThan(It.IsAny<DateTime>()))
+                  .Returns(3);
+
+            Subject.Clean();
+
+            Mocker.GetMock<IBlacklistRepository>()
+                  .Verify(v => v.DeleteOlderThan(It.Is<DateTime>(d => d < DateTime.UtcNow.AddDays(-29) && d > DateTime.UtcNow.AddDays(-31))), Times.Once());
+        }
+
+        [TestCase(-1)]
+        [TestCase(0)]
+        public void should_treat_non_positive_retention_as_disabled(int days)
+        {
+            GivenRetentionDays(days);
+
+            Subject.Clean();
+
+            Mocker.GetMock<IBlacklistRepository>()
+                  .Verify(v => v.DeleteOlderThan(It.IsAny<DateTime>()), Times.Never());
+        }
+    }
+}
