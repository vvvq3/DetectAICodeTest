@@ -43,5 +44,19 @@ protected override SortBuilder<Blacklist> GetPagedQuery(QueryBuilder<Blacklist>
 
             return base.GetPagedQuery(baseQuery, pagingSpec);
         }
+
+        public int DeleteOlderThan(DateTime cutoff)
+        {
+            var expired = Query(b => b.Date < cutoff);
+
+            if (expired.Count == 0)
+            {
+                return 0;
+            }
+
+            Delete(expired);
+
+            return expired.Count;
+        }
     }
 }
