index 0000000000..2f6e2f44ec
--- /dev/null
+++ b/Jellyfin.Api/Controllers/PlaybackStatsController.cs
@@ -0,0 +1,85 @@
+using System;
+using System.ComponentModel.DataAnnotations;
+using System.Linq;
+using Jellyfin.Api.Constants;
+using Jellyfin.Api.Extensions;
+using Jellyfin.Api.Helpers;
+using Jellyfin.Api.Models.StatsDtos;
+using MediaBrowser.Controller.Entities;
+using MediaBrowser.Controller.Library;
+using Microsoft.AspNetCore.Authorization;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Mvc;
+
+namespace Jellyfin.Api.Controllers
+{
+    /// <summary>
+    /// Playback stats controller.
+    /// </summary>
+    [Route("Users/{userId}/PlaybackStats")]
+    [Authorize(Policy = Policies.DefaultAuthorization)]
+    public class PlaybackStatsController : BaseJellyfinApiController
+    {
+        private readonly IUserManager _userManager;
+        private readonly ILibraryManager _libraryManager;
+        private readonly IUserDataManager _userDataManager;
+
+        /// <summary>
+        /// Initializes a new instance of the <see cref="PlaybackStatsController"/> class.
+        /// </summary>
+        /// <param name="userManager">Instance of the <see cref="IUserManager"/> interface.</param>
+        /// <param name="libraryManager">Instance of the <see cref="ILibraryManager"/> interface.</param>
+        /// <param name="userDataManager">Instance of the <see cref="IUserDataManager"/> interface.</param>
+        public PlaybackStatsController(
+            IUserManager userManager,
+            ILibraryManager libraryManager,
+            IUserDataManager userDataManager)
+        {
+            _userManager = userManager;
+            _libraryManager = libraryManager;
+            _userDataManager = userDataManager;
+        }
+
+        /// <summary>
+        /// Gets playback stats for a user.
+        /// </summary>
+        /// <param name="userId">User id.</param>
+        /// <param name="minDate">Optional. Only count items played after this date.</param>
+        /// <response code="200">Stats returned.</response>
+        /// <response code="404">User not found.</response>
+        /// <returns>A <see cref="PlaybackStatsDto"/>.</returns>
+        [HttpGet]
+        [ProducesResponseType(StatusCodes.Status200OK)]
+        [ProducesResponseType(StatusCodes.Status404NotFound)]
+        public ActionResult<PlaybackStatsDto> GetPlaybackStats([FromRoute, Required] Guid userId, [FromQuery] DateTime? minDate)
+        {
+            var user = _userManager.GetUserById(userId);
+            if (user == null)
+            {
+                return NotFound();
+            }
+
+            var items = _libraryManager.GetItemList(new InternalItemsQuery(user)
+            {
+                IsPlayed = true,
+                Recursive = true,
+                IsFolder = false
+            });
+
+            var played = items
+                .Select(i => (Item: i, Data: _userDataManager.GetUserData(user, i)))
+                .Where(x => !minDate.HasValue || (x.Data.LastPlayedDate.HasValue && x.Data.LastPlayedDate >= minDate))
+                .ToList();
+
+            return new PlaybackStatsDto
+            {
+                UserId = userId,
+                PlayedItems = played.Count,
+                TotalPlayTimeTicks = played.Sum(x => (x.Item.RunTimeTicks ?? 0) * Math.Max(1, x.Data.PlayCount)),
+                PlayedByType = played
+                    .GroupBy(x => x.Item.GetType().Name)
+                    .ToDictionary(g => g.Key, g => g.Count())
+            };
+        }
+    }
+}
diff --git a/Jellyfin.Api/Models/StatsDtos/PlaybackStatsDto.cs b/Jellyfin.Api/Models/StatsDtos/PlaybackStatsDto.cs
new file mode 100644
index 0000000000..4ff525b942
--- /dev/null
+++ b/Jellyfin.Api/Models/StatsDtos/PlaybackStatsDto.cs
@@ -0,0 +1,31 @@
+using System;
+using System.Collections.Generic;
+
+namespace Jellyfin.Api.Models.StatsDtos
+{
+    /// <summary>
+    /// Playback stats dto.
+    /// </summary>
+    public class PlaybackStatsDto
+    {
+        /// <summary>
+        /// Gets or sets the user id.
+        /// </summary>
+        public Guid UserId { get; set; }
+
+        /// <summary>
+        /// Gets or sets the total number of played items.
+        /// </summary>
+        public int PlayedItems { get; set; }
+
+        /// <summary>
+        /// Gets or sets the total play time in ticks.
+        /// </summary>
+        public long TotalPlayTimeTicks { get; set; }
+
+        /// <summary>
+        /// Gets or sets the play count per item type.
+        /// </summary>
+        public IReadOnlyDictionary<string, int> PlayedByType { get; set; } = new Dictionary<string, int>();
+    }
+}
