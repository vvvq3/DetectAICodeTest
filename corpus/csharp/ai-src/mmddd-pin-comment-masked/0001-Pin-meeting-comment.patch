+using CompanyName.MyMeetings.BuildingBlocks.Domain;
+using CompanyName.MyMeetings.Modules.Meetings.Domain.MeetingGroups;
+using CompanyName.MyMeetings.Modules.Meetings.Domain.Members;
+
+namespace CompanyName.MyMeetings.Modules.Meetings.Domain.MeetingComments.Rules
+{
+    public class OnlyMeetingGroupOrganizerCanPinCommentRule : IBusinessRule
+    {
+        private readonly MeetingGroup _meetingGroup;
+        private readonly MemberId _memberId;
+
+        public OnlyMeetingGroupOrganizerCanPinCommentRule(MeetingGroup meetingGroup, MemberId memberId)
+        {
+            _meetingGroup = meetingGroup;
+            _memberId = memberId;
+        }
+
+        public bool IsBroken() => !_meetingGroup.IsOrganizer(_memberId);
+
+        public string Message => "Only meeting group organizer can pin comments.";
+    }
+}
