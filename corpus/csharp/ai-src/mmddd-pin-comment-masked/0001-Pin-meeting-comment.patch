+using System;
+using FluentValidation;
+
+namespace CompanyName.MyMeetings.Modules.Meetings.Application.MeetingComments.PinMeetingComment
+{
+    internal class PinMeetingCommentCommandValidator : AbstractValidator<PinMeetingCommentCommand>
+    {
+        public PinMeetingCommentCommandValidator()
+        {
+            RuleFor(x => x.MeetingCommentId).NotEqual(Guid.Empty).WithMessage("Id of meeting comment cannot be empty.");
+        }
+    }
+}
