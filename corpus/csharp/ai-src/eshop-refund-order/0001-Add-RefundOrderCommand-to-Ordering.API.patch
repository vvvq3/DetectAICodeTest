@@ -0,0 +1,20 @@
+using FluentValidation;
+using Microsoft.Extensions.Logging;
+using Ordering.API.Application.Commands;
+
+namespace Ordering.API.Application.Validations
+{
+    public class RefundOrderCommandValidator : AbstractValidator<RefundOrderCommand>
+    {
+        public RefundOrderCommandValidator(ILogger<RefundOrderCommandValidator> logger)
+        {
+            RuleFor(command => command.OrderNumber).GreaterThan(0).WithMessage("Order number must be positive.");
+            RuleFor(command => command.Amount).GreaterThan(0).WithMessage("Refund amount must be greater than zero.");
+            RuleFor(command => command.Reason)
+                .NotEmpty().WithMessage("A refund reason is required.")
+                .MaximumLength(500);
+
+            logger.LogTrace("----- INSTANCE CREATED - {ClassName}", GetType().Name);
+        }
+    }
+}
