@@ -0,0 +1,74 @@
+using MediatR;
+using Microsoft.eShopOnContainers.Services.Ordering.Domain.AggregatesModel.OrderAggregate;
+using Microsoft.eShopOnContainers.Services.Ordering.Infrastructure.Idempotency;
+using Microsoft.Extensions.Logging;
+using System;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace Ordering.API.Application.Commands
+{
+    public class RefundOrderCommandHandler : IRequestHandler<RefundOrderCommand, RefundOrderResult>
+    {
+        private readonly IOrderRepository _orderRepository;
+        private readonly ILogger<RefundOrderCommandHandler> _logger;
+
+        public RefundOrderCommandHandler(IOrderRepository orderRepository, ILogger<RefundOrderCommandHandler> logger)
+        {
+            _orderRepository = orderRepository ?? throw new ArgumentNullException(nameof(orderRepository));
+            _logger = logger ?? throw new ArgumentNullException(nameof(logger));
+        }
+
+        public async Task<RefundOrderResult> Handle(RefundOrderCommand command, CancellationToken cancellationToken)
+        {
+            var order = await _orderRepository.GetAsync(command.OrderNumber);
+            if (order is null)
+            {
+                _logger.LogWarning("Refund requested for unknown order {OrderNumber}", command.OrderNumber);
+                return RefundOrderResult.Failure($"Order {command.OrderNumber} was not found.");
+            }
+
+            var status = order.OrderStatus;
+            if (status != OrderStatus.Paid && status != OrderStatus.Shipped)
+            {
+                return RefundOrderResult.Failure($"Order {command.OrderNumber} cannot be refunded in status '{status.Name}'.");
+            }
+
+            var orderTotal = order.GetTotal();
+            if (command.Amount > orderTotal)
+            {
+                return RefundOrderResult.Failure($"Refund amount {command.Amount} exceeds the order total {orderTotal}.");
+            }
+
+            order.SetCancelledStatus();
+
+            await _orderRepository.UnitOfWork.SaveEntitiesAsync(cancellationToken);
+
+            _logger.LogInformation(
+                "Refunded {Amount} for order {OrderNumber}. Reason: {Reason}",
+                command.Amount,
+                command.OrderNumber,
+                command.Reason);
+
+            return RefundOrderResult.Success(command.Amount);
+        }
+    }
+
+    // Use for Idempotency in Command process
+    public class RefundOrderIdentifiedCommandHandler : IdentifiedCommandHandler<RefundOrderCommand, RefundOrderResult>
+    {
+        public RefundOrderIdentifiedCommandHandler(
+            IMediator mediator,
+            IRequestManager requestManager,
+            ILogger<IdentifiedCommandHandler<RefundOrderCommand, RefundOrderResult>> logger)
+            : base(mediator, requestManager, logger)
+        {
+        }
+
+        protected override RefundOrderResult CreateResultForDuplicateRequest()
+        {
+            return RefundOrderResult.Failure("Duplicate refund request.");
+        }
+    }
+}
