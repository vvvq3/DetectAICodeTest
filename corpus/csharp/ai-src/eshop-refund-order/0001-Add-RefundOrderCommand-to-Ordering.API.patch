+        [Route("refund")]
+        [HttpPut]
+        [ProducesResponseType(typeof(RefundOrderResult), (int)HttpStatusCode.OK)]
+        [ProducesResponseType((int)HttpStatusCode.BadRequest)]
+        public async Task<IActionResult> RefundOrderAsync([FromBody] RefundOrderCommand command, [FromHeader(Name = "x-requestid")] string requestId)
+        {
+            if (!Guid.TryParse(requestId, out var guid) || guid == Guid.Empty)
+            {
+                return BadRequest("A valid x-requestid header is required.");
+            }
+
+            var identifiedCommand = new IdentifiedCommand<RefundOrderCommand, RefundOrderResult>(command, guid);
+
+            _logger.LogInformation(
+                "----- Sending command: {CommandName} - {IdProperty}: {CommandId} ({@Command})",
+                identifiedCommand.GetGenericTypeName(),
+                nameof(identifiedCommand.Command.OrderNumber),
+                identifiedCommand.Command.OrderNumber,
+                identifiedCommand);
+
+            var result = await _mediator.Send(identifiedCommand);
+            if (!result.Succeeded)
+            {
+                return BadRequest(result.Error);
+            }
+
+            return Ok(result);
+        }
+
