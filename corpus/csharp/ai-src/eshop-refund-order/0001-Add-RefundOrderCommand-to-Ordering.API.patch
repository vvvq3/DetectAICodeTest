+using MediatR;
+using System.Runtime.Serialization;
+
+namespace Ordering.API.Application.Commands
+{
+    /// <summary>
+    /// Command to refund a paid or shipped order.
+    /// </summary>
+    public class RefundOrderCommand : IRequest<RefundOrderResult>
+    {
+        [DataMember]
+        public int OrderNumber { get; private set; }
+
+        [DataMember]
+        public decimal Amount { get; private set; }
+
+        [DataMember]
+        public string Reason { get; private set; }
+
+        public RefundOrderCommand()
+        {
+        }
+
+        public RefundOrderCommand(int orderNumber, decimal amount, string reason)
+        {
+            OrderNumber = orderNumber;
+            Amount = amount;
+            Reason = reason;
+        }
+    }
+
+    /// <summary>
+    /// Result of processing a <see cref="RefundOrderCommand"/>.
+    /// </summary>
+    public class RefundOrderResult
+    {
+        public bool Succeeded { get; set; }
+
+        public string Error { get; set; }
+
+        public decimal RefundedAmount { get; set; }
+
+        public static RefundOrderResult Success(decimal amount) => new RefundOrderResult { Succeeded = true, RefundedAmount = amount };
+
+        public static RefundOrderResult Failure(string error) => new RefundOrderResult { Succeeded = false, Error = error };
+    }
+}
diff --git a/src/Services/Ordering/Ordering.API/Application/Commands/RefundOrderCommandHandler.cs b/src/Services/Ordering/Ordering.API/Application/Commands/RefundOrderCommandHandler.cs
