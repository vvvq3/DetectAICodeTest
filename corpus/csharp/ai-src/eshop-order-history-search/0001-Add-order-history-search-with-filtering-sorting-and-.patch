+namespace Microsoft.eShopOnContainers.Services.Ordering.API.Application.Queries
+{
+    using System;
+    using System.Collections.Generic;
+
+    /// <summary>
+    /// Filtering, sorting and paging options for searching a buyer's order history.
+    /// </summary>
+    public class OrderSearchCriteria
+    {
+        public const int MaxPageSize = 100;
+
+        private static readonly HashSet<string> AllowedSortFields = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
+        {
+            "date",
+            "total",
+            "status"
+        };
+
+        public DateTime? FromDate { get; set; }
+
+        public DateTime? ToDate { get; set; }
+
+        public string Status { get; set; }
+
+        public decimal? MinTotal { get; set; }
+
+        public decimal? MaxTotal { get; set; }
+
+        public string SortBy { get; set; } = "date";
+
+        public bool Descending { get; set; } = true;
+
+        public int PageIndex { get; set; }
+
+        public int PageSize { get; set; } = 20;
+
+        /// <summary>
+        /// Validates the criteria and returns the list of problems found, if any.
+        /// </summary>
+        public IReadOnlyList<string> Validate()
+        {
+            var errors = new List<string>();
+
+            if (FromDate.HasValue && ToDate.HasValue && FromDate > ToDate)
+            {
+                errors.Add("FromDate must be earlier than or equal to ToDate.");
+            }
+
+            if (MinTotal.HasValue && MaxTotal.HasValue && MinTotal > MaxTotal)
+            {
+                errors.Add("MinTotal must be less than or equal to MaxTotal.");
+            }
+
+            if (PageIndex < 0)
+            {
+                errors.Add("PageIndex must be non-negative.");
+            }
+
+            if (PageSize <= 0 || PageSize > MaxPageSize)
+            {
+                errors.Add($"PageSize must be between 1 and {MaxPageSize}.");
+            }
+
+            if (!string.IsNullOrWhiteSpace(SortBy) && !AllowedSortFields.Contains(SortBy))
+            {
+                errors.Add($"SortBy '{SortBy}' is not supported. Allowed values: {string.Join(", ", AllowedSortFields)}.");
+            }
+
+            return errors;
+        }
+    }
+
+    public class OrderSearchResult
+    {
+        public IReadOnlyList<OrderSummary> Items { get; set; }
+
+        public int TotalCount { get; set; }
+
+        public int PageIndex { get; set; }
+
+        public int PageSize { get; set; }
+    }
+}
