+        [Route("search")]
+        [HttpGet]
+        [ProducesResponseType(typeof(OrderSearchResult), (int)HttpStatusCode.OK)]
+        [ProducesResponseType((int)HttpStatusCode.BadRequest)]
+        public async Task<ActionResult<OrderSearchResult>> SearchOrdersAsync([FromQuery] OrderSearchCriteria criteria, CancellationToken cancellationToken)
+        {
+            var errors = criteria.Validate();
+            if (errors.Count > 0)
+            {
+                return BadRequest(errors);
+            }
+
+            var userId = _identityService.GetUserIdentity();
+            var result = await _orderQueries.SearchOrdersFromUserAsync(Guid.Parse(userId), criteria, cancellationToken);
+
+            _logger.LogInformation("Order search for user {UserId} returned {Count} of {TotalCount} orders", userId, result.Items.Count, result.TotalCount);
+
+            return Ok(result);
+        }
