@@ -0,0 +1,93 @@
+namespace Microsoft.eShopOnContainers.Services.Ordering.API.Application.Queries
+{
+    using Dapper;
+    using System;
+    using System.Collections.Generic;
+    using System.Text;
+
+    /// <summary>
+    /// Builds parameterized SQL for searching a buyer's order history.
+    /// </summary>
+    public static class OrderHistoryQueryBuilder
+    {
+        private static readonly IReadOnlyDictionary<string, string> SortColumns = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
+        {
+            ["date"] = "o.OrderDate",
+            ["total"] = "total",
+            ["status"] = "os.Name"
+        };
+
+        public static (string Sql, string CountSql, DynamicParameters Parameters) Build(Guid userId, OrderSearchCriteria criteria)
+        {
+            if (criteria is null)
+            {
+                throw new ArgumentNullException(nameof(criteria));
+            }
+
+            var parameters = new DynamicParameters();
+            parameters.Add("userId", userId);
+
+            var where = new StringBuilder("WHERE ob.IdentityGuid = @userId");
+
+            if (criteria.FromDate.HasValue)
+            {
+                where.Append(" AND o.OrderDate >= @fromDate");
+                parameters.Add("fromDate", criteria.FromDate.Value);
+            }
+
+            if (criteria.ToDate.HasValue)
+            {
+                where.Append(" AND o.OrderDate <= @toDate");
+                parameters.Add("toDate", criteria.ToDate.Value);
+            }
+
+            if (!string.IsNullOrWhiteSpace(criteria.Status))
+            {
+                where.Append(" AND os.Name = @status");
+                parameters.Add("status", criteria.Status.Trim().ToLowerInvariant());
+            }
+
+            var having = new List<string>();
+            if (criteria.MinTotal.HasValue)
+            {
+                having.Add("SUM(oi.units * oi.unitprice) >= @minTotal");
+                parameters.Add("minTotal", criteria.MinTotal.Value);
+            }
+
+            if (criteria.MaxTotal.HasValue)
+            {
+                having.Add("SUM(oi.units * oi.unitprice) <= @maxTotal");
+                parameters.Add("maxTotal", criteria.MaxTotal.Value);
+            }
+
+            var havingClause = having.Count > 0 ? "HAVING " + string.Join(" AND ", having) : string.Empty;
+            var sortColumn = SortColumns.TryGetValue(criteria.SortBy ?? "date", out var column) ? column : SortColumns["date"];
+            var direction = criteria.Descending ? "DESC" : "ASC";
+
+            parameters.Add("offset", criteria.PageIndex * criteria.PageSize);
+            parameters.Add("pageSize", criteria.PageSize);
+
+            const string baseQuery = @"FROM [ordering].[Orders] o
+                LEFT JOIN [ordering].[orderitems] oi ON o.Id = oi.orderid
+                LEFT JOIN [ordering].[orderstatus] os ON o.OrderStatusId = os.Id
+                LEFT JOIN [ordering].[buyers] ob ON o.BuyerId = ob.Id";
+
+            var sql = $@"SELECT o.[Id] AS ordernumber, o.[OrderDate] AS [date], os.[Name] AS [status], SUM(oi.units * oi.unitprice) AS total
+                {baseQuery}
+                {where}
+                GROUP BY o.[Id], o.[OrderDate], os.[Name]
+                {havingClause}
+                ORDER BY {sortColumn} {direction}, o.[Id] {direction}
+                OFFSET @offset ROWS FETCH NEXT @pageSize ROWS ONLY";
+
+            var countSql = $@"SELECT COUNT(*) FROM (
+                SELECT o.[Id]
+                {baseQuery}
+                {where}
+                GROUP BY o.[Id]
+                {havingClause}) AS filtered";
+
+            return (sql, countSql, parameters);
+        }
+    }
+}
