+using Microsoft.eShopOnContainers.Services.Basket.API;
+using Microsoft.eShopOnContainers.Services.Basket.API.Model;
+using Microsoft.eShopOnContainers.Services.Basket.API.Services;
+using Microsoft.Extensions.Logging.Abstractions;
+using Microsoft.Extensions.Options;
+using Moq;
+using System.Collections.Generic;
+using System.Threading.Tasks;
+using Xunit;
+
+namespace UnitTest.Basket.Application
+{
+    public class BasketMergeServiceTest
+    {
+        private readonly Mock<IBasketRepository> _repo = new Mock<IBasketRepository>();
+        private readonly BasketMergeService _service;
+
+        public BasketMergeServiceTest()
+        {
+            var settings = Options.Create(new BasketSettings { MaxItems = 3, MaxQuantityPerItem = 5 });
+            _repo.Setup(r => r.UpdateBasketAsync(It.IsAny<CustomerBasket>())).ReturnsAsync((CustomerBasket b) => b);
+            _service = new BasketMergeService(_repo.Object, settings, NullLogger<BasketMergeService>.Instance);
+        }
+
+        [Fact]
+        public async Task Merge_sums_quantities_up_to_limit()
+        {
+            _repo.Setup(r => r.GetBasketAsync("anon")).ReturnsAsync(new CustomerBasket("anon") { Items = new List<BasketItem> { new BasketItem { ProductId = 1, Quantity = 4 } } });
+            _repo.Setup(r => r.GetBasketAsync("user")).ReturnsAsync(new CustomerBasket("user") { Items = new List<BasketItem> { new BasketItem { ProductId = 1, Quantity = 3 } } });
+
+            var result = await _service.MergeAsync("anon", "user");
+
+            Assert.Single(result.Items);
+            Assert.Equal(5, result.Items[0].Quantity);
+            _repo.Verify(r => r.DeleteBasketAsync("anon"), Times.Once);
+        }
+
+        [Fact]
+        public async Task Merge_without_anonymous_basket_returns_user_basket()
+        {
+            _repo.Setup(r => r.GetBasketAsync("user")).ReturnsAsync(new CustomerBasket("user"));
+
+            var result = await _service.MergeAsync("anon", "user");
+
+            Assert.Equal("user", result.BuyerId);
+            _repo.Verify(r => r.UpdateBasketAsync(It.IsAny<CustomerBasket>()), Times.Never);
+        }
+
+        [Fact]
+        public void Validate_fails_on_zero_quantity()
+        {
+            var basket = new CustomerBasket("user") { Items = new List<BasketItem> { new BasketItem { ProductId = 1, Quantity = 0 } } };
+
+            var ok = _service.Validate(basket, out var error);
+
+            Assert.False(ok);
+            Assert.NotNull(error);
+        }
+    }
+}
