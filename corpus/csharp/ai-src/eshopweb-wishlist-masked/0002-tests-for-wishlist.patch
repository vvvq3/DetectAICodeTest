+using Microsoft.eShopWeb.ApplicationCore.Entities;
+using Microsoft.eShopWeb.ApplicationCore.Entities.WishlistAggregate;
+using Microsoft.eShopWeb.ApplicationCore.Interfaces;
+using Microsoft.eShopWeb.ApplicationCore.Services;
+using Microsoft.eShopWeb.ApplicationCore.Specifications;
+using Moq;
+using System.Threading;
+using System.Threading.Tasks;
+using Xunit;
+
+namespace Microsoft.eShopWeb.UnitTests.ApplicationCore.Services.WishlistServiceTests
+{
+    public class AddItem
+    {
+        private readonly string _buyerId = "Test buyerId";
+        private readonly Mock<IAsyncRepository<Wishlist>> _mockWishlistRepo = new Mock<IAsyncRepository<Wishlist>>();
+        private readonly Mock<IAsyncRepository<CatalogItem>> _mockItemRepo = new Mock<IAsyncRepository<CatalogItem>>();
+        private readonly Mock<IAppLogger<WishlistService>> _mockLogger = new Mock<IAppLogger<WishlistService>>();
+
+        [Fact]
+        public async Task AddsItemToExistingWishlist()
+        {
+            var wishlist = new Wishlist(_buyerId);
+            _mockWishlistRepo.Setup(x => x.FirstOrDefaultAsync(It.IsAny<WishlistWithItemsSpecification>(), It.IsAny<CancellationToken>())).ReturnsAsync(wishlist);
+            _mockItemRepo.Setup(x => x.GetByIdAsync(1, It.IsAny<CancellationToken>())).ReturnsAsync(new CatalogItem(1, 1, "desc", "name", 10m, "uri"));
+            var service = new WishlistService(_mockWishlistRepo.Object, _mockItemRepo.Object, _mockLogger.Object);
+
+            await service.AddItemAsync(_buyerId, 1);
+
+            Assert.Single(wishlist.Items);
+            _mockWishlistRepo.Verify(x => x.UpdateAsync(wishlist, It.IsAny<CancellationToken>()), Times.Once);
+        }
+
+        [Fact]
+        public async Task DoesNotDuplicateItems()
+        {
+            var wishlist = new Wishlist(_buyerId);
+            wishlist.AddItem(1);
+            _mockWishlistRepo.Setup(x => x.FirstOrDefaultAsync(It.IsAny<WishlistWithItemsSpecification>(), It.IsAny<CancellationToken>())).ReturnsAsync(wishlist);
+            _mockItemRepo.Setup(x => x.GetByIdAsync(1, It.IsAny<CancellationToken>())).ReturnsAsync(new CatalogItem(1, 1, "desc", "name", 10m, "uri"));
+            var service = new WishlistService(_mockWishlistRepo.Object, _mockItemRepo.Object, _mockLogger.Object);
+
+            await service.AddItemAsync(_buyerId, 1);
+
+            Assert.Single(wishlist.Items);
+        }
+
+        [Fact]
+        public async Task CreatesWishlistIfMissing()
+        {
+            _mockWishlistRepo.Setup(x => x.FirstOrDefaultAsync(It.IsAny<WishlistWithItemsSpecification>(), It.IsAny<CancellationToken>())).ReturnsAsync((Wishlist)null);
+            _mockWishlistRepo.Setup(x => x.AddAsync(It.IsAny<Wishlist>(), It.IsAny<CancellationToken>())).ReturnsAsync((Wishlist w, CancellationToken _) => w);
+            var service = new WishlistService(_mockWishlistRepo.Object, _mockItemRepo.Object, _mockLogger.Object);
+
+            var result = await service.GetOrCreateWishlistAsync(_buyerId);
+
+            Assert.Equal(_buyerId, result.BuyerId);
+            _mockWishlistRepo.Verify(x => x.AddAsync(It.IsAny<Wishlist>(), It.IsAny<CancellationToken>()), Times.Once);
+        }
+    }
+}
