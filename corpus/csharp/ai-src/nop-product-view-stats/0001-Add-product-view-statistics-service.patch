diff --git a/src/Libraries/Nop.Services/Catalog/ProductViewStatisticsService.cs b/src/Libraries/Nop.Services/Catalog/ProductViewStatisticsService.cs
new file mode 100644
index 0000000000..f1d6248ebb
--- /dev/null
+++ b/src/Libraries/Nop.Services/Catalog/ProductViewStatisticsService.cs
@@ -0,0 +1,130 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using Nop.Core;
+using Nop.Core.Caching;
+using Nop.Core.Domain.Catalog;
+using Nop.Data;
+
+namespace Nop.Services.Catalog
+{
+    /// <summary>
+    /// Product view statistics service
+    /// </summary>
+    public partial class ProductViewStatisticsService : IProductViewStatisticsService
+    {
+        #region Fields
+
+        private readonly IRepository<ProductViewRecord> _productViewRecordRepository;
+        private readonly IStaticCacheManager _staticCacheManager;
+        private readonly IStoreContext _storeContext;
+
+        #endregion
+
+        #region Ctor
+
+        public ProductViewStatisticsService(IRepository<ProductViewRecord> productViewRecordRepository,
+            IStaticCacheManager staticCacheManager,
+            IStoreContext storeContext)
+        {
+            _productViewRecordRepository = productViewRecordRepository;
+            _staticCacheManager = staticCacheManager;
+            _storeContext = storeContext;
+        }
+
+        #endregion
+
+        #region Methods
+
+        /// <summary>
+        /// Registers a single view of the specified product in the current store.
+        /// </summary>
+        /// <param name="product">Product</param>
+        public virtual void RegisterView(Product product)
+        {
+            if (product == null)
+                throw new ArgumentNullException(nameof(product));
+
+            var storeId = _storeContext.CurrentStore.Id;
+            var today = DateTime.UtcNow.Date;
+
+            // Views are aggregated per product, store and day to keep the table small
+            var record = _productViewRecordRepository.Table
+                .FirstOrDefault(r => r.ProductId == product.Id && r.StoreId == storeId && r.DateUtc == today);
+
+            if (record == null)
+            {
+                _productViewRecordRepository.Insert(new ProductViewRecord
+                {
+                    ProductId = product.Id,
+                    StoreId = storeId,
+                    DateUtc = today,
+                    ViewCount = 1
+                });
+            }
+            else
+            {
+                record.ViewCount++;
+                _productViewRecordRepository.Update(record);
+            }
+        }
+
+        /// <summary>
+        /// Gets the total number of views of a product for the specified period.
+        /// </summary>
+        /// <param name="productId">Product identifier</param>
+        /// <param name="fromUtc">Start date (UTC); null to include all records</param>
+        /// <param name="toUtc">End date (UTC); null to include all records</param>
+        /// <returns>Number of views</returns>
+        public virtual int GetViewCount(int productId, DateTime? fromUtc = null, DateTime? toUtc = null)
+        {
+            var query = _productViewRecordRepository.Table.Where(r => r.ProductId == productId);
+
+            if (fromUtc.HasValue)
+                query = query.Where(r => r.DateUtc >= fromUtc.Value.Date);
+
+            if (toUtc.HasValue)
+                query = query.Where(r => r.DateUtc <= toUtc.Value.Date);
+
+            return query.Sum(r => (int?)r.ViewCount) ?? 0;
+        }
+
+        /// <summary>
+        /// Gets the most viewed product identifiers for the specified period.
+        /// </summary>
+        /// <param name="storeId">Store identifier; 0 to load all records</param>
+        /// <param name="days">Number of days to look back</param>
+        /// <param name="count">Number of products to return</param>
+        /// <returns>Product identifiers ordered by views descending</returns>
+        public virtual IList<int> GetMostViewedProductIds(int storeId, int days, int count)
+        {
+            if (days <= 0)
+                throw new ArgumentOutOfRangeException(nameof(days), "Number of days must be positive.");
+
+            if (count <= 0)
+                return new List<int>();
+
+            var cacheKey = _staticCacheManager.PrepareKeyForDefaultCache(NopCatalogDefaults.MostViewedProductIdsCacheKey, storeId, days, count);
+
+            return _staticCacheManager.Get(cacheKey, () =>
+            {
+                var fromDate = DateTime.UtcNow.Date.AddDays(-days);
+
+                var query = _productViewRecordRepository.Table.Where(r => r.DateUtc >= fromDate);
+                if (storeId > 0)
+                    query = query.Where(r => r.StoreId == storeId);
+
+                return query
+                    .GroupBy(r => r.ProductId)
+                    .Select(g => new { ProductId = g.Key, Views = g.Sum(r => r.ViewCount) })
+                    .OrderByDescending(x => x.Views)
+                    .ThenBy(x => x.ProductId)
+                    .Take(count)
+                    .Select(x => x.ProductId)
+                    .ToList();
+            });
+        }
+
+        #endregion
+    }
+}
