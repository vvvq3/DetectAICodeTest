+using System;
+
+namespace Nop.Core.Domain.Catalog
+{
+    /// <summary>
+    /// Represents a product view record
+    /// </summary>
+    public partial class ProductViewRecord : BaseEntity
+    {
+        /// <summary>
+        /// Gets or sets the product identifier
+        /// </summary>
+        public int ProductId { get; set; }
+
+        /// <summary>
+        /// Gets or sets the store identifier
+        /// </summary>
+        public int StoreId { get; set; }
+
+        /// <summary>
+        /// Gets or sets the date (UTC) the views were aggregated for
+        /// </summary>
