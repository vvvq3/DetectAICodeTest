@@ -0,0 +1,58 @@
+using System;
+using System.IO;
+using System.Text;
+using System.Threading;
+using System.Threading.Tasks;
+using Jellyfin.Api.Helpers;
+using Jellyfin.Api.Models.WatchHistoryDtos;
+using Xunit;
+
+namespace Jellyfin.Api.Tests.Helpers
+{
+    public static class WatchHistoryExporterTests
+    {
+        [Theory]
+        [InlineData(null, "")]
+        [InlineData("", "")]
+        [InlineData("Simple", "Simple")]
+        [InlineData("With, comma", "\"With, comma\"")]
+        [InlineData("With \"quotes\"", "\"With \"\"quotes\"\"\"")]
+        [InlineData("Line\nbreak", "\"Line\nbreak\"")]
+        public static void EscapeCsv_ReturnsExpectedValue(string? input, string expected)
+        {
+            Assert.Equal(expected, WatchHistoryExporter.EscapeCsv(input));
+        }
+
+        [Fact]
+        public static async Task WriteCsvAsync_WritesHeaderAndRows()
+        {
+            var entries = new[]
+            {
+                new WatchHistoryEntryDto
+                {
+                    ItemId = Guid.Parse("11111111-2222-3333-4444-555555555555"),
+                    Name = "Pilot",
+                    SeriesName = "Some Show",
+                    ItemType = "Episode",
+                    LastPlayedDate = new DateTime(2020, 11, 1, 20, 0, 0, DateTimeKind.Utc),
+                    PlayCount = 2
+                }
+            };
+
+            using var stream = new MemoryStream();
+            await WatchHistoryExporter.WriteCsvAsync(entries, stream, CancellationToken.None);
+
+            var lines = Encoding.UTF8.GetString(stream.ToArray()).Split(Environment.NewLine, StringSplitOptions.RemoveEmptyEntries);
+            Assert.Equal(2, lines.Length);
+            Assert.Equal("ItemId,Name,SeriesName,ItemType,LastPlayedDate,PlayCount", lines[0]);
+            Assert.Equal("11111111222233334444555555555555,Pilot,Some Show,Episode,2020-11-01T20:00:00.0000000Z,2", lines[1]);
+        }
+
+        [Fact]
+        public static async Task WriteCsvAsync_NullEntries_ThrowsArgumentNullException()
+        {
+            using var stream = new MemoryStream();
+            await Assert.ThrowsAsync<ArgumentNullException>(() => WatchHistoryExporter.WriteCsvAsync(null!, stream, CancellationToken.None));
+        }
+    }
+}
