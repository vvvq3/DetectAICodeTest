+using Microsoft.eShopWeb.ApplicationCore.Entities.OrderAggregate;
+using Microsoft.eShopWeb.ApplicationCore.Interfaces;
+using Microsoft.eShopWeb.ApplicationCore.Specifications;
+using Microsoft.eShopWeb.Web.Features.OrderExport;
+using Microsoft.Extensions.Logging.Abstractions;
+using Moq;
+using System.Collections.Generic;
+using System.Text;
+using System.Threading;
+using System.Threading.Tasks;
+using Xunit;
+
+namespace Microsoft.eShopWeb.UnitTests.Web.Features
+{
+    public class OrderExportServiceTests
+    {
+        private readonly Mock<IOrderRepository> _orderRepository = new Mock<IOrderRepository>();
+
+        [Fact]
+        public async Task ExportToCsvAsync_ВыгружаетПозицииЗаказов()
+        {
+            var address = new Address("Тверская 1", "Москва", "МО", "Россия", "101000");
+            var item = new OrderItem(new CatalogItemOrdered(1, "Кружка \"Лого\"", "uri"), 250m, 2);
+            var order = new Order("buyer", address, new List<OrderItem> { item });
+            _orderRepository
+                .Setup(r => r.ListAsync(It.IsAny<CustomerOrdersWithItemsSpecification>(), It.IsAny<CancellationToken>()))
+                .ReturnsAsync(new List<Order> { order });
+            var service = new OrderExportService(_orderRepository.Object, NullLogger<OrderExportService>.Instance);
+
+            var bytes = await service.ExportToCsvAsync("buyer");
+            var csv = Encoding.UTF8.GetString(bytes);
+
+            Assert.Contains("\"Кружка \"\"Лого\"\"\"", csv);
+            Assert.Contains(";2;250.00;500.00", csv);
+        }
+
+        [Fact]
+        public async Task ExportToCsvAsync_ПустойПокупатель_Исключение()
+        {
+            var service = new OrderExportService(_orderRepository.Object, NullLogger<OrderExportService>.Instance);
+
+            await Assert.ThrowsAnyAsync<System.ArgumentException>(() => service.ExportToCsvAsync(""));
+        }
+    }
+}
