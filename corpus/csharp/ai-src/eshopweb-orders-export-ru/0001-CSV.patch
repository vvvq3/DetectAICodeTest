@@ -0,0 +1,75 @@
+using Ardalis.GuardClauses;
+using Microsoft.eShopWeb.ApplicationCore.Entities.OrderAggregate;
+using Microsoft.eShopWeb.ApplicationCore.Interfaces;
+using Microsoft.eShopWeb.ApplicationCore.Specifications;
+using Microsoft.Extensions.Logging;
+using System.Globalization;
+using System.Linq;
+using System.Text;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace Microsoft.eShopWeb.Web.Features.OrderExport
+{
+    public class OrderExportService : IOrderExportService
+    {
+        private const char Separator = ';';
+
+        private readonly IOrderRepository _orderRepository;
+        private readonly ILogger<OrderExportService> _logger;
+
+        public OrderExportService(IOrderRepository orderRepository, ILogger<OrderExportService> logger)
+        {
+            _orderRepository = orderRepository;
+            _logger = logger;
+        }
+
+        public async Task<byte[]> ExportToCsvAsync(string buyerId, CancellationToken cancellationToken = default)
+        {
+            Guard.Against.NullOrEmpty(buyerId, nameof(buyerId));
+
+            // Загружаем заказы вместе с позициями, чтобы не делать запрос на каждый заказ
+            var specification = new CustomerOrdersWithItemsSpecification(buyerId);
+            var orders = await _orderRepository.ListAsync(specification, cancellationToken);
+
+            var builder = new StringBuilder();
+            builder.AppendLine(string.Join(Separator, "Номер заказа", "Дата", "Товар", "Количество", "Цена", "Сумма"));
+
+            // Каждая позиция заказа выгружается отдельной строкой
+            foreach (var order in orders.OrderByDescending(o => o.OrderDate))
+            {
+                foreach (var item in order.OrderItems)
+                {
+                    builder.AppendLine(string.Join(Separator,
+                        order.Id.ToString(CultureInfo.InvariantCulture),
+                        order.OrderDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
+                        Escape(item.ItemOrdered.ProductName),
+                        item.Units.ToString(CultureInfo.InvariantCulture),
+                        item.UnitPrice.ToString("0.00", CultureInfo.InvariantCulture),
+                        (item.UnitPrice * item.Units).ToString("0.00", CultureInfo.InvariantCulture)));
+                }
+            }
+
+            _logger.LogInformation("Выгружено {OrderCount} заказов покупателя {BuyerId}", orders.Count, buyerId);
+
+            // Добавляем BOM, чтобы Excel корректно открывал кириллицу
+            return Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(builder.ToString())).ToArray();
+        }
+
+        private static string Escape(string value)
+        {
+            if (string.IsNullOrEmpty(value))
+            {
+                return string.Empty;
+            }
+
+            // Экранируем значение, если в нём есть разделитель, кавычки или перевод строки
+            if (value.IndexOfAny(new[] { Separator, '"', '\n', '\r' }) >= 0)
+            {
+                return "\"" + value.Replace("\"", "\"\"") + "\"";
+            }
+
+            return value;
+        }
+    }
+}
