@@ -0,0 +1,29 @@
+using Microsoft.AspNetCore.Authorization;
+using Microsoft.AspNetCore.Mvc;
+using System;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace Microsoft.eShopWeb.Web.Features.OrderExport
+{
+    [Authorize]
+    [Route("[controller]/[action]")]
+    public class OrderExportController : Controller
+    {
+        private readonly IOrderExportService _exportService;
+
+        public OrderExportController(IOrderExportService exportService)
+        {
+            _exportService = exportService;
+        }
+
+        [HttpGet]
+        public async Task<IActionResult> Csv(CancellationToken cancellationToken)
+        {
+            var content = await _exportService.ExportToCsvAsync(User.Identity.Name, cancellationToken);
+            var fileName = $"orders-{DateTime.UtcNow:yyyyMMdd}.csv";
+
+            return File(content, "text/csv", fileName);
+        }
+    }
+}
diff --git a/src/Web/Features/OrderExport/OrderExportService.cs b/src/Web/Features/OrderExport/OrderExportService.cs
