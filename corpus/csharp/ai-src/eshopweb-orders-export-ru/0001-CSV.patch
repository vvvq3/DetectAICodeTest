+using System.Threading;
+using System.Threading.Tasks;
+
+namespace Microsoft.eShopWeb.Web.Features.OrderExport
+{
+    /// <summary>
+    /// Сервис выгрузки заказов покупателя.
+    /// </summary>
+    public interface IOrderExportService
+    {
+        /// <summary>
+        /// Формирует CSV-файл со всеми заказами покупателя.
+        /// </summary>
+        /// <param name="buyerId">Идентификатор покупателя.</param>
+        /// <param name="cancellationToken">Токен отмены.</param>
+        /// <returns>Содержимое CSV-файла в кодировке UTF-8.</returns>
+        Task<byte[]> ExportToCsvAsync(string buyerId, CancellationToken cancellationToken = default);
+    }
+}
