+using Microsoft.eShopWeb.ApplicationCore.Entities.BasketAggregate;
+using System.Linq;
+using Xunit;
+
+namespace Microsoft.eShopWeb.UnitTests.ApplicationCore.Entities.BasketTests
+{
+    public class BasketAddItemLimits
+    {
+        private readonly int _testCatalogItemId = 123;
+        private readonly decimal _testUnitPrice = 1.23m;
+
+        [Fact]
+        public void AddItem_QuantityAboveLimit_IsCappedAtMaximum()
+        {
+            var basket = new Basket("buyer");
+
+            basket.AddItem(_testCatalogItemId, _testUnitPrice, Basket.MaxQuantityPerItem + 10);
+
+            Assert.Equal(Basket.MaxQuantityPerItem, basket.Items.Single().Quantity);
+        }
+
+        [Fact]
+        public void AddItem_ExistingItemNearLimit_DoesNotExceedMaximum()
+        {
+            var basket = new Basket("buyer");
+            basket.AddItem(_testCatalogItemId, _testUnitPrice, Basket.MaxQuantityPerItem - 1);
+
+            basket.AddItem(_testCatalogItemId, _testUnitPrice, 5);
+
+            Assert.Equal(Basket.MaxQuantityPerItem, basket.Items.Single().Quantity);
+        }
+
+        [Fact]
+        public void TotalItems_ReturnsSumOfQuantities()
+        {
+            var basket = new Basket("buyer");
+            basket.AddItem(1, _testUnitPrice, 2);
+            basket.AddItem(2, _testUnitPrice, 3);
+
+            Assert.Equal(5, basket.TotalItems);
+        }
+    }
+}
