+        public async Task CancelOrderAsync(int orderId, string buyerId, string reason, CancellationToken cancellationToken = default)
+        {
+            Guard.Against.NullOrEmpty(buyerId, nameof(buyerId));
+            Guard.Against.NullOrWhiteSpace(reason, nameof(reason));
+
+            var order = await _orderRepository.GetByIdAsync(orderId, cancellationToken);
+            if (order is null)
+            {
+                throw new OrderNotFoundException(orderId);
+            }
+
+            if (!string.Equals(order.BuyerId, buyerId, StringComparison.Ordinal))
+            {
+                throw new UnauthorizedAccessException($"Buyer '{buyerId}' is not allowed to cancel order {orderId}.");
+            }
+
+            order.Cancel(reason, DateTimeOffset.UtcNow);
+
+            await _orderRepository.UpdateAsync(order, cancellationToken);
+        }
     }
 }
