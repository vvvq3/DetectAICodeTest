+import { expect } from 'chai';
+import { getCharCounter } from './char-counter';
+
+describe('getCharCounter', () => {
+	it('returns null without a max length', () => {
+		expect(getCharCounter('abc', null)).to.equal(null);
+		expect(getCharCounter('abc', undefined)).to.equal(null);
+		expect(getCharCounter('abc', 0)).to.equal(null);
+		expect(getCharCounter('abc', -5)).to.equal(null);
+		expect(getCharCounter('abc', 'nope')).to.equal(null);
+	});
+
+	it('treats an empty value as zero characters', () => {
+		expect(getCharCounter(null, 100)).to.deep.equal({ remaining: 100, max: 100, status: 'normal' });
+		expect(getCharCounter(undefined, 100)).to.deep.equal({ remaining: 100, max: 100, status: 'normal' });
+		expect(getCharCounter('', 100)).to.deep.equal({ remaining: 100, max: 100, status: 'normal' });
+	});
+
+	it('is normal while 10% or more remains', () => {
+		expect(getCharCounter('a'.repeat(90), 100)).to.deep.equal({ remaining: 10, max: 100, status: 'normal' });
+	});
+
+	it('warns when less than 10% remains', () => {
+		expect((getCharCounter('a'.repeat(91), 100) as any).status).to.equal('warning');
+		expect(getCharCounter('a'.repeat(100), 100)).to.deep.equal({ remaining: 0, max: 100, status: 'warning' });
+	});
+
+	it('is danger when the limit is exceeded', () => {
+		expect(getCharCounter('a'.repeat(101), 100)).to.deep.equal({ remaining: -1, max: 100, status: 'danger' });
+	});
+
+	it('accepts a numeric string as max length', () => {
+		expect(getCharCounter('abc', '10')).to.deep.equal({ remaining: 7, max: 10, status: 'normal' });
+	});
+});
diff --git a/app/src/utils/char-counter/char-counter.ts b/app/src/utils/char-counter/char-counter.ts
