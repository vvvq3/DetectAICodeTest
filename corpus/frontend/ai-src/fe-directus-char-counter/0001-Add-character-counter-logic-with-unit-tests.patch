+++ b/app/src/utils/char-counter/char-counter.ts
@@ -0,0 +1,29 @@
+export type CharCounterStatus = 'normal' | 'warning' | 'danger';
+
+export type CharCounter = {
+	remaining: number;
+	max: number;
+	status: CharCounterStatus;
+};
+
+/**
+ * Calculate the state of the character counter for a value and a max length.
+ * Returns null when there is no (valid) max length, so no counter should be shown.
+ * Status is "warning" when less than 10% of the max length remains, and "danger"
+ * when the max length is exceeded.
+ */
+export function getCharCounter(
+	value: string | null | undefined,
+	maxLength: number | string | null | undefined
+): CharCounter | null {
+	const max = Number(maxLength);
+	if (!maxLength || !Number.isFinite(max) || max <= 0) return null;
+
+	const remaining = max - (value || '').length;
+
+	let status: CharCounterStatus = 'normal';
+	if (remaining < 0) status = 'danger';
+	else if ((remaining / max) * 100 < 10) status = 'warning';
+
+	return { remaining, max, status };
+}
