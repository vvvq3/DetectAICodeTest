+import { async, ComponentFixture, TestBed } from '@angular/core/testing';
+import { NO_ERRORS_SCHEMA } from '@angular/core';
+import { By } from '@angular/platform-browser';
+import { RouterTestingModule } from '@angular/router/testing';
+import { TranslateModule } from '@ngx-translate/core';
+import { take } from 'rxjs/operators';
+import { MyUploadElementComponent } from './my-upload-element.component';
+import { LinkService } from '../../core/cache/builders/link.service';
+import { Item } from '../../core/shared/item.model';
+import { WorkspaceItem } from '../../core/submission/models/workspaceitem.model';
+import { WorkflowItem } from '../../core/submission/models/workflowitem.model';
+import { getMockLinkService } from '../../shared/mocks/link-service.mock';
+import { MyDspaceItemStatusType } from '../../shared/object-collection/shared/mydspace-item-status/my-dspace-item-status-type';
+import { createSuccessfulRemoteDataObject$ } from '../../shared/remote-data.utils';
+import { VarDirective } from '../../shared/utils/var.directive';
+
+describe('MyUploadElementComponent', () => {
+  let component: MyUploadElementComponent;
+  let fixture: ComponentFixture<MyUploadElementComponent>;
+
+  let linkService: LinkService;
+  let item: Item;
+
+  function init() {
+    linkService = getMockLinkService();
+    item = Object.assign(new Item(), {
+      id: 'fake-item-id',
+      lastModified: '2020-12-01T10:15:00.000+0000',
+      metadata: {
+        'dc.title': [
+          {
+            value: 'Test upload',
+            language: null
+          }
+        ]
+      }
+    });
+  }
+
+  beforeEach(async(() => {
+    init();
+    TestBed.configureTestingModule({
+      declarations: [MyUploadElementComponent, VarDirective],
+      imports: [TranslateModule.forRoot(), RouterTestingModule.withRoutes([])],
+      providers: [
+        { provide: LinkService, useValue: linkService }
+      ],
+      schemas: [NO_ERRORS_SCHEMA]
+    }).compileComponents();
+  }));
+
+  beforeEach(() => {
+    fixture = TestBed.createComponent(MyUploadElementComponent);
+    component = fixture.componentInstance;
+  });
+
+  describe('when the object is an archived item', () => {
+    beforeEach(() => {
+      component.object = item;
+      fixture.detectChanges();
+    });
+
+    it('should have the archived status', () => {
+      expect(component.status).toEqual(MyDspaceItemStatusType.ARCHIVED);
+    });
+
+    it('should use the object itself as item', (done) => {
+      component.item$.pipe(take(1)).subscribe((i) => {
+        expect(i).toBe(item);
+        done();
+      });
+    });
+
+    it('should not resolve the item link', () => {
+      expect(linkService.resolveLink).not.toHaveBeenCalled();
+    });
+
+    it('should display the title as a link to the item page', () => {
+      const link = fixture.debugElement.query(By.css('a'));
+      expect(link.nativeElement.textContent).toContain('Test upload');
+      expect(link.nativeElement.getAttribute('href')).toEqual('/items/fake-item-id');
+    });
+  });
+
+  describe('when the object is a workspace item', () => {
+    beforeEach(() => {
+      component.object = Object.assign(new WorkspaceItem(), {
+        item: createSuccessfulRemoteDataObject$(item)
+      });
+      fixture.detectChanges();
+    });
+
+    it('should have the workspace status', () => {
+      expect(component.status).toEqual(MyDspaceItemStatusType.WORKSPACE);
+    });
+
+    it('should init the item from the item link', (done) => {
+      component.item$.pipe(take(1)).subscribe((i) => {
+        expect(linkService.resolveLink).toHaveBeenCalled();
+        expect(i).toBe(item);
+        done();
+      });
+    });
+
+    it('should display the title without a link', () => {
+      expect(fixture.debugElement.query(By.css('a'))).toBeNull();
+      expect(fixture.debugElement.query(By.css('span.lead')).nativeElement.textContent).toContain('Test upload');
+    });
+  });
+
+  describe('when the object is a workflow item', () => {
+    beforeEach(() => {
+      component.object = Object.assign(new WorkflowItem(), {
+        item: createSuccessfulRemoteDataObject$(item)
+      });
+      fixture.detectChanges();
+    });
+
+    it('should have the workflow status', () => {
+      expect(component.status).toEqual(MyDspaceItemStatusType.WORKFLOW);
+    });
+
+    it('should init the item from the item link', (done) => {
+      component.item$.pipe(take(1)).subscribe((i) => {
+        expect(linkService.resolveLink).toHaveBeenCalled();
+        expect(i).toBe(item);
+        done();
+      });
+    });
+  });
+});
