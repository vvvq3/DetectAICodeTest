+import { async, ComponentFixture, TestBed } from '@angular/core/testing';
+import { NO_ERRORS_SCHEMA } from '@angular/core';
+import { By } from '@angular/platform-browser';
+import { RouterTestingModule } from '@angular/router/testing';
+import { TranslateModule } from '@ngx-translate/core';
+import { MyUploadsPageComponent } from './my-uploads-page.component';
+import { SearchService } from '../core/shared/search/search.service';
+import { MyDSpaceResponseParsingService } from '../core/data/mydspace-response-parsing.service';
+import { MyDSpaceRequest } from '../core/data/request.models';
+import { SortDirection, SortOptions } from '../core/cache/models/sort-options.model';
+import { Item } from '../core/shared/item.model';
+import { WorkspaceItem } from '../core/submission/models/workspaceitem.model';
+import { WorkflowItem } from '../core/submission/models/workflowitem.model';
+import { ItemSearchResult } from '../shared/object-collection/shared/item-search-result.model';
+import { WorkspaceItemSearchResult } from '../shared/object-collection/shared/workspace-item-search-result.model';
+import { WorkflowItemSearchResult } from '../shared/object-collection/shared/workflow-item-search-result.model';
+import { SearchFilter } from '../shared/search/search-filter.model';
+import { SearchResult } from '../shared/search/search-result.model';
+import { createSuccessfulRemoteDataObject$ } from '../shared/remote-data.utils';
+import { createPaginatedList } from '../shared/testing/utils.test';
+import { VarDirective } from '../shared/utils/var.directive';
+
+describe('MyUploadsPageComponent', () => {
+  let component: MyUploadsPageComponent;
+  let fixture: ComponentFixture<MyUploadsPageComponent>;
+
+  let searchService: SearchService;
+
+  let results: SearchResult<any>[];
+
+  function init() {
+    results = [
+      Object.assign(new ItemSearchResult(), {
+        indexableObject: Object.assign(new Item(), { id: 'archived-item-id' })
+      }),
+      Object.assign(new WorkspaceItemSearchResult(), {
+        indexableObject: Object.assign(new WorkspaceItem(), { id: 'workspace-item-id' })
+      }),
+      Object.assign(new WorkflowItemSearchResult(), {
+        indexableObject: Object.assign(new WorkflowItem(), { id: 'workflow-item-id' })
+      })
+    ];
+    searchService = jasmine.createSpyObj('searchService', {
+      search: createSuccessfulRemoteDataObject$(createPaginatedList(results)),
+      setServiceOptions: {}
+    });
+  }
+
+  beforeEach(async(() => {
+    init();
+    TestBed.configureTestingModule({
+      declarations: [MyUploadsPageComponent, VarDirective],
+      imports: [TranslateModule.forRoot(), RouterTestingModule.withRoutes([])],
+      providers: [
+        { provide: SearchService, useValue: searchService }
+      ],
+      schemas: [NO_ERRORS_SCHEMA]
+    }).compileComponents();
+  }));
+
+  beforeEach(() => {
+    fixture = TestBed.createComponent(MyUploadsPageComponent);
+    component = fixture.componentInstance;
+    fixture.detectChanges();
+  });
+
+  it('should use the mydspace parser and request for the search', () => {
+    expect(searchService.setServiceOptions).toHaveBeenCalledWith(MyDSpaceResponseParsingService, MyDSpaceRequest);
+  });
+
+  it('should search the uploads in the workspace configuration, most recent first', () => {
+    expect(searchService.search).toHaveBeenCalledWith(jasmine.objectContaining({
+      configuration: 'workspace',
+      filters: [],
+      sort: new SortOptions('lastModified', SortDirection.DESC),
+      pagination: jasmine.objectContaining({ currentPage: 1, pageSize: 20 })
+    }));
+  });
+
+  it('should display an element for each upload', () => {
+    const elements = fixture.debugElement.queryAll(By.css('ds-my-upload-element'));
+    expect(elements.length).toEqual(3);
+  });
+
+  it('should not display the empty message', () => {
+    expect(fixture.debugElement.query(By.css('.alert-info'))).toBeNull();
+  });
+
+  describe('onPageChange', () => {
+    const toPage = 2;
+
+    beforeEach(() => {
+      component.onPageChange(toPage);
+    });
+
+    it('should search the uploads for the new page', () => {
+      expect(searchService.search).toHaveBeenCalledWith(jasmine.objectContaining({
+        pagination: jasmine.objectContaining({ currentPage: toPage })
+      }));
+    });
+  });
+
+  describe('onStatusChange', () => {
+    describe('when a status is selected', () => {
+      beforeEach(() => {
+        component.onPageChange(3);
+        component.onStatusChange('workflow');
+      });
+
+      it('should search the uploads with the status filter from the first page', () => {
+        expect(searchService.search).toHaveBeenCalledWith(jasmine.objectContaining({
+          filters: [new SearchFilter('f.namedresourcetype', ['workflow'], 'authority')],
+          pagination: jasmine.objectContaining({ currentPage: 1 })
+        }));
+      });
+    });
+
+    describe('when all statuses are selected', () => {
+      beforeEach(() => {
+        component.onStatusChange('workflow');
+        component.onStatusChange('');
+      });
+
+      it('should search the uploads without a status filter', () => {
+        expect((searchService.search as jasmine.Spy).calls.mostRecent().args[0].filters).toEqual([]);
+      });
+    });
+  });
+
+  describe('when the user has no uploads', () => {
+    beforeEach(() => {
+      (searchService.search as jasmine.Spy).and.returnValue(createSuccessfulRemoteDataObject$(createPaginatedList([])));
+      component.setUploads();
+      fixture.detectChanges();
+    });
+
+    it('should display the empty message', () => {
+      expect(fixture.debugElement.query(By.css('.alert-info'))).not.toBeNull();
+    });
+
+    it('should not display any upload', () => {
+      expect(fixture.debugElement.queryAll(By.css('ds-my-upload-element')).length).toEqual(0);
+    });
+  });
+});
