+import { Component, Input, OnInit } from '@angular/core';
+import { Observable, of as observableOf } from 'rxjs';
+import { find, map } from 'rxjs/operators';
+import { LinkService } from '../../core/cache/builders/link.service';
+import { RemoteData } from '../../core/data/remote-data';
+import { DSpaceObject } from '../../core/shared/dspace-object.model';
+import { Item } from '../../core/shared/item.model';
+import { SubmissionObject } from '../../core/submission/models/submission-object.model';
+import { WorkflowItem } from '../../core/submission/models/workflowitem.model';
+import { MyDspaceItemStatusType } from '../../shared/object-collection/shared/mydspace-item-status/my-dspace-item-status-type';
+import { followLink } from '../../shared/utils/follow-link-config.model';
+import { isNotUndefined } from '../../shared/empty.util';
+import { getItemPageRoute } from '../../+item-page/item-page-routing-paths';
+
+@Component({
+  selector: 'ds-my-upload-element',
+  templateUrl: './my-upload-element.component.html'
+})
+/**
+ * Одна загрузка в списке: название, дата и статус
+ */
+export class MyUploadElementComponent implements OnInit {
+
+  /**
+   * Item, workspace или workflow item из выдачи поиска
+   */
+  @Input() object: DSpaceObject;
+
+  /**
+   * Сам item, у workspace/workflow достаём его по ссылке
+   */
+  item$: Observable<Item>;
+
+  /**
+   * Статус для бейджа
+   */
+  status: MyDspaceItemStatusType;
+
+  /**
+   * Ссылка на страницу item'а, есть только у архивных
+   */
+  itemPageRoute: string;
+
+  /**
+   * Формат даты
+   */
+  dateFormat = 'yyyy-MM-dd HH:mm';
+
+  constructor(protected linkService: LinkService) {
+  }
+
+  ngOnInit(): void {
+    if (this.object instanceof Item) {
+      this.status = MyDspaceItemStatusType.ARCHIVED;
+      this.itemPageRoute = getItemPageRoute(this.object.id);
+      this.item$ = observableOf(this.object);
+    } else {
+      this.status = this.object instanceof WorkflowItem ? MyDspaceItemStatusType.WORKFLOW : MyDspaceItemStatusType.WORKSPACE;
+      this.linkService.resolveLink(this.object, followLink('item'));
+      this.item$ = ((this.object as SubmissionObject).item as Observable<RemoteData<Item>>).pipe(
+        find((rd: RemoteData<Item>) => rd.hasSucceeded && isNotUndefined(rd.payload)),
+        map((rd: RemoteData<Item>) => rd.payload)
+      );
+    }
+  }
+
+}
