+import { SearchResult } from '../shared/search/search-result.model';
+import { SearchFilter } from '../shared/search/search-filter.model';
+import { PaginatedSearchOptions } from '../shared/search/paginated-search-options.model';
+import { PaginationComponentOptions } from '../shared/pagination/pagination-component-options.model';
+import { MyDspaceItemStatusType } from '../shared/object-collection/shared/mydspace-item-status/my-dspace-item-status-type';
+import { MyDSpaceConfigurationValueType } from '../+my-dspace-page/my-dspace-configuration-value-type';
+import { isNotEmpty } from '../shared/empty.util';
+
+@Component({
+  selector: 'ds-my-uploads-page',
+  templateUrl: './my-uploads-page.component.html'
+})
+/**
+ * Страница "Мои последние загрузки" - item'ы, которые засабмитил текущий пользователь
+ */
+export class MyUploadsPageComponent implements OnInit {
+
+  /**
+   * Загрузки пользователя на текущей странице
+   */
+  uploadsRD$: Observable<RemoteData<PaginatedList<SearchResult<DSpaceObject>>>>;
+
+  /**
+   * Пагинация, по 20 штук на страницу
+   */
+  pageConfig: PaginationComponentOptions = Object.assign(new PaginationComponentOptions(), {
+    id: 'my-uploads-pagination',
+    pageSize: 20,
+    currentPage: 1
+  });
+
+  /**
+   * Сначала свежие
+   */
+  sortConfig: SortOptions = new SortOptions('lastModified', SortDirection.DESC);
+
+  /**
+   * Варианты фильтра по статусу.
+   * value - authority фасета namedresourcetype, label - готовые ключи из mydspace
+   */
+  statusOptions = [
+    { value: 'workspace', label: MyDspaceItemStatusType.WORKSPACE },
+    { value: 'workflow', label: MyDspaceItemStatusType.WORKFLOW },
+    { value: 'item', label: MyDspaceItemStatusType.ARCHIVED }
+  ];
+
+  /**
+   * Выбранный статус, пустая строка - все
+   */
+  currentStatus = '';
+
+  constructor(protected searchService: SearchService) {
+    // парсер и запрос как в mydspace, в выдаче workspace/workflow item'ы
+    this.searchService.setServiceOptions(MyDSpaceResponseParsingService, MyDSpaceRequest);
+  }
+
+  ngOnInit(): void {
+    this.setUploads();
+  }
+
+  /**
+   * Переключили страницу
+   * @param event номер новой страницы
+   */
+  onPageChange(event) {
+    this.pageConfig = Object.assign(new PaginationComponentOptions(), this.pageConfig, {
+      currentPage: event
+    });
+    this.setUploads();
+  }
+
+  /**
+   * Поменяли статус в фильтре - начинаем с первой страницы
+   * @param status выбранный статус
+   */
+  onStatusChange(status: string) {
+    this.currentStatus = status;
+    this.pageConfig = Object.assign(new PaginationComponentOptions(), this.pageConfig, {
+      currentPage: 1
+    });
+    this.setUploads();
+  }
+
+  /**
+   * Запрашиваем загрузки для текущей страницы и статуса
+   */
+  setUploads() {
+    const filters = isNotEmpty(this.currentStatus) ? [new SearchFilter('f.namedresourcetype', [this.currentStatus], 'authority')] : [];
+    this.uploadsRD$ = this.searchService.search(new PaginatedSearchOptions({
+      configuration: MyDSpaceConfigurationValueType.Workspace,
+      filters: filters,
+      pagination: this.pageConfig,
+      sort: this.sortConfig
+    }));
+  }
+
+}
