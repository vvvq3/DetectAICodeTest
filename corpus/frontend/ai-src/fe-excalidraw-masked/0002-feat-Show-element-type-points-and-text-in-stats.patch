+      max-width: 120px;
+      overflow: hidden;
+      text-overflow: ellipsis;
+      white-space: nowrap;
+    }
   }
 
   :root[dir="rtl"] & {
diff --git a/src/components/Stats.tsx b/src/components/Stats.tsx
index 3780691e..89697be6 100644
