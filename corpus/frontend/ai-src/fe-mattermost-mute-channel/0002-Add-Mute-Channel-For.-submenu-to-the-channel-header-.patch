+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import React from 'react';
+import {injectIntl, IntlShape} from 'react-intl';
+
+import {Channel} from 'mattermost-redux/types/channels';
+import {UserProfile} from 'mattermost-redux/types/users';
+
+import Menu from 'components/widgets/menu/menu';
+
+import {ChannelMuteDurations} from 'utils/constants';
+
+const HOUR = 60 * 60 * 1000;
+
+const LIMITED_DURATIONS = [
+    ChannelMuteDurations.ONE_HOUR,
+    ChannelMuteDurations.EIGHT_HOURS,
+    ChannelMuteDurations.TWENTY_FOUR_HOURS,
+];
+
+export type Actions = {
+    muteChannel(userId: string, channelId: string): void;
+    muteChannelFor(userId: string, channelId: string, duration: number): void;
+};
+
+type Props = {
+
+    /**
+     * Used for the IDs of the menu items and as a test selector
+     */
+    id: string;
+
+    /**
+     * Object with info about the current user
+     */
+    user: UserProfile;
+
+    /**
+     * Object with info about the current channel
+     */
+    channel: Channel;
+
+    /**
+     * Boolean whether the current channel is muted
+     */
+    isMuted: boolean;
+
+    /**
+     * Width of the menu containing this item, used to open the submenu alongside it
+     */
+    menuWidth?: number;
+
+    intl: IntlShape;
+
+    /**
+     * Object with action creators
+     */
+    actions: Actions;
+};
+
+export class MenuItemMuteChannelFor extends React.PureComponent<Props> {
+    muteFor = (duration: number) => {
+        const {user, channel, actions} = this.props;
+
+        actions.muteChannelFor(user.id, channel.id, duration);
+    }
+
+    muteUntilUnmuted = () => {
+        const {user, channel, actions} = this.props;
+
+        actions.muteChannel(user.id, channel.id);
+    }
+
+    render() {
+        const {
+            id,
+            intl,
+            isMuted,
+            menuWidth,
+        } = this.props;
+
+        // Once the channel is muted, the Unmute Channel item shows how much longer it'll stay muted instead
+        if (isMuted) {
+            return null;
+        }
+
+        const subMenu = LIMITED_DURATIONS.map((duration) => {
+            const hours = duration / HOUR;
+
+            return {
+                id: `${id}_${hours}h`,
+                text: intl.formatMessage({
+                    id: 'channel_header.muteFor.hours',
+                    defaultMessage: '{hours, plural, one {# hour} other {# hours}}',
+                }, {hours}),
+                action: () => this.muteFor(duration),
+                direction: 'right' as const,
+            };
+        });
+
+        subMenu.push({
+            id: `${id}_untilUnmuted`,
+            text: intl.formatMessage({
+                id: 'channel_header.muteFor.untilUnmuted',
+                defaultMessage: 'Until I unmute',
+            }),
+            action: this.muteUntilUnmuted,
+            direction: 'right' as const,
+        });
+
+        return (
+            <Menu.ItemSubMenu
+                id={id}
+                text={intl.formatMessage({
+                    id: 'channel_header.muteFor',
+                    defaultMessage: 'Mute Channel For...',
+                })}
+                subMenu={subMenu}
+                direction='right'
+                xOffset={menuWidth}
+                root={true}
+            />
+        );
+    }
+}
+
+export default injectIntl(MenuItemMuteChannelFor);
