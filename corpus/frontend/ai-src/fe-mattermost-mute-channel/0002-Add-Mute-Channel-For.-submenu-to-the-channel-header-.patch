+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import React from 'react';
+
+import {Channel} from 'mattermost-redux/types/channels';
+import {UserProfile} from 'mattermost-redux/types/users';
+
+import {shallowWithIntl} from 'tests/helpers/intl-test-helper';
+import {ChannelMuteDurations, Constants} from 'utils/constants';
+
+import Menu from 'components/widgets/menu/menu';
+
+import MenuItemMuteChannelFor from './mute_channel_for';
+
+describe('components/ChannelHeaderDropdown/MenuItemMuteChannelFor', () => {
+    const baseProps = {
+        id: 'channelMuteChannelFor',
+        user: {
+            id: 'user_id',
+        } as UserProfile,
+        channel: {
+            id: 'channel_id',
+            type: 'O',
+        } as Channel,
+        isMuted: false,
+        menuWidth: 240,
+        actions: {
+            muteChannel: jest.fn(),
+            muteChannelFor: jest.fn(),
+        },
+    };
+
+    function getSubMenu(wrapper: ReturnType<typeof shallowWithIntl>) {
+        return wrapper.find(Menu.ItemSubMenu).props().subMenu!;
+    }
+
+    it('should render a submenu that opens alongside the channel menu', () => {
+        const wrapper = shallowWithIntl(<MenuItemMuteChannelFor {...baseProps}/>);
+
+        const subMenuItem = wrapper.find(Menu.ItemSubMenu);
+        expect(subMenuItem.exists()).toBe(true);
+        expect(subMenuItem.props().id).toBe('channelMuteChannelFor');
+        expect(subMenuItem.props().text).toBe('Mute Channel For...');
+        expect(subMenuItem.props().direction).toBe('right');
+        expect(subMenuItem.props().xOffset).toBe(240);
+        expect(subMenuItem.props().root).toBe(true);
+    });
+
+    it('should offer 1 hour, 8 hours, 24 hours and until unmuted', () => {
+        const wrapper = shallowWithIntl(<MenuItemMuteChannelFor {...baseProps}/>);
+
+        const subMenu = getSubMenu(wrapper);
+        expect(subMenu.map((item) => item.id)).toEqual([
+            'channelMuteChannelFor_1h',
+            'channelMuteChannelFor_8h',
+            'channelMuteChannelFor_24h',
+            'channelMuteChannelFor_untilUnmuted',
+        ]);
+        expect(subMenu.map((item) => item.text)).toEqual([
+            '1 hour',
+            '8 hours',
+            '24 hours',
+            'Until I unmute',
+        ]);
+    });
+
+    it('should mute the channel for the chosen amount of time', () => {
+        const testCases = [
+            {index: 0, duration: ChannelMuteDurations.ONE_HOUR},
+            {index: 1, duration: ChannelMuteDurations.EIGHT_HOURS},
+            {index: 2, duration: ChannelMuteDurations.TWENTY_FOUR_HOURS},
+        ];
+
+        for (const testCase of testCases) {
+            const props = {
+                ...baseProps,
+                actions: {
+                    muteChannel: jest.fn(),
+                    muteChannelFor: jest.fn(),
+                },
+            };
+            const wrapper = shallowWithIntl(<MenuItemMuteChannelFor {...props}/>);
+
+            getSubMenu(wrapper)[testCase.index].action!();
+
+            expect(props.actions.muteChannelFor).toHaveBeenCalledTimes(1);
+            expect(props.actions.muteChannelFor).toHaveBeenCalledWith('user_id', 'channel_id', testCase.duration);
+            expect(props.actions.muteChannel).not.toHaveBeenCalled();
+        }
+    });
+
+    it('should mute the channel indefinitely when choosing until unmuted', () => {
+        const props = {
+            ...baseProps,
+            actions: {
+                muteChannel: jest.fn(),
+                muteChannelFor: jest.fn(),
+            },
+        };
+        const wrapper = shallowWithIntl(<MenuItemMuteChannelFor {...props}/>);
+
+        getSubMenu(wrapper)[3].action!();
+
+        expect(props.actions.muteChannel).toHaveBeenCalledTimes(1);
+        expect(props.actions.muteChannel).toHaveBeenCalledWith('user_id', 'channel_id');
+        expect(props.actions.muteChannelFor).not.toHaveBeenCalled();
+    });
+
+    it('should not render anything when the channel is already muted', () => {
+        const wrapper = shallowWithIntl(
+            <MenuItemMuteChannelFor
+                {...baseProps}
+                isMuted={true}
+            />,
+        );
+
+        expect(wrapper.isEmptyRender()).toBe(true);
+    });
+
+    it('should be available for all channel types', () => {
+        [
+            Constants.DM_CHANNEL,
+            Constants.GM_CHANNEL,
+            Constants.OPEN_CHANNEL,
+            Constants.PRIVATE_CHANNEL,
+        ].forEach((channelType) => {
+            const channel = {
+                id: 'channel_id',
+                type: channelType,
+            } as Channel;
+
+            const wrapper = shallowWithIntl(
+                <MenuItemMuteChannelFor
+                    {...baseProps}
+                    channel={channel}
+                />,
+            );
+
+            expect(wrapper.find(Menu.ItemSubMenu).exists()).toBe(true);
+        });
+    });
+});
