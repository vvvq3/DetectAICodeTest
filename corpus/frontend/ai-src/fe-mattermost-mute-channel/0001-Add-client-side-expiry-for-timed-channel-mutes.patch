+
+import {getChannelMuteExpiries, getChannelMuteExpiry} from 'selectors/views/channel_mute';
+import LocalStorageStore from 'stores/local_storage_store';
+import {GlobalState} from 'types/store';
+import {ActionTypes, NotificationLevels} from 'utils/constants';
+
+// Mute expiries are checked at least this often while any channel is muted for a limited time, even if none of
+// them are due yet. This keeps us from unmuting channels too late when timers are delayed (for example, while the
+// computer is asleep), and it lets us pick up changes made from other tabs.
+export const MAX_EXPIRY_CHECK_INTERVAL = 60 * 1000;
+
+let expiryCheckTimeout: ReturnType<typeof setTimeout> | null = null;
+
+// muteChannelFor mutes a channel and schedules it to be unmuted again after the given duration (in milliseconds).
+export function muteChannelFor(userId: string, channelId: string, duration: number) {
+    return async (dispatch: DispatchFunc, getState: GetStateFunc) => {
+        const result = await dispatch(updateChannelNotifyProps(userId, channelId, {
+            mark_unread: NotificationLevels.MENTION as 'mention',
+        }));
+        if (result.error) {
+            return result;
+        }
+
+        const expiresAt = Date.now() + duration;
+
+        LocalStorageStore.setChannelMuteExpiry(userId, channelId, expiresAt);
+        dispatch({
+            type: ActionTypes.SET_CHANNEL_MUTE_EXPIRY,
+            data: {channelId, expiresAt},
+        });
+
+        scheduleExpiryCheck(dispatch, getState);
+
+        return {data: true};
+    };
+}
+
+// clearChannelMuteExpiry stops a channel from being unmuted automatically. It should be called whenever a channel is
+// muted or unmuted manually so that an old expiry doesn't unmute it later on.
+export function clearChannelMuteExpiry(channelId: string) {
+    return (dispatch: DispatchFunc, getState: GetStateFunc) => {
+        const state = getState() as GlobalState;
+        const userId = getCurrentUserId(state);
+
+        // Always clear localStorage since another tab may have set an expiry that we haven't picked up yet
+        LocalStorageStore.removeChannelMuteExpiry(userId, channelId);
+
+        if (getChannelMuteExpiry(state, channelId) === undefined) {
+            return {data: false};
+        }
+
+        dispatch({
+            type: ActionTypes.REMOVE_CHANNEL_MUTE_EXPIRY,
+            data: {channelId},
+        });
+
+        scheduleExpiryCheck(dispatch, getState);
+
+        return {data: true};
+    };
+}
+
+// checkChannelMuteExpiries loads the mute expiries saved in localStorage, unmutes any channels whose mute has
+// expired, and then schedules the next check. It only needs to be called once on startup since it'll keep
+// rescheduling itself for as long as there are channels muted for a limited time.
+export function checkChannelMuteExpiries() {
+    return async (dispatch: DispatchFunc, getState: GetStateFunc) => {
+        const userId = getCurrentUserId(getState());
+        if (!userId) {
+            return {data: false};
+        }
+
+        // Other tabs share the same localStorage and may have changed it since we last looked, so treat it as the
+        // source of truth.
+        dispatch({
+            type: ActionTypes.RECEIVED_CHANNEL_MUTE_EXPIRIES,
+            data: LocalStorageStore.getChannelMuteExpiries(userId),
+        });
+
+        const now = Date.now();
+        const expiries = getChannelMuteExpiries(getState() as GlobalState);
+        const expired = Object.entries(expiries).filter(([, expiresAt]) => expiresAt <= now);
+
+        const results = await Promise.all(expired.map(([channelId, expiresAt]) => {
+            return dispatch(unmuteExpiredChannel(userId, channelId, expiresAt));
+        }));
+
+        // Anything that failed to unmute still has an expiry in the past, so wait a while before trying it again
+        const failed = results.some((result) => Boolean(result.error));
+        scheduleExpiryCheck(dispatch, getState, failed ? MAX_EXPIRY_CHECK_INTERVAL : 0);
+
+        return {data: true};
+    };
+}
+
+function unmuteExpiredChannel(userId: string, channelId: string, expiresAt: number) {
+    return async (dispatch: DispatchFunc, getState: GetStateFunc): Promise<ActionResult> => {
+        let member: ChannelMembership | undefined = getMyChannelMemberships(getState())[channelId];
+
+        if (!member) {
+            // Channel memberships are only loaded for the current team, so we may need to ask the server for it
+            const result = await dispatch(fetchMyChannelMember(channelId));
+
+            if (result.error) {
+                if (isClientError(result.error)) {
+                    // We can't access the channel anymore (for example, because we've left it), so there's nothing
+                    // left to unmute
+                    removeExpiryIfUnchanged(dispatch, getState, userId, channelId, expiresAt);
+                    return {data: false};
+                }
+
+                return result;
+            }
+
+            member = result.data;
+        }
+
+        if (member && isChannelMuted(member)) {
+            const result = await dispatch(updateChannelNotifyProps(userId, channelId, {
+                mark_unread: NotificationLevels.ALL as 'all',
+            }));
+            if (result.error) {
+                return result;
+            }
+        }
+
+        removeExpiryIfUnchanged(dispatch, getState, userId, channelId, expiresAt);
+
+        return {data: true};
+    };
+}
+
+function removeExpiryIfUnchanged(dispatch: DispatchFunc, getState: GetStateFunc, userId: string, channelId: string, expiresAt: number) {
+    // The channel may have been muted again while we were waiting on the server, and we don't want to lose that
+    if (getChannelMuteExpiry(getState() as GlobalState, channelId) !== expiresAt) {
+        return;
+    }
+
+    LocalStorageStore.removeChannelMuteExpiry(userId, channelId);
+    dispatch({
+        type: ActionTypes.REMOVE_CHANNEL_MUTE_EXPIRY,
+        data: {channelId},
+    });
+}
+
+function scheduleExpiryCheck(dispatch: DispatchFunc, getState: GetStateFunc, minDelay = 0) {
+    if (expiryCheckTimeout) {
+        clearTimeout(expiryCheckTimeout);
+        expiryCheckTimeout = null;
+    }
+
+    const expiresAts = Object.values(getChannelMuteExpiries(getState() as GlobalState));
+    if (expiresAts.length === 0) {
+        return;
+    }
+
+    const nextExpiresAt = Math.min(...expiresAts);
+    const delay = Math.min(Math.max(nextExpiresAt - Date.now(), minDelay), MAX_EXPIRY_CHECK_INTERVAL);
+
+    expiryCheckTimeout = setTimeout(() => {
+        expiryCheckTimeout = null;
+        dispatch(checkChannelMuteExpiries());
+    }, delay);
+}
+
+function isClientError(error: {status_code?: number}) {
+    return Boolean(error.status_code && error.status_code >= 400 && error.status_code < 500);
+}
