index 000000000..d9388e2c9
--- /dev/null
+++ b/actions/views/channel_mute.test.js
@@ -0,0 +1,370 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import {applyMiddleware, combineReducers, createStore} from 'redux';
+import thunk from 'redux-thunk';
+
+import {getMyChannelMember, updateChannelNotifyProps} from 'mattermost-redux/actions/channels';
+
+import {
+    checkChannelMuteExpiries,
+    clearChannelMuteExpiry,
+    muteChannelFor,
+    MAX_EXPIRY_CHECK_INTERVAL,
+} from 'actions/views/channel_mute';
+import channelMuteReducer from 'reducers/views/channel_mute';
+import {getChannelMuteExpiries} from 'selectors/views/channel_mute';
+import LocalStorageStore from 'stores/local_storage_store';
+import {ChannelMuteDurations} from 'utils/constants';
+
+jest.mock('mattermost-redux/actions/channels', () => ({
+    getMyChannelMember: jest.fn(),
+    updateChannelNotifyProps: jest.fn(),
+}));
+
+jest.mock('stores/redux_store', () => ({
+    dispatch: jest.fn(),
+    getState: () => ({
+        entities: {
+            general: {
+                config: {},
+            },
+        },
+    }),
+}));
+
+const SECOND = 1000;
+const MINUTE = 60 * SECOND;
+const HOUR = 60 * MINUTE;
+
+const now = 1600000000000;
+const userId = 'user1';
+
+function mutedMember(channelId) {
+    return {channel_id: channelId, user_id: userId, notify_props: {mark_unread: 'mention'}};
+}
+
+function unmutedMember(channelId) {
+    return {channel_id: channelId, user_id: userId, notify_props: {mark_unread: 'all'}};
+}
+
+// The mute expiry actions read and write views.channelMute, so use the real reducer for that while keeping the rest
+// of the state fixed.
+function configureTestStore({currentUserId = userId, myMembers = {}} = {}) {
+    const entities = {
+        users: {currentUserId},
+        channels: {myMembers},
+    };
+
+    return createStore(
+        combineReducers({
+            entities: (state = entities) => state,
+            views: combineReducers({
+                channelMute: channelMuteReducer,
+            }),
+        }),
+        applyMiddleware(thunk),
+    );
+}
+
+// The expiry checks chain several promises together, so give them a few turns to finish after a timer fires
+async function flushPromises() {
+    for (let i = 0; i < 10; i++) {
+        await Promise.resolve(); // eslint-disable-line no-await-in-loop
+    }
+}
+
+describe('actions/views/channel_mute', () => {
+    beforeEach(() => {
+        jest.useFakeTimers();
+        jest.spyOn(Date, 'now').mockReturnValue(now);
+
+        delete window.basename;
+        localStorage.clear();
+
+        updateChannelNotifyProps.mockImplementation(() => () => Promise.resolve({data: true}));
+        getMyChannelMember.mockImplementation((channelId) => () => Promise.resolve({data: mutedMember(channelId)}));
+    });
+
+    afterEach(() => {
+        jest.clearAllTimers();
+        jest.useRealTimers();
+        jest.restoreAllMocks();
+    });
+
+    describe('muteChannelFor', () => {
+        test('should mute the channel and save when it should be unmuted', async () => {
+            const store = configureTestStore();
+
+            const result = await store.dispatch(muteChannelFor(userId, 'channel1', ChannelMuteDurations.EIGHT_HOURS));
+
+            expect(result).toEqual({data: true});
+            expect(updateChannelNotifyProps).toHaveBeenCalledTimes(1);
+            expect(updateChannelNotifyProps).toHaveBeenCalledWith(userId, 'channel1', {mark_unread: 'mention'});
+
+            expect(getChannelMuteExpiries(store.getState())).toEqual({channel1: now + (8 * HOUR)});
+            expect(LocalStorageStore.getChannelMuteExpiries(userId)).toEqual({channel1: now + (8 * HOUR)});
+        });
+
+        test('should replace an earlier expiry for the same channel', async () => {
+            const store = configureTestStore();
+
+            await store.dispatch(muteChannelFor(userId, 'channel1', ChannelMuteDurations.TWENTY_FOUR_HOURS));
+            await store.dispatch(muteChannelFor(userId, 'channel1', ChannelMuteDurations.ONE_HOUR));
+
+            expect(getChannelMuteExpiries(store.getState())).toEqual({channel1: now + HOUR});
+            expect(LocalStorageStore.getChannelMuteExpiries(userId)).toEqual({channel1: now + HOUR});
+        });
+
+        test('should not save an expiry when the channel could not be muted', async () => {
+            const error = {message: 'Something went wrong'};
+            updateChannelNotifyProps.mockImplementation(() => () => Promise.resolve({error}));
+
+            const store = configureTestStore();
+
+            const result = await store.dispatch(muteChannelFor(userId, 'channel1', ChannelMuteDurations.ONE_HOUR));
+
+            expect(result).toEqual({error});
+            expect(getChannelMuteExpiries(store.getState())).toEqual({});
+            expect(LocalStorageStore.getChannelMuteExpiries(userId)).toEqual({});
+            expect(jest.getTimerCount()).toBe(0);
+        });
+
+        test('should automatically unmute the channel once the time has passed', async () => {
+            const store = configureTestStore({myMembers: {channel1: mutedMember('channel1')}});
+
+            await store.dispatch(muteChannelFor(userId, 'channel1', 30 * SECOND));
+            updateChannelNotifyProps.mockClear();
+
+            expect(setTimeout).toHaveBeenLastCalledWith(expect.any(Function), 30 * SECOND);
+
+            Date.now.mockReturnValue(now + (30 * SECOND));
+            jest.runOnlyPendingTimers();
+            await flushPromises();
+
+            expect(updateChannelNotifyProps).toHaveBeenCalledTimes(1);
+            expect(updateChannelNotifyProps).toHaveBeenCalledWith(userId, 'channel1', {mark_unread: 'all'});
+
+            expect(getChannelMuteExpiries(store.getState())).toEqual({});
+            expect(LocalStorageStore.getChannelMuteExpiries(userId)).toEqual({});
+
+            // Nothing is left to check, so there's no need to keep the timer running
+            expect(jest.getTimerCount()).toBe(0);
+        });
+
+        test('should check at least once a minute until the channel should be unmuted', async () => {
+            const store = configureTestStore({myMembers: {channel1: mutedMember('channel1')}});
+
+            await store.dispatch(muteChannelFor(userId, 'channel1', ChannelMuteDurations.ONE_HOUR));
+            updateChannelNotifyProps.mockClear();
+
+            expect(setTimeout).toHaveBeenLastCalledWith(expect.any(Function), MAX_EXPIRY_CHECK_INTERVAL);
+
+            Date.now.mockReturnValue(now + MAX_EXPIRY_CHECK_INTERVAL);
+            jest.runOnlyPendingTimers();
+            await flushPromises();
+
+            // The channel is still muted, and we'll keep checking on it
+            expect(updateChannelNotifyProps).not.toHaveBeenCalled();
+            expect(getChannelMuteExpiries(store.getState())).toEqual({channel1: now + HOUR});
+            expect(jest.getTimerCount()).toBe(1);
+        });
+    });
+
+    describe('clearChannelMuteExpiry', () => {
+        test('should stop the channel from being unmuted automatically', async () => {
+            const store = configureTestStore({myMembers: {channel1: mutedMember('channel1')}});
+
+            await store.dispatch(muteChannelFor(userId, 'channel1', ChannelMuteDurations.ONE_HOUR));
+            updateChannelNotifyProps.mockClear();
+
+            const result = store.dispatch(clearChannelMuteExpiry('channel1'));
+
+            expect(result).toEqual({data: true});
+            expect(getChannelMuteExpiries(store.getState())).toEqual({});
+            expect(LocalStorageStore.getChannelMuteExpiries(userId)).toEqual({});
+            expect(jest.getTimerCount()).toBe(0);
+        });
+
+        test('should only clear the given channel', async () => {
+            const store = configureTestStore();
+
+            await store.dispatch(muteChannelFor(userId, 'channel1', ChannelMuteDurations.ONE_HOUR));
+            await store.dispatch(muteChannelFor(userId, 'channel2', ChannelMuteDurations.EIGHT_HOURS));
+
+            store.dispatch(clearChannelMuteExpiry('channel1'));
+
+            expect(getChannelMuteExpiries(store.getState())).toEqual({channel2: now + (8 * HOUR)});
+            expect(LocalStorageStore.getChannelMuteExpiries(userId)).toEqual({channel2: now + (8 * HOUR)});
+            expect(jest.getTimerCount()).toBe(1);
+        });
+
+        test('should clear an expiry that was saved from another tab', () => {
+            LocalStorageStore.setChannelMuteExpiry(userId, 'channel1', now + HOUR);
+
+            const store = configureTestStore();
+
+            const result = store.dispatch(clearChannelMuteExpiry('channel1'));
+
+            expect(result).toEqual({data: false});
+            expect(LocalStorageStore.getChannelMuteExpiries(userId)).toEqual({});
+        });
+    });
+
+    describe('checkChannelMuteExpiries', () => {
+        test('should load saved expiries', async () => {
+            LocalStorageStore.setChannelMuteExpiry(userId, 'channel1', now + HOUR);
+            LocalStorageStore.setChannelMuteExpiry(userId, 'channel2', now + (8 * HOUR));
+
+            const store = configureTestStore();
+
+            await store.dispatch(checkChannelMuteExpiries());
+
+            expect(getChannelMuteExpiries(store.getState())).toEqual({
+                channel1: now + HOUR,
+                channel2: now + (8 * HOUR),
+            });
+            expect(updateChannelNotifyProps).not.toHaveBeenCalled();
+            expect(jest.getTimerCount()).toBe(1);
+        });
+
+        test('should only load expiries saved for the current user', async () => {
+            LocalStorageStore.setChannelMuteExpiry('otherUser', 'channel1', now - SECOND);
+
+            const store = configureTestStore({myMembers: {channel1: mutedMember('channel1')}});
+
+            await store.dispatch(checkChannelMuteExpiries());
+
+            expect(getChannelMuteExpiries(store.getState())).toEqual({});
+            expect(updateChannelNotifyProps).not.toHaveBeenCalled();
+            expect(LocalStorageStore.getChannelMuteExpiries('otherUser')).toEqual({channel1: now - SECOND});
+        });
+
+        test('should unmute channels whose mute has expired', async () => {
+            LocalStorageStore.setChannelMuteExpiry(userId, 'channel1', now - SECOND);
+            LocalStorageStore.setChannelMuteExpiry(userId, 'channel2', now + HOUR);
+
+            const store = configureTestStore({
+                myMembers: {
+                    channel1: mutedMember('channel1'),
+                    channel2: mutedMember('channel2'),
+                },
+            });
+
+            await store.dispatch(checkChannelMuteExpiries());
+
+            expect(updateChannelNotifyProps).toHaveBeenCalledTimes(1);
+            expect(updateChannelNotifyProps).toHaveBeenCalledWith(userId, 'channel1', {mark_unread: 'all'});
+
+            expect(getChannelMuteExpiries(store.getState())).toEqual({channel2: now + HOUR});
+            expect(LocalStorageStore.getChannelMuteExpiries(userId)).toEqual({channel2: now + HOUR});
+        });
+
+        test('should forget the expiry without unmuting a channel that was already unmuted some other way', async () => {
+            LocalStorageStore.setChannelMuteExpiry(userId, 'channel1', now - SECOND);
+
+            const store = configureTestStore({myMembers: {channel1: unmutedMember('channel1')}});
+
+            await store.dispatch(checkChannelMuteExpiries());
+
+            expect(updateChannelNotifyProps).not.toHaveBeenCalled();
+            expect(getChannelMuteExpiries(store.getState())).toEqual({});
+            expect(LocalStorageStore.getChannelMuteExpiries(userId)).toEqual({});
+            expect(jest.getTimerCount()).toBe(0);
+        });
+
+        test('should load the channel membership when it has not been loaded yet', async () => {
+            LocalStorageStore.setChannelMuteExpiry(userId, 'channel1', now - SECOND);
+
+            const store = configureTestStore();
+
+            await store.dispatch(checkChannelMuteExpiries());
+
+            expect(getMyChannelMember).toHaveBeenCalledWith('channel1');
+            expect(updateChannelNotifyProps).toHaveBeenCalledWith(userId, 'channel1', {mark_unread: 'all'});
+            expect(getChannelMuteExpiries(store.getState())).toEqual({});
+        });
+
+        test('should forget the expiry for a channel that can no longer be accessed', async () => {
+            getMyChannelMember.mockImplementation(() => () => Promise.resolve({error: {status_code: 403}}));
+            LocalStorageStore.setChannelMuteExpiry(userId, 'channel1', now - SECOND);
+
+            const store = configureTestStore();
+
+            await store.dispatch(checkChannelMuteExpiries());
+
+            expect(updateChannelNotifyProps).not.toHaveBeenCalled();
+            expect(getChannelMuteExpiries(store.getState())).toEqual({});
+            expect(LocalStorageStore.getChannelMuteExpiries(userId)).toEqual({});
+        });
+
+        test('should keep the expiry and try again later when the channel membership could not be loaded', async () => {
+            getMyChannelMember.mockImplementation(() => () => Promise.resolve({error: {message: 'Network error'}}));
+            LocalStorageStore.setChannelMuteExpiry(userId, 'channel1', now - SECOND);
+
+            const store = configureTestStore();
+
+            await store.dispatch(checkChannelMuteExpiries());
+
+            expect(updateChannelNotifyProps).not.toHaveBeenCalled();
+            expect(getChannelMuteExpiries(store.getState())).toEqual({channel1: now - SECOND});
+            expect(setTimeout).toHaveBeenLastCalledWith(expect.any(Function), MAX_EXPIRY_CHECK_INTERVAL);
+        });
+
+        test('should keep the expiry and try again later when the channel could not be unmuted', async () => {
+            updateChannelNotifyProps.mockImplementation(() => () => Promise.resolve({error: {message: 'Network error'}}));
+            LocalStorageStore.setChannelMuteExpiry(userId, 'channel1', now - SECOND);
+
+            const store = configureTestStore({myMembers: {channel1: mutedMember('channel1')}});
+
+            await store.dispatch(checkChannelMuteExpiries());
+
+            expect(updateChannelNotifyProps).toHaveBeenCalledTimes(1);
+            expect(getChannelMuteExpiries(store.getState())).toEqual({channel1: now - SECOND});
+            expect(LocalStorageStore.getChannelMuteExpiries(userId)).toEqual({channel1: now - SECOND});
+            expect(setTimeout).toHaveBeenLastCalledWith(expect.any(Function), MAX_EXPIRY_CHECK_INTERVAL);
+
+            // Once the server is reachable again, the next check unmutes the channel
+            updateChannelNotifyProps.mockImplementation(() => () => Promise.resolve({data: true}));
+            Date.now.mockReturnValue(now + MAX_EXPIRY_CHECK_INTERVAL);
+            jest.runOnlyPendingTimers();
+            await flushPromises();
+
+            expect(updateChannelNotifyProps).toHaveBeenCalledTimes(2);
+            expect(getChannelMuteExpiries(store.getState())).toEqual({});
+            expect(LocalStorageStore.getChannelMuteExpiries(userId)).toEqual({});
+        });
+
+        test('should pick up changes made from other tabs', async () => {
+            LocalStorageStore.setChannelMuteExpiry(userId, 'channel1', now + HOUR);
+
+            const store = configureTestStore({myMembers: {channel1: mutedMember('channel1')}});
+
+            await store.dispatch(checkChannelMuteExpiries());
+            expect(getChannelMuteExpiries(store.getState())).toEqual({channel1: now + HOUR});
+
+            // Another tab unmutes the channel and mutes a different one
+            LocalStorageStore.removeChannelMuteExpiry(userId, 'channel1');
+            LocalStorageStore.setChannelMuteExpiry(userId, 'channel2', now + (8 * HOUR));
+
+            Date.now.mockReturnValue(now + MAX_EXPIRY_CHECK_INTERVAL);
+            jest.runOnlyPendingTimers();
+            await flushPromises();
+
+            expect(getChannelMuteExpiries(store.getState())).toEqual({channel2: now + (8 * HOUR)});
+            expect(updateChannelNotifyProps).not.toHaveBeenCalled();
+        });
+
+        test('should do nothing when nobody is logged in', async () => {
+            LocalStorageStore.setChannelMuteExpiry('', 'channel1', now - SECOND);
+
+            const store = configureTestStore({currentUserId: ''});
+
+            const result = await store.dispatch(checkChannelMuteExpiries());
+
+            expect(result).toEqual({data: false});
+            expect(getChannelMuteExpiries(store.getState())).toEqual({});
+            expect(updateChannelNotifyProps).not.toHaveBeenCalled();
+        });
+    });
+});
