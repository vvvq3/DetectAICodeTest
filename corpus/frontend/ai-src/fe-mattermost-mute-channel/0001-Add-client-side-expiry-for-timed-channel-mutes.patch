+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import {combineReducers} from 'redux';
+
+import {UserTypes} from 'mattermost-redux/action_types';
+import {GenericAction} from 'mattermost-redux/types/actions';
+
+import {ActionTypes} from 'utils/constants';
+
+// expiries maps channel IDs to the time (in milliseconds) at which the channel should be automatically
+// unmuted. Channels that are muted indefinitely don't have an entry.
+export function expiries(state: Record<string, number> = {}, action: GenericAction): Record<string, number> {
+    switch (action.type) {
+    case ActionTypes.RECEIVED_CHANNEL_MUTE_EXPIRIES:
+        return {...action.data};
+
+    case ActionTypes.SET_CHANNEL_MUTE_EXPIRY: {
+        const {channelId, expiresAt} = action.data;
+
+        if (state[channelId] === expiresAt) {
+            return state;
+        }
+
+        return {
+            ...state,
+            [channelId]: expiresAt,
+        };
+    }
+
+    case ActionTypes.REMOVE_CHANNEL_MUTE_EXPIRY: {
+        const {channelId} = action.data;
+
+        if (!state.hasOwnProperty(channelId)) {
+            return state;
+        }
+
+        const nextState = {...state};
+        Reflect.deleteProperty(nextState, channelId);
+        return nextState;
+    }
+
+    case UserTypes.LOGOUT_SUCCESS:
+        return {};
+    default:
+        return state;
+    }
+}
+
+export default combineReducers({
+    expiries,
+});
