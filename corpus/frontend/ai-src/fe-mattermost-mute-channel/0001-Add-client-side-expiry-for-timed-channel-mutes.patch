+            expect(nextState.expiries).toEqual({
+                channel1: 5000,
+            });
+        });
+
+        test('should not change state when setting the same expiry', () => {
+            const state = {
+                expiries: {
+                    channel1: 1000,
+                },
+            };
+
+            const nextState = channelMuteReducer(state, {
+                type: ActionTypes.SET_CHANNEL_MUTE_EXPIRY,
+                data: {channelId: 'channel1', expiresAt: 1000},
+            });
+
+            expect(nextState.expiries).toBe(state.expiries);
+        });
+
+        test('should remove an expiry', () => {
+            const state = {
+                expiries: {
+                    channel1: 1000,
+                    channel2: 2000,
+                },
+            };
+
+            const nextState = channelMuteReducer(state, {
+                type: ActionTypes.REMOVE_CHANNEL_MUTE_EXPIRY,
+                data: {channelId: 'channel1'},
+            });
+
+            expect(nextState.expiries).toEqual({
+                channel2: 2000,
+            });
