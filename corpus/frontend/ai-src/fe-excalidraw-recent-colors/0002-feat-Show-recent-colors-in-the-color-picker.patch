+
+describe("recent colors in the color picker", () => {
+  const getElement = (selector: string) => {
+    const element = document.querySelector(selector);
+    if (!element) {
+      throw new Error(`No element found: ${selector}`);
+    }
+    return element;
+  };
+
+  /** opens the picker if it's closed and closes it if it's open */
+  const togglePicker = (label: string) => {
+    fireEvent.click(getElement(`button[aria-label='${label}']`));
+  };
+
+  const isPickerOpen = () => !!document.querySelector(".color-picker");
+
+  const pickPaletteColor = (color: string) => {
+    fireEvent.click(
+      getElement(`.color-picker-content [aria-label='${color}']`),
+    );
+  };
+
+  const pickRecentColor = (color: string) => {
+    fireEvent.click(getElement(`.color-picker-recent [aria-label='${color}']`));
+  };
+
+  const getRecentSwatches = () =>
+    Array.from(
+      document.querySelectorAll(".color-picker-recent .color-picker-swatch"),
+    ).map((swatch) => swatch.getAttribute("aria-label"));
+
+  beforeEach(async () => {
+    // Unmount ReactDOM from root
+    ReactDOM.unmountComponentAtNode(document.getElementById("root")!);
+    localStorage.clear();
+    mouse.reset();
+
+    await setLanguage("en.json");
+    await render(<Excalidraw offsetLeft={0} offsetTop={0} />);
+
+    // shape actions (and thus the stroke/background pickers) are shown only
+    // while an element is selected
+    UI.clickTool("rectangle");
+    mouse.down(10, 10);
+    mouse.up(10, 10);
+  });
+
+  it("doesn't show the row until a color was picked", () => {
+    togglePicker("Background");
+    expect(isPickerOpen()).toBe(true);
+    expect(document.querySelector(".color-picker-recent")).toBeNull();
+
+    // closing without picking anything doesn't record anything either
+    togglePicker("Background");
+    expect(isPickerOpen()).toBe(false);
+    expect(getRecentColors("elementBackground")).toEqual([]);
+  });
+
+  it("remembers the picked color once the picker closes", () => {
+    togglePicker("Background");
+    pickPaletteColor("#fa5252");
+    expect(API.getSelectedElement().backgroundColor).toBe("#fa5252");
+    // nothing is recorded until the picker closes
+    expect(getRecentColors("elementBackground")).toEqual([]);
+
+    togglePicker("Background");
+    expect(getRecentColors("elementBackground")).toEqual(["#fa5252"]);
+    expect(getStoredRecentColors()).toEqual({
+      elementBackground: ["#fa5252"],
+    });
+
+    togglePicker("Background");
+    expect(getRecentSwatches()).toEqual(["#fa5252"]);
+  });
+
+  it("only remembers the last of several colors picked in one go", () => {
+    togglePicker("Background");
+    pickPaletteColor("#fa5252");
+    pickPaletteColor("#e64980");
+    togglePicker("Background");
+
+    expect(getRecentColors("elementBackground")).toEqual(["#e64980"]);
+  });
+
+  it("applies a recent color when clicked and moves it to the front", () => {
+    togglePicker("Background");
+    pickPaletteColor("#fa5252");
+    togglePicker("Background");
+
+    togglePicker("Background");
+    pickPaletteColor("#e64980");
+    togglePicker("Background");
+
+    togglePicker("Background");
+    expect(getRecentSwatches()).toEqual(["#e64980", "#fa5252"]);
+
+    pickRecentColor("#fa5252");
+    expect(API.getSelectedElement().backgroundColor).toBe("#fa5252");
+    expect(h.state.currentItemBackgroundColor).toBe("#fa5252");
+
+    togglePicker("Background");
+    expect(getRecentColors("elementBackground")).toEqual([
+      "#fa5252",
+      "#e64980",
+    ]);
+  });
+
+  it("keeps stroke and background colors separately", () => {
+    togglePicker("Stroke");
+    pickPaletteColor("#c92a2a");
+    togglePicker("Stroke");
+
+    togglePicker("Background");
+    pickPaletteColor("#fa5252");
+    togglePicker("Background");
+
+    expect(getRecentColors("elementStroke")).toEqual(["#c92a2a"]);
+    expect(getRecentColors("elementBackground")).toEqual(["#fa5252"]);
+
+    togglePicker("Stroke");
+    expect(getRecentSwatches()).toEqual(["#c92a2a"]);
+    togglePicker("Stroke");
+
+    togglePicker("Background");
+    expect(getRecentSwatches()).toEqual(["#fa5252"]);
+  });
+
+  it("shows recent colors stored in localStorage", () => {
+    localStorage.setItem(
+      STORAGE_KEYS.LOCAL_STORAGE_RECENT_COLORS,
+      JSON.stringify({ elementStroke: ["#5f3dc4", "#c92a2a"] }),
+    );
+
+    togglePicker("Stroke");
+    expect(getRecentSwatches()).toEqual(["#5f3dc4", "#c92a2a"]);
+
+    pickRecentColor("#c92a2a");
+    expect(API.getSelectedElement().strokeColor).toBe("#c92a2a");
+  });
+
+  it("doesn't record colors browsed with the keyboard, only the final one", () => {
+    togglePicker("Background");
+    // the swatch of the current color (transparent) is focused on open
+    fireEvent.keyDown(document.activeElement!, { key: KEYS.ARROW_RIGHT });
+    fireEvent.keyDown(document.activeElement!, { key: KEYS.ARROW_RIGHT });
+    expect(API.getSelectedElement().backgroundColor).toBe(
+      colors.elementBackground[2],
+    );
+
+    fireEvent.keyDown(document.activeElement!, { key: KEYS.ESCAPE });
+    expect(isPickerOpen()).toBe(false);
+    expect(getRecentColors("elementBackground")).toEqual([
+      colors.elementBackground[2],
+    ]);
+  });
+
+  it("records a color typed into the input once the input loses focus", () => {
+    const input = getElement("input[aria-label='Stroke']");
+
+    fireEvent.focus(input);
+    fireEvent.change(input, { target: { value: "zz" } });
+    fireEvent.blur(input);
+    expect(API.getSelectedElement().strokeColor).toBe("#000000");
+    expect(getRecentColors("elementStroke")).toEqual([]);
+
+    fireEvent.focus(input);
+    fireEvent.change(input, { target: { value: "fa5" } });
+    fireEvent.change(input, { target: { value: "fa5252" } });
+    expect(API.getSelectedElement().strokeColor).toBe("#fa5252");
+    expect(getRecentColors("elementStroke")).toEqual([]);
+
+    fireEvent.blur(input);
+    expect(getRecentColors("elementStroke")).toEqual(["#fa5252"]);
+  });
+});
