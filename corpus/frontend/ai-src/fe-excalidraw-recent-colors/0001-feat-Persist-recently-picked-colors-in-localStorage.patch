+import { ColorPickerType } from "../colors";
+import { STORAGE_KEYS } from "../constants";
+
+export const MAX_RECENT_COLORS = 8;
+
+type RecentColors = Partial<Record<ColorPickerType, string[]>>;
+
+const sanitizeColors = (colors: unknown): string[] =>
+  Array.isArray(colors)
+    ? colors
+        .filter((color): color is string => typeof color === "string")
+        .slice(0, MAX_RECENT_COLORS)
+    : [];
+
+const loadRecentColors = (): RecentColors => {
+  try {
+    const data = localStorage.getItem(STORAGE_KEYS.LOCAL_STORAGE_RECENT_COLORS);
+    if (data) {
+      const recentColors = JSON.parse(data);
+      if (recentColors && typeof recentColors === "object") {
+        return Array.isArray(recentColors) ? {} : recentColors;
+      }
+    }
+  } catch (error) {
+    // Unable to access localStorage or the stored data is corrupted
+    console.error(error);
+  }
+  return {};
+};
+
+/**
+ * Returns colors recently picked in a color picker of given type, most
+ * recent first. Each picker type (stroke, background, …) has its own list.
+ */
+export const getRecentColors = (type: ColorPickerType): string[] =>
+  sanitizeColors(loadRecentColors()[type]);
+
+/**
+ * Moves `color` to the front of the recent colors of given picker type
+ * (dropping the oldest one once there are more than `MAX_RECENT_COLORS`),
+ * persists the result, and returns the updated list.
+ */
+export const addRecentColor = (
+  type: ColorPickerType,
+  color: string,
+): string[] => {
+  const allRecentColors = loadRecentColors();
+  const recentColors = [
+    color,
+    ...sanitizeColors(allRecentColors[type]).filter(
+      (recentColor) => recentColor !== color,
+    ),
+  ].slice(0, MAX_RECENT_COLORS);
+
+  try {
+    localStorage.setItem(
+      STORAGE_KEYS.LOCAL_STORAGE_RECENT_COLORS,
+      JSON.stringify({ ...allRecentColors, [type]: recentColors }),
+    );
+  } catch (error) {
+    // Unable to access localStorage
+    console.error(error);
+  }
+
+  return recentColors;
+};
diff --git a/src/tests/recentColors.test.tsx b/src/tests/recentColors.test.tsx
new file mode 100644
index 00000000..bef47aae
--- /dev/null
+++ b/src/tests/recentColors.test.tsx
@@ -0,0 +1,78 @@
+import colors from "../colors";
+import { STORAGE_KEYS } from "../constants";
+import {
+  addRecentColor,
+  getRecentColors,
+  MAX_RECENT_COLORS,
+} from "../data/recentColors";
+
+const getStoredRecentColors = () =>
+  JSON.parse(localStorage.getItem(STORAGE_KEYS.LOCAL_STORAGE_RECENT_COLORS)!);
+
+describe("recent colors storage", () => {
+  beforeEach(() => {
+    localStorage.clear();
+  });
+
+  it("is empty when nothing was picked yet", () => {
+    expect(getRecentColors("elementStroke")).toEqual([]);
+    expect(getRecentColors("elementBackground")).toEqual([]);
+  });
+
+  it("keeps the most recent color first", () => {
+    addRecentColor("elementStroke", "#c92a2a");
+    addRecentColor("elementStroke", "#5f3dc4");
+
+    expect(getRecentColors("elementStroke")).toEqual(["#5f3dc4", "#c92a2a"]);
+  });
+
+  it("moves a color picked again to the front instead of duplicating it", () => {
+    addRecentColor("elementStroke", "#c92a2a");
+    addRecentColor("elementStroke", "#5f3dc4");
+    addRecentColor("elementStroke", "#c92a2a");
+
+    expect(getRecentColors("elementStroke")).toEqual(["#c92a2a", "#5f3dc4"]);
+  });
+
+  it(`keeps at most ${MAX_RECENT_COLORS} colors`, () => {
+    const picked = colors.elementStroke.slice(0, MAX_RECENT_COLORS + 2);
+    picked.forEach((color) => addRecentColor("elementStroke", color));
+
+    expect(getRecentColors("elementStroke")).toEqual(
+      picked.reverse().slice(0, MAX_RECENT_COLORS),
+    );
+  });
+
+  it("keeps stroke and background colors separately", () => {
+    addRecentColor("elementStroke", "#c92a2a");
+    addRecentColor("elementBackground", "#fa5252");
+
+    expect(getRecentColors("elementStroke")).toEqual(["#c92a2a"]);
+    expect(getRecentColors("elementBackground")).toEqual(["#fa5252"]);
+    expect(getStoredRecentColors()).toEqual({
+      elementStroke: ["#c92a2a"],
+      elementBackground: ["#fa5252"],
+    });
+  });
+
+  it("recovers from corrupted data in localStorage", () => {
+    const consoleError = jest
+      .spyOn(console, "error")
+      .mockImplementation(() => {});
+    try {
+      localStorage.setItem(STORAGE_KEYS.LOCAL_STORAGE_RECENT_COLORS, "{oops");
+      expect(getRecentColors("elementStroke")).toEqual([]);
+
+      addRecentColor("elementStroke", "#c92a2a");
+      expect(getRecentColors("elementStroke")).toEqual(["#c92a2a"]);
+
+      localStorage.setItem(
+        STORAGE_KEYS.LOCAL_STORAGE_RECENT_COLORS,
+        JSON.stringify({ elementStroke: ["#c92a2a", 42, null] }),
+      );
+      expect(getRecentColors("elementStroke")).toEqual(["#c92a2a"]);
+    } finally {
+      consoleError.mockRestore();
+    }
+  });
+});
