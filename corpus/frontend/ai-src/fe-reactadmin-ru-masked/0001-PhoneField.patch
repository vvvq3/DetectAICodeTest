+import * as React from 'react';
+import expect from 'expect';
+import { render, cleanup } from '@testing-library/react';
+import PhoneField from './PhoneField';
+
+describe('<PhoneField />', () => {
+    afterEach(cleanup);
+
+    it.each(['89991234567', '+7 999 123 45 67', '7(999)123-45-67', '9991234567'])(
+        'should format russian phone %s and render as Mui Link',
+        phone => {
+            const record = { id: 123, phone };
+            const { getByText } = render(
+                <PhoneField record={record} source="phone" />
+            );
+            const link = getByText('+7 (999) 123-45-67') as HTMLAnchorElement;
+            expect(link.tagName).toEqual('A');
+            expect(link.href).toEqual('tel:+79991234567');
+        }
+    );
+
+    it('should handle deep fields', () => {
+        const record = { id: 123, foo: { bar: '89991234567' } };
+        const { getByText } = render(
+            <PhoneField record={record} source="foo.bar" />
+        );
+        const link = getByText('+7 (999) 123-45-67') as HTMLAnchorElement;
+        expect(link.href).toEqual('tel:+79991234567');
+    });
+
+    it('should leave a non-russian phone as is', () => {
+        const record = { id: 123, phone: '+1 202 555 0143' };
+        const { getByText } = render(
+            <PhoneField record={record} source="phone" />
+        );
+        const link = getByText('+1 202 555 0143') as HTMLAnchorElement;
+        expect(link.href).toEqual('tel:+1 202 555 0143');
+    });
+
+    it('should use custom className', () => {
+        const { getByText } = render(
+            <PhoneField
+                record={{ id: 123, phone: '89991234567' }}
+                source="phone"
+                className="foo"
+            />
+        );
+        const link = getByText('+7 (999) 123-45-67');
+        expect(link.className).toContain('foo');
+    });
+
+    it.each([null, undefined])(
+        'should render the emptyText when value is %s',
+        phone => {
+            const { queryByText } = render(
+                <PhoneField
+                    record={{ id: 123, phone }}
+                    source="phone"
+                    emptyText="NA"
+                />
+            );
+            expect(queryByText('NA')).not.toBeNull();
+        }
+    );
+
+    it('should return null when the record has no value for the source and no emptyText', () => {
+        const { container } = render(
+            <PhoneField record={{ id: 123 }} source="phone" />
+        );
+        expect(container.firstChild).toBeNull();
+    });
+});
diff --git a/packages/ra-ui-materialui/src/field/PhoneField.tsx b/packages/ra-ui-materialui/src/field/PhoneField.tsx
