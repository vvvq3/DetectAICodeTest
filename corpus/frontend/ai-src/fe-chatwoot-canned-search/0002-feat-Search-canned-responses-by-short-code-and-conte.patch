+<script>
+import { getHighlightedSegments } from 'dashboard/helper/cannedResponseHelper';
+
+// Renders `text` with every case-insensitive occurrence of `searchKey`
+// wrapped in a <mark>. The text is rendered as text nodes, never as HTML.
+export default {
+  functional: true,
+  props: {
+    text: {
+      type: String,
+      default: '',
+    },
+    searchKey: {
+      type: String,
+      default: '',
+    },
+  },
+  render(h, { props, data }) {
+    const children = getHighlightedSegments(props.text, props.searchKey).map(
+      ({ text, isMatch }) => (isMatch ? h('mark', text) : text)
+    );
+    return h('span', data, children);
+  },
+};
+</script>
