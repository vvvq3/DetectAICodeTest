@@ -0,0 +1,298 @@
+import { createLocalVue, mount } from '@vue/test-utils';
+import Vuex from 'vuex';
+import VueI18n from 'vue-i18n';
+
+import i18n from 'dashboard/i18n';
+
+import CannedResponse from '../CannedResponse';
+
+const localVue = createLocalVue();
+localVue.use(Vuex);
+localVue.use(VueI18n);
+
+const i18nConfig = new VueI18n({
+  locale: 'en',
+  messages: i18n,
+});
+
+const KEY_CODES = {
+  ENTER: 13,
+  ESCAPE: 27,
+  UP: 38,
+  DOWN: 40,
+  N: 78,
+  P: 80,
+};
+
+const cannedResponses = [
+  { id: 1, short_code: 'hello', content: 'Hi there, how can I help you?' },
+  { id: 2, short_code: 'refund', content: 'Your refund has been processed.' },
+  { id: 3, short_code: 'bye', content: 'Thanks for reaching out. Goodbye!' },
+];
+
+// The dropdown listens to keydown events on the document, since the focus
+// stays in the reply box textarea while navigating.
+const pressKey = (keyCode, options = {}) => {
+  const event = new KeyboardEvent('keydown', { cancelable: true, ...options });
+  Object.defineProperty(event, 'keyCode', { value: keyCode });
+  document.dispatchEvent(event);
+  return event;
+};
+
+describe('CannedResponse', () => {
+  let getCannedResponse = null;
+  let wrapper = null;
+
+  const mountDropdown = ({
+    searchKey = '',
+    records = cannedResponses,
+    uiFlags = { fetchingList: false },
+  } = {}) => {
+    const store = new Vuex.Store({
+      getters: {
+        getCannedResponses: () => records,
+        getUIFlags: () => uiFlags,
+      },
+      actions: { getCannedResponse },
+    });
+
+    wrapper = mount(CannedResponse, {
+      store,
+      localVue,
+      i18n: i18nConfig,
+      propsData: { searchKey },
+    });
+    return wrapper;
+  };
+
+  const listItems = () => wrapper.findAll('li');
+  const activeItem = () => wrapper.find('li.active');
+
+  beforeEach(() => {
+    jest.useFakeTimers();
+    getCannedResponse = jest.fn();
+  });
+
+  afterEach(() => {
+    if (wrapper) {
+      wrapper.destroy();
+      wrapper = null;
+    }
+    jest.useRealTimers();
+  });
+
+  it('fetches the canned responses when mounted', () => {
+    mountDropdown();
+
+    expect(getCannedResponse).toHaveBeenCalledTimes(1);
+  });
+
+  it('lists all the canned responses if there is no search key', () => {
+    mountDropdown();
+
+    expect(listItems().length).toBe(3);
+    expect(activeItem().text()).toContain('hello');
+  });
+
+  describe('filtering', () => {
+    it('filters the canned responses by short code', () => {
+      mountDropdown({ searchKey: 'refund' });
+
+      expect(listItems().length).toBe(1);
+      expect(listItems().at(0).text()).toContain('Your refund');
+    });
+
+    it('filters the canned responses by content, ignoring the case', () => {
+      mountDropdown({ searchKey: 'GOODBYE' });
+
+      expect(listItems().length).toBe(1);
+      expect(listItems().at(0).text()).toContain('bye');
+    });
+
+    it('highlights the matching text in the short code and the content', () => {
+      mountDropdown({ searchKey: 'HEL' });
+
+      const highlights = listItems()
+        .at(0)
+        .findAll('mark');
+      expect(listItems().length).toBe(1);
+      expect(highlights.length).toBe(2);
+      expect(highlights.at(0).text()).toBe('hel');
+      expect(highlights.at(1).text()).toBe('hel');
+    });
+
+    it('does not highlight anything if there is no search key', () => {
+      mountDropdown();
+
+      expect(wrapper.find('mark').exists()).toBe(false);
+    });
+
+    it('debounces the search', async () => {
+      mountDropdown();
+
+      await wrapper.setProps({ searchKey: 'r' });
+      jest.advanceTimersByTime(100);
+      await wrapper.setProps({ searchKey: 'by' });
+      jest.advanceTimersByTime(100);
+      await wrapper.vm.$nextTick();
+
+      expect(listItems().length).toBe(3);
+
+      jest.advanceTimersByTime(50);
+      await wrapper.vm.$nextTick();
+
+      expect(listItems().length).toBe(1);
+      expect(listItems().at(0).text()).toContain('Thanks for reaching out');
+    });
+
+    it('selects the first result when the search changes', async () => {
+      mountDropdown();
+      pressKey(KEY_CODES.DOWN);
+      pressKey(KEY_CODES.DOWN);
+      await wrapper.vm.$nextTick();
+      expect(activeItem().text()).toContain('bye');
+
+      await wrapper.setProps({ searchKey: 'e' });
+      jest.runAllTimers();
+      await wrapper.vm.$nextTick();
+
+      expect(activeItem().text()).toContain('hello');
+    });
+  });
+
+  describe('empty state', () => {
+    it('shows a message if no canned response matches the search', () => {
+      mountDropdown({ searchKey: 'xyz' });
+
+      expect(wrapper.find('ul').exists()).toBe(false);
+      expect(wrapper.find('.canned--empty-state').text()).toBe(
+        'No canned responses matching "xyz"'
+      );
+    });
+
+    it('shows a message if there are no canned responses', () => {
+      mountDropdown({ records: [] });
+
+      expect(wrapper.find('.canned--empty-state').text()).toBe(
+        'There are no canned responses yet. You can add them from Settings > Canned Responses.'
+      );
+    });
+
+    it('shows a loading message while the canned responses are fetched', () => {
+      mountDropdown({ records: [], uiFlags: { fetchingList: true } });
+
+      expect(wrapper.find('.canned--empty-state').text()).toBe(
+        'Fetching canned responses...'
+      );
+    });
+  });
+
+  describe('keyboard navigation', () => {
+    it('moves the selection down and up with the arrow keys', async () => {
+      mountDropdown();
+
+      pressKey(KEY_CODES.DOWN);
+      await wrapper.vm.$nextTick();
+      expect(activeItem().text()).toContain('refund');
+
+      pressKey(KEY_CODES.UP);
+      await wrapper.vm.$nextTick();
+      expect(activeItem().text()).toContain('hello');
+    });
+
+    it('supports Ctrl-N and Ctrl-P', async () => {
+      mountDropdown();
+
+      pressKey(KEY_CODES.N, { ctrlKey: true });
+      await wrapper.vm.$nextTick();
+      expect(activeItem().text()).toContain('refund');
+
+      pressKey(KEY_CODES.P, { ctrlKey: true });
+      await wrapper.vm.$nextTick();
+      expect(activeItem().text()).toContain('hello');
+    });
+
+    it('wraps around at the beginning and the end of the list', async () => {
+      mountDropdown();
+
+      pressKey(KEY_CODES.UP);
+      await wrapper.vm.$nextTick();
+      expect(activeItem().text()).toContain('bye');
+
+      pressKey(KEY_CODES.DOWN);
+      await wrapper.vm.$nextTick();
+      expect(activeItem().text()).toContain('hello');
+    });
+
+    it('prevents the default action of the navigation keys', () => {
+      mountDropdown();
+
+      expect(pressKey(KEY_CODES.DOWN).defaultPrevented).toBe(true);
+      expect(pressKey(KEY_CODES.UP).defaultPrevented).toBe(true);
+      expect(pressKey(KEY_CODES.ENTER).defaultPrevented).toBe(true);
+      expect(pressKey(KEY_CODES.ESCAPE).defaultPrevented).toBe(true);
+    });
+
+    it('emits "select" with the content of the selected item on Enter', () => {
+      mountDropdown();
+
+      pressKey(KEY_CODES.DOWN);
+      pressKey(KEY_CODES.ENTER);
+
+      expect(wrapper.emitted().select).toEqual([
+        ['Your refund has been processed.'],
+      ]);
+    });
+
+    it('does not emit "select" on Enter if there are no results', () => {
+      mountDropdown({ searchKey: 'xyz' });
+
+      pressKey(KEY_CODES.DOWN);
+      pressKey(KEY_CODES.ENTER);
+
+      expect(wrapper.emitted().select).toBeUndefined();
+    });
+
+    it('emits "close" on Escape', () => {
+      mountDropdown();
+
+      pressKey(KEY_CODES.ESCAPE);
+
+      expect(wrapper.emitted().close).toHaveLength(1);
+    });
+
+    it('stops listening to the keyboard once destroyed', () => {
+      mountDropdown();
+      wrapper.destroy();
+
+      pressKey(KEY_CODES.ESCAPE);
+
+      expect(wrapper.emitted().close).toBeUndefined();
+      wrapper = null;
+    });
+  });
+
+  describe('mouse interaction', () => {
+    it('selects the item under the mouse', async () => {
+      mountDropdown();
+
+      await listItems()
+        .at(2)
+        .trigger('mouseover');
+
+      expect(activeItem().text()).toContain('bye');
+    });
+
+    it('emits "select" with the content of the clicked item', async () => {
+      mountDropdown();
+
+      await listItems()
+        .at(1)
+        .trigger('click');
+
+      expect(wrapper.emitted().select).toEqual([
+        ['Your refund has been processed.'],
+      ]);
+    });
+  });
+});
