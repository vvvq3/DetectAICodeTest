@@ -0,0 +1,50 @@
+// Relative imports, so that this module can be loaded by Jest (which doesn't know the webpack aliases)
+import { formatLabel } from '../../lib/utils'
+import { CSVCell } from '../../lib/utils/csv'
+
+// A single series as returned by the /api/insight/trend endpoint
+export interface TrendSeries {
+    label: string
+    action?: Record<string, any>
+    labels?: string[]
+    data?: (number | null)[]
+    count?: number
+    aggregated_value?: number
+}
+
+function seriesLabel(series: TrendSeries): string {
+    const label = series.action ? formatLabel(series.label, series.action) : series.label
+    // formatLabel pads its suffixes with spaces meant for on-screen display, collapse them for the file
+    return (label || '').replace(/\s+/g, ' ').trim()
+}
+
+function seriesTotal(series: TrendSeries): CSVCell {
+    // aggregated_value is what the table view displays (e.g. unique users over the whole range for DAU),
+    // it isn't always included, in which case fall back to the sum of the data points
+    if (typeof series.aggregated_value === 'number') {
+        return series.aggregated_value
+    }
+    if (typeof series.count === 'number') {
+        return series.count
+    }
+    return (series.data || []).reduce((total: number, value) => total + (value || 0), 0)
+}
+
+/**
+ * Turn trend results into CSV rows: a header with the interval labels as columns,
+ * then one row per series with its value for every interval and its total.
+ */
+export function trendResultsToCSVRows(results: TrendSeries[]): CSVCell[][] {
+    // All series of a query share the same intervals. Series without per-interval data
+    // (table and pie views only return totals) don't have labels, so skip those.
+    const labels = results.find((series) => series.labels && series.labels.length > 0)?.labels || []
+
+    return [
+        ['Series', ...labels, 'Total'],
+        ...results.map((series) => [
+            seriesLabel(series),
+            ...labels.map((_, index) => series.data?.[index]),
+            seriesTotal(series),
+        ]),
+    ]
+}
