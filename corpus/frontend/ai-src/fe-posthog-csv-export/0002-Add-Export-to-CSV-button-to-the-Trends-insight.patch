+import { trendResultsToCSVRows } from './trendsCSV'
+import { toCSV } from '../../lib/utils/csv'
+
+describe('trendResultsToCSVRows()', () => {
+    it('puts the interval labels in columns and one series per row with its total', () => {
+        expect(
+            trendResultsToCSVRows([
+                {
+                    label: '$pageview',
+                    action: { id: '$pageview', math: 'total' },
+                    labels: ['Mon. 7 December', 'Tue. 8 December', 'Wed. 9 December'],
+                    data: [10, 0, 5],
+                    count: 15,
+                },
+                {
+                    label: 'signed up',
+                    action: { id: 3, math: 'dau' },
+                    labels: ['Mon. 7 December', 'Tue. 8 December', 'Wed. 9 December'],
+                    data: [2, 1, 2],
+                    count: 5,
+                },
+            ])
+        ).toEqual([
+            ['Series', 'Mon. 7 December', 'Tue. 8 December', 'Wed. 9 December', 'Total'],
+            ['$pageview (Total)', 10, 0, 5, 15],
+            ['signed up (DAU)', 2, 1, 2, 5],
+        ])
+    })
+
+    it('prefers aggregated_value over count for the total', () => {
+        const [, row] = trendResultsToCSVRows([
+            {
+                label: 'signed up',
+                action: { id: 3, math: 'dau' },
+                labels: ['Mon. 7 December', 'Tue. 8 December'],
+                data: [2, 2],
+                count: 4,
+                aggregated_value: 3,
+            },
+        ])
+        expect(row).toEqual(['signed up (DAU)', 2, 2, 3])
+    })
+
+    it('sums the data points when no total is returned', () => {
+        const [, row] = trendResultsToCSVRows([{ label: 'new', labels: ['a', 'b'], data: [1, 4] }])
+        expect(row).toEqual(['new', 1, 4, 5])
+    })
+
+    it('only exports totals for results without intervals (table and pie views)', () => {
+        expect(
+            trendResultsToCSVRows([
+                {
+                    label: '$pageview',
+                    action: { math: 'total' },
+                    labels: [],
+                    data: [],
+                    count: 0,
+                    aggregated_value: 120,
+                },
+                {
+                    label: '$autocapture',
+                    action: { math: 'total' },
+                    labels: [],
+                    data: [],
+                    count: 0,
+                    aggregated_value: 7,
+                },
+            ])
+        ).toEqual([
+            ['Series', 'Total'],
+            ['$pageview (Total)', 120],
+            ['$autocapture (Total)', 7],
+        ])
+    })
+
+    it('keeps breakdown and property filter details in a tidy label', () => {
+        const [, row] = trendResultsToCSVRows([
+            {
+                label: '$pageview - Chrome',
+                action: { math: 'total', properties: [{ key: '$os', value: 'Mac OS X' }] },
+                labels: ['Mon. 7 December'],
+                data: [3],
+                count: 3,
+            },
+        ])
+        expect(row[0]).toEqual('$pageview - Chrome (Total) (= Mac OS X)')
+    })
+
+    it('leaves cells empty when a series is shorter than the labels', () => {
+        const [, , row] = trendResultsToCSVRows([
+            { label: 'a', labels: ['x', 'y'], data: [1, 2], count: 3 },
+            { label: 'b', labels: [], data: [1], count: 1 },
+        ])
+        expect(row).toEqual(['b', 1, undefined, 1])
+    })
+
+    it('returns just the header for no results', () => {
+        expect(trendResultsToCSVRows([])).toEqual([['Series', 'Total']])
+    })
+
+    it('produces a properly escaped CSV', () => {
+        const rows = trendResultsToCSVRows([
+            {
+                label: '=cmd - "quoted", value',
+                labels: ['Mon. 7 December, 14:00', 'Mon. 7 December, 15:00'],
+                data: [1, -2],
+                count: -1,
+            },
+        ])
+        expect(toCSV(rows)).toEqual(
+            'Series,"Mon. 7 December, 14:00","Mon. 7 December, 15:00",Total\r\n' +
+                '"\'=cmd - ""quoted"", value",1,-2,-1'
+        )
+    })
+})
