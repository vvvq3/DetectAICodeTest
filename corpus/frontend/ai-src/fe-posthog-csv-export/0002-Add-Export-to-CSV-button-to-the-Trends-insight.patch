+import React from 'react'
+import { useValues } from 'kea'
+import { Button } from 'antd'
+import { DownloadOutlined } from '@ant-design/icons'
+import moment from 'moment'
+import { downloadCSV } from 'lib/utils/csv'
+import { trendsLogic } from './trendsLogic'
+import { trendResultsToCSVRows } from './trendsCSV'
+
+export function ExportTrendsCSVButton({ view }: { view: string }): JSX.Element {
+    const { results, resultsLoading } = useValues(trendsLogic({ dashboardItemId: null, view }))
+
+    function exportCSV(): void {
+        downloadCSV(trendResultsToCSVRows(results), `trends-${moment().format('YYYY-MM-DD')}.csv`)
+    }
+
+    return (
+        <Button
+            icon={<DownloadOutlined />}
+            onClick={exportCSV}
+            disabled={resultsLoading || !results?.length}
+            style={{ marginRight: 6 }}
+            data-attr="trends-export-csv-button"
+        >
+            Export to CSV
+        </Button>
+    )
+}
