@@ -0,0 +1,60 @@
+export type CSVCell = string | number | boolean | null | undefined
+
+const CSV_SEPARATOR = ','
+// RFC 4180 specifies CRLF as the record separator
+const CSV_LINE_BREAK = '\r\n'
+// Byte order mark, so that Excel opens the file as UTF-8 instead of guessing the encoding
+const UTF8_BOM = '﻿'
+
+// Characters that make a value need quoting
+const NEEDS_QUOTING = /[",\r\n]|^\s|\s$/
+// Spreadsheet apps interpret cells starting with these characters as formulas (CSV injection)
+const FORMULA_TRIGGER = /^[=+\-@\t\r]/
+
+/**
+ * Escape a single value for use as a CSV cell.
+ *
+ * - `null` and `undefined` become empty cells
+ * - values containing separators, quotes, line breaks or leading/trailing whitespace are wrapped
+ *   in double quotes, with inner double quotes doubled (RFC 4180)
+ * - strings that a spreadsheet would evaluate as a formula (starting with `=`, `+`, `-`, `@`, tab or
+ *   carriage return) are prefixed with a single quote, so that exported user data can't run formulas.
+ *   Numbers are left untouched, so negative values stay numeric.
+ */
+export function escapeCSVValue(value: CSVCell): string {
+    if (value === null || value === undefined) {
+        return ''
+    }
+
+    let stringValue = String(value)
+    if (typeof value === 'string' && FORMULA_TRIGGER.test(stringValue)) {
+        stringValue = `'${stringValue}`
+    }
+
+    if (NEEDS_QUOTING.test(stringValue)) {
+        return `"${stringValue.replace(/"/g, '""')}"`
+    }
+    return stringValue
+}
+
+/** Convert a list of rows (the first one usually being the header) into a CSV string. */
+export function toCSV(rows: CSVCell[][]): string {
+    return rows.map((row) => row.map(escapeCSVValue).join(CSV_SEPARATOR)).join(CSV_LINE_BREAK)
+}
+
+/** Convert rows to CSV and make the browser download them as a file. */
+export function downloadCSV(rows: CSVCell[][], filename: string): void {
+    const blob = new Blob([UTF8_BOM + toCSV(rows)], { type: 'text/csv;charset=utf-8' })
+    const url = URL.createObjectURL(blob)
+
+    const link = document.createElement('a')
+    link.href = url
+    link.download = filename.toLowerCase().endsWith('.csv') ? filename : `${filename}.csv`
+    link.style.display = 'none'
+    document.body.appendChild(link)
+    link.click()
+    document.body.removeChild(link)
+
+    // Some browsers abort the download if the URL is revoked synchronously after the click
+    setTimeout(() => URL.revokeObjectURL(url), 100)
+}
