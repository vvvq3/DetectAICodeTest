--- /dev/null
+++ b/frontend/src/lib/utils/csv.test.ts
@@ -0,0 +1,148 @@
+import { escapeCSVValue, toCSV, downloadCSV } from './csv'
+
+describe('escapeCSVValue()', () => {
+    it('leaves simple values as they are', () => {
+        expect(escapeCSVValue('pageview')).toEqual('pageview')
+        expect(escapeCSVValue('Thu. 5 November')).toEqual('Thu. 5 November')
+        expect(escapeCSVValue(42)).toEqual('42')
+        expect(escapeCSVValue(3.14)).toEqual('3.14')
+        expect(escapeCSVValue(0)).toEqual('0')
+        expect(escapeCSVValue(true)).toEqual('true')
+        expect(escapeCSVValue(false)).toEqual('false')
+        expect(escapeCSVValue('')).toEqual('')
+    })
+
+    it('turns null and undefined into empty cells', () => {
+        expect(escapeCSVValue(null)).toEqual('')
+        expect(escapeCSVValue(undefined)).toEqual('')
+    })
+
+    it('quotes values containing the separator', () => {
+        expect(escapeCSVValue('Thu. 5 November, 14:00')).toEqual('"Thu. 5 November, 14:00"')
+        expect(escapeCSVValue(',')).toEqual('","')
+    })
+
+    it('doubles quotes and wraps the value in quotes', () => {
+        expect(escapeCSVValue('say "hi"')).toEqual('"say ""hi"""')
+        expect(escapeCSVValue('"')).toEqual('""""')
+    })
+
+    it('quotes values containing line breaks', () => {
+        expect(escapeCSVValue('line 1\nline 2')).toEqual('"line 1\nline 2"')
+        expect(escapeCSVValue('line 1\r\nline 2')).toEqual('"line 1\r\nline 2"')
+    })
+
+    it('quotes values with leading or trailing whitespace so it is preserved', () => {
+        expect(escapeCSVValue(' padded')).toEqual('" padded"')
+        expect(escapeCSVValue('padded ')).toEqual('"padded "')
+        expect(escapeCSVValue('in between')).toEqual('in between')
+    })
+
+    it('neutralizes strings that spreadsheets would run as formulas', () => {
+        expect(escapeCSVValue('=1+1')).toEqual("'=1+1")
+        expect(escapeCSVValue('+1')).toEqual("'+1")
+        expect(escapeCSVValue('-1')).toEqual("'-1")
+        expect(escapeCSVValue('@SUM(A1)')).toEqual("'@SUM(A1)")
+        expect(escapeCSVValue('\t=1+1')).toEqual("'\t=1+1")
+        expect(escapeCSVValue('=HYPERLINK("http://example.com","click")')).toEqual(
+            '"\'=HYPERLINK(""http://example.com"",""click"")"'
+        )
+    })
+
+    it('does not touch formula characters later in the string', () => {
+        expect(escapeCSVValue('a=b')).toEqual('a=b')
+        expect(escapeCSVValue('user@example.com')).toEqual('user@example.com')
+    })
+
+    it('keeps negative numbers numeric', () => {
+        expect(escapeCSVValue(-5)).toEqual('-5')
+        expect(escapeCSVValue(-0.5)).toEqual('-0.5')
+    })
+})
+
+describe('toCSV()', () => {
+    it('joins cells with commas and rows with CRLF', () => {
+        expect(
+            toCSV([
+                ['Series', 'Mon', 'Tue', 'Total'],
+                ['pageview', 1, 2, 3],
+                ['signup', 0, 5, 5],
+            ])
+        ).toEqual('Series,Mon,Tue,Total\r\npageview,1,2,3\r\nsignup,0,5,5')
+    })
+
+    it('escapes every cell', () => {
+        expect(
+            toCSV([
+                ['Series', 'Mon, 14:00'],
+                ['say "hi"', null],
+            ])
+        ).toEqual('Series,"Mon, 14:00"\r\n"say ""hi""",')
+    })
+
+    it('keeps empty cells and rows', () => {
+        expect(toCSV([['a', '', undefined, 'b'], []])).toEqual('a,,,b\r\n')
+    })
+
+    it('returns an empty string for no rows', () => {
+        expect(toCSV([])).toEqual('')
+    })
+})
+
+describe('downloadCSV()', () => {
+    const originalCreateObjectURL = URL.createObjectURL
+    const originalRevokeObjectURL = URL.revokeObjectURL
+    let clickedLinks: HTMLAnchorElement[]
+
+    beforeEach(() => {
+        jest.useFakeTimers()
+        clickedLinks = []
+        // jsdom implements neither of these
+        URL.createObjectURL = jest.fn(() => 'blob:csv-download')
+        URL.revokeObjectURL = jest.fn()
+        jest.spyOn(HTMLAnchorElement.prototype, 'click').mockImplementation(function (this: HTMLAnchorElement) {
+            clickedLinks.push(this)
+        })
+    })
+
+    afterEach(() => {
+        jest.useRealTimers()
+        jest.restoreAllMocks()
+        URL.createObjectURL = originalCreateObjectURL
+        URL.revokeObjectURL = originalRevokeObjectURL
+    })
+
+    const rows = [
+        ['Series', 'Mon', 'Total'],
+        ['pageview', 1, 1],
+    ]
+
+    it('downloads the rows as a UTF-8 CSV file', () => {
+        downloadCSV(rows, 'trends.csv')
+
+        expect(URL.createObjectURL).toHaveBeenCalledTimes(1)
+        const blob = (URL.createObjectURL as jest.Mock).mock.calls[0][0] as Blob
+        expect(blob.type).toEqual('text/csv;charset=utf-8')
+        // 3 bytes of UTF-8 byte order mark + the (ASCII-only) CSV content
+        expect(blob.size).toEqual(3 + toCSV(rows).length)
+
+        expect(clickedLinks).toHaveLength(1)
+        expect(clickedLinks[0].getAttribute('href')).toEqual('blob:csv-download')
+        expect(clickedLinks[0].getAttribute('download')).toEqual('trends.csv')
+    })
+
+    it('adds the .csv extension when missing', () => {
+        downloadCSV(rows, 'trends')
+        expect(clickedLinks[0].getAttribute('download')).toEqual('trends.csv')
+    })
+
+    it('cleans up the link and the object URL', () => {
+        downloadCSV(rows, 'trends.csv')
+
+        expect(clickedLinks).toHaveLength(1)
+        expect(document.body.contains(clickedLinks[0])).toEqual(false)
+        expect(URL.revokeObjectURL).not.toHaveBeenCalled()
+        jest.runAllTimers()
+        expect(URL.revokeObjectURL).toHaveBeenCalledWith('blob:csv-download')
+    })
+})
