new file mode 100644
index 000000000..43d814d91
--- /dev/null
+++ b/packages/ra-ui-materialui/src/button/CopyToClipboardButton.tsx
@@ -0,0 +1,181 @@
+import * as React from 'react';
+import { FC, ReactElement, MouseEvent, useCallback, useContext } from 'react';
+import PropTypes from 'prop-types';
+import get from 'lodash/get';
+import ContentCopy from '@material-ui/icons/FileCopy';
+import { Record, RecordContext, useNotify } from 'ra-core';
+
+import Button, { ButtonProps } from './Button';
+
+/**
+ * Copies the value of a field of the current record to the clipboard,
+ * and notifies the user of the result.
+ *
+ * The record is read from the props (as injected by <Datagrid>,
+ * <SimpleShowLayout> or <TabbedShowLayout>), or from the RecordContext
+ * (e.g. when used in the actions of a <Show> view).
+ *
+ * @example // in a Show view
+ * <SimpleShowLayout>
+ *     <TextField source="email" />
+ *     <CopyToClipboardButton source="email" />
+ * </SimpleShowLayout>
+ *
+ * @example // in a List view, with a custom label and icon
+ * <Datagrid>
+ *     <TextField source="reference" />
+ *     <CopyToClipboardButton
+ *         source="reference"
+ *         label="Copy reference"
+ *         icon={<LinkIcon />}
+ *     />
+ * </Datagrid>
+ */
+const CopyToClipboardButton: FC<CopyToClipboardButtonProps> = props => {
+    const {
+        source,
+        record: recordFromProps,
+        label = 'ra.action.copy',
+        icon = defaultIcon,
+        disabled,
+        onClick,
+        ...rest
+    } = props;
+    const recordContext = useContext(RecordContext);
+    // The record injected by the parent takes precedence over the context,
+    // so that a button in a <Datagrid> rendered inside a <Show> view
+    // (e.g. in a <ReferenceManyField>) copies the value of its own row
+    const record =
+        recordFromProps || (recordContext ? recordContext.record : undefined);
+    const text = toClipboardText(get(record, source));
+    const notify = useNotify();
+
+    const handleClick = useCallback(
+        event => {
+            // useful to prevent click bubbling in a datagrid with rowClick
+            event.stopPropagation();
+            copyToClipboard(text).then(
+                () =>
+                    notify('ra.notification.copied_to_clipboard', 'info', {
+                        _: 'Copied to clipboard',
+                    }),
+                () =>
+                    notify(
+                        'ra.notification.copy_to_clipboard_error',
+                        'warning',
+                        {
+                            _: 'Unable to copy to clipboard',
+                        }
+                    )
+            );
+            if (typeof onClick === 'function') {
+                onClick(event);
+            }
+        },
+        [notify, onClick, text]
+    );
+
+    return (
+        <Button
+            label={label}
+            onClick={handleClick}
+            disabled={disabled || text === null}
+            {...sanitizeRestProps(rest)}
+        >
+            {icon}
+        </Button>
+    );
+};
+
+const defaultIcon = <ContentCopy />;
+
+/**
+ * Converts a record value to the text copied to the clipboard,
+ * or null if there is nothing to copy.
+ */
+const toClipboardText = (value: any): string | null => {
+    if (value == null || value === '') {
+        return null;
+    }
+    return typeof value === 'object' ? JSON.stringify(value) : String(value);
+};
+
+/**
+ * Writes a text to the clipboard.
+ *
+ * The asynchronous Clipboard API is only available in secure contexts
+ * (pages served over https or from localhost), so this falls back to the
+ * legacy document.execCommand('copy') when it's missing.
+ */
+const copyToClipboard =(text: string): Promise<void> => {
+    if (navigator.clipboard && navigator.clipboard.writeText) {
+        return navigator.clipboard.writeText(text);
+    }
+
+    return new Promise((resolve, reject) => {
+        const textarea = document.createElement('textarea');
+        textarea.value = text;
+        textarea.setAttribute('readonly', '');
+        textarea.style.position = 'fixed';
+        textarea.style.top = '-1000px';
+        document.body.appendChild(textarea);
+        textarea.select();
+        try {
+            if (document.execCommand('copy')) {
+                resolve();
+            } else {
+                reject(new Error('The copy command was rejected'));
+            }
+        } catch (error) {
+            reject(error);
+        } finally {
+            document.body.removeChild(textarea);
+        }
+    });
+};
+
+// Remove the props read by <Datagrid> and <SimpleShowLayout> to render
+// the column header or the label, as they aren't valid DOM attributes
+const sanitizeRestProps = ({
+    addLabel,
+    cellClassName,
+    headerClassName,
+    sortable,
+    sortBy,
+    sortByOrder,
+    textAlign,
+    ...rest
+}: any) => rest;
+
+interface Props {
+    source: string;
+    record?: Record;
+    label?: string;
+    icon?: ReactElement;
+    onClick?: (e: MouseEvent) => void;
+    // Read by <Datagrid> and <SimpleShowLayout>
+    addLabel?: boolean;
+    cellClassName?: string;
+    headerClassName?: string;
+    sortable?: boolean;
+    sortBy?: string;
+    sortByOrder?: 'ASC' | 'DESC';
+    textAlign?: 'left' | 'right';
+}
+
+export type CopyToClipboardButtonProps = Props & ButtonProps;
+
+CopyToClipboardButton.propTypes = {
+    source: PropTypes.string.isRequired,
+    record: PropTypes.any,
+    label: PropTypes.string,
+    icon: PropTypes.element,
+    onClick: PropTypes.func,
+};
+
+CopyToClipboardButton.defaultProps = {
+    // a column of copy buttons in a <Datagrid> shouldn't be sortable
+    sortable: false,
+};
+
+export default CopyToClipboardButton;
