diff --git a/packages/ra-ui-materialui/src/button/CopyToClipboardButton.spec.tsx b/packages/ra-ui-materialui/src/button/CopyToClipboardButton.spec.tsx
new file mode 100644
index 000000000..fd7783095
--- /dev/null
+++ b/packages/ra-ui-materialui/src/button/CopyToClipboardButton.spec.tsx
@@ -0,0 +1,293 @@
+import * as React from 'react';
+import expect from 'expect';
+import { cleanup, fireEvent, wait } from '@testing-library/react';
+import { ThemeProvider } from '@material-ui/core';
+import { createMuiTheme } from '@material-ui/core/styles';
+import LinkIcon from '@material-ui/icons/Link';
+import { DataProvider, DataProviderContext, renderWithRedux } from 'ra-core';
+
+import CopyToClipboardButton from './CopyToClipboardButton';
+import { Show, SimpleShowLayout } from '../detail';
+import { TextField } from '../field';
+import TopToolbar from '../layout/TopToolbar';
+
+const theme = createMuiTheme();
+
+const renderButton = (element: React.ReactElement, initialState = {}) =>
+    renderWithRedux(
+        <ThemeProvider theme={theme}>{element}</ThemeProvider>,
+        initialState
+    );
+
+const successNotification = {
+    type: 'RA/SHOW_NOTIFICATION',
+    payload: {
+        type: 'info',
+        message: 'ra.notification.copied_to_clipboard',
+        messageArgs: { _: 'Copied to clipboard' },
+        undoable: false,
+    },
+};
+
+const errorNotification = {
+    type: 'RA/SHOW_NOTIFICATION',
+    payload: {
+        type: 'warning',
+        message: 'ra.notification.copy_to_clipboard_error',
+        messageArgs: { _: 'Unable to copy to clipboard' },
+        undoable: false,
+    },
+};
+
+describe('<CopyToClipboardButton />', () => {
+    let writeText: jest.Mock;
+
+    beforeEach(() => {
+        writeText = jest.fn().mockResolvedValue(undefined);
+        Object.defineProperty(navigator, 'clipboard', {
+            value: { writeText },
+            configurable: true,
+        });
+    });
+
+    afterEach(() => {
+        cleanup();
+        delete (navigator as any).clipboard;
+        delete (document as any).execCommand;
+    });
+
+    it('should render a button with no DOM errors', () => {
+        const spy = jest.spyOn(console, 'error').mockImplementation(() => {});
+
+        const { getByLabelText } = renderButton(
+            <CopyToClipboardButton
+                source="title"
+                record={{ id: 123, title: 'lorem' }}
+                basePath="/posts"
+                resource="posts"
+                // props read by <Datagrid> and <SimpleShowLayout>
+                addLabel={false}
+                cellClassName="cell"
+                headerClassName="header"
+                sortable={false}
+                sortBy="title"
+                textAlign="right"
+            />
+        );
+
+        expect(spy).not.toHaveBeenCalled();
+        expect(getByLabelText('ra.action.copy').getAttribute('type')).toEqual(
+            'button'
+        );
+
+        spy.mockRestore();
+    });
+
+    it('should copy the value of the record field and notify the user', async () => {
+        const { getByLabelText, dispatch } = renderButton(
+            <CopyToClipboardButton
+                source="author.email"
+                record={{ id: 123, author: { email: 'jane@example.com' } }}
+            />
+        );
+
+        fireEvent.click(getByLabelText('ra.action.copy'));
+
+        expect(writeText).toHaveBeenCalledWith('jane@example.com');
+        await wait(() => {
+            expect(dispatch).toHaveBeenCalledWith(successNotification);
+        });
+    });
+
+    it('should copy non-string values as text', () => {
+        const { getAllByLabelText } = renderButton(
+            <>
+                <CopyToClipboardButton
+                    source="views"
+                    record={{ id: 123, views: 0 }}
+                />
+                <CopyToClipboardButton
+                    source="tags"
+                    record={{ id: 123, tags: ['foo', 'bar'] }}
+                />
+            </>
+        );
+        const [viewsButton, tagsButton] = getAllByLabelText('ra.action.copy');
+
+        fireEvent.click(viewsButton);
+        expect(writeText).toHaveBeenLastCalledWith('0');
+
+        fireEvent.click(tagsButton);
+        expect(writeText).toHaveBeenLastCalledWith('["foo","bar"]');
+    });
+
+    it('should notify the user when the copy fails', async () => {
+        writeText.mockRejectedValueOnce(new Error('Write permission denied'));
+        const { getByLabelText, dispatch } = renderButton(
+            <CopyToClipboardButton
+                source="title"
+                record={{ id: 123, title: 'lorem' }}
+            />
+        );
+
+        fireEvent.click(getByLabelText('ra.action.copy'));
+
+        await wait(() => {
+            expect(dispatch).toHaveBeenCalledWith(errorNotification);
+        });
+        expect(dispatch).not.toHaveBeenCalledWith(successNotification);
+    });
+
+    it('should be disabled when there is nothing to copy', () => {
+        const { getAllByLabelText } = renderButton(
+            <>
+                <CopyToClipboardButton source="title" />
+                <CopyToClipboardButton
+                    source="title"
+                    record={{ id: 123, title: '' }}
+                />
+                <CopyToClipboardButton
+                    source="title"
+                    record={{ id: 123, title: null }}
+                />
+            </>
+        );
+
+        getAllByLabelText('ra.action.copy').forEach(button => {
+            expect(button.hasAttribute('disabled')).toBe(true);
+            fireEvent.click(button);
+        });
+        expect(writeText).not.toHaveBeenCalled();
+    });
+
+    it('should accept a custom label and icon', () => {
+        const { getByLabelText, getByTestId } = renderButton(
+            <CopyToClipboardButton
+                source="email"
+                record={{ id: 123, email: 'jane@example.com' }}
+                label="Copy email"
+                icon={<LinkIcon data-testid="custom-icon" />}
+            />
+        );
+
+        const button = getByLabelText('Copy email');
+        expect(button.textContent).toEqual('Copy email');
+        expect(button.contains(getByTestId('custom-icon'))).toBe(true);
+    });
+
+    it('should call onClick without propagating the click', () => {
+        const onClick = jest.fn();
+        const onParentClick = jest.fn();
+        const { getByLabelText } = renderButton(
+            <div onClick={onParentClick}>
+                <CopyToClipboardButton
+                    source="title"
+                    record={{ id: 123, title: 'lorem' }}
+                    onClick={onClick}
+                />
+            </div>
+        );
+
+        fireEvent.click(getByLabelText('ra.action.copy'));
+
+        expect(writeText).toHaveBeenCalledWith('lorem');
+        expect(onClick).toHaveBeenCalled();
+        expect(onParentClick).not.toHaveBeenCalled();
+    });
+
+    it('should fall back to execCommand when the Clipboard API is not available', async () => {
+        delete (navigator as any).clipboard;
+        let copiedText;
+        const execCommand = jest.fn(() => {
+            copiedText = document.querySelector('textarea').value;
+            return true;
+        });
+        Object.defineProperty(document, 'execCommand', {
+            value: execCommand,
+            configurable: true,
+        });
+
+        const { getByLabelText, dispatch } = renderButton(
+            <CopyToClipboardButton
+                source="title"
+                record={{ id: 123, title: 'lorem' }}
+            />
+        );
+
+        fireEvent.click(getByLabelText('ra.action.copy'));
+
+        expect(execCommand).toHaveBeenCalledWith('copy');
+        expect(copiedText).toEqual('lorem');
+        expect(document.querySelector('textarea')).toBeNull();
+        await wait(() => {
+            expect(dispatch).toHaveBeenCalledWith(successNotification);
+        });
+    });
+
+    describe('in a Show view', () => {
+        const defaultShowProps = {
+            basePath: '/posts',
+            id: '123',
+            resource: 'posts',
+            location: {},
+            match: {},
+        };
+
+        const dataProvider = ({
+            getOne: () =>
+                Promise.resolve({ data: { id: 123, title: 'lorem' } }),
+        } as unknown) as DataProvider;
+
+        const renderShow = (actions: React.ReactElement) =>
+            renderButton(
+                <DataProviderContext.Provider value={dataProvider}>
+                    <Show {...defaultShowProps} actions={actions}>
+                        <SimpleShowLayout>
+                            <TextField source="title" />
+                        </SimpleShowLayout>
+                    </Show>
+                </DataProviderContext.Provider>,
+                { admin: { resources: { posts: { data: {} } } } }
+            );
+
+        it('should read the record from the context', async () => {
+            const ShowActions = () => (
+                <TopToolbar>
+                    <CopyToClipboardButton source="title" />
+                </TopToolbar>
+            );
+            const { getByLabelText, queryByText } = renderShow(
+                <ShowActions />
+            );
+            // wait for the dataProvider.getOne() return
+            await wait(() => {
+                expect(queryByText('lorem')).not.toBeNull();
+            });
+
+            fireEvent.click(getByLabelText('ra.action.copy'));
+
+            expect(writeText).toHaveBeenCalledWith('lorem');
+        });
+
+        it('should give precedence to the record prop over the context', async () => {
+            const ShowActions = () => (
+                <TopToolbar>
+                    <CopyToClipboardButton
+                        source="title"
+                        record={{ id: 456, title: 'ipsum' }}
+                    />
+                </TopToolbar>
+            );
+            const { getByLabelText, queryByText } = renderShow(
+                <ShowActions />
+            );
+            await wait(() => {
+                expect(queryByText('lorem')).not.toBeNull();
+            });
+
+            fireEvent.click(getByLabelText('ra.action.copy'));
+
+            expect(writeText).toHaveBeenCalledWith('ipsum');
+        });
+    });
+});
