diff --git a/helpers/__tests__/historySearch.spec.js b/helpers/__tests__/historySearch.spec.js
new file mode 100644
index 000000000..09fe843d8
--- /dev/null
+++ b/helpers/__tests__/historySearch.spec.js
@@ -0,0 +1,104 @@
+import {
+  parseQuery,
+  matchesEntry,
+  filterHistory,
+  highlightSegments,
+  highlightTerms,
+} from "../historySearch"
+
+const history = [
+  { method: "GET", url: "https://api.example.com", path: "/users", status: 200 },
+  { method: "POST", url: "https://api.example.com", path: "/users", status: 201 },
+  { method: "POST", url: "https://api.example.com", path: "/login", status: 404 },
+  { method: "DELETE", url: "https://other.dev", path: "/items/404", status: 500 },
+]
+
+describe("parseQuery", () => {
+  test("splits free terms and filters", () => {
+    expect(parseQuery("  Users method:POST status:404 ")).toEqual({
+      terms: ["users"],
+      method: ["post"],
+      status: ["404"],
+    })
+  })
+
+  test("ignores filters without a value and handles empty input", () => {
+    expect(parseQuery("method:")).toEqual({ terms: [], method: [], status: [] })
+    expect(parseQuery(undefined)).toEqual({ terms: [], method: [], status: [] })
+  })
+
+  test("unknown keys are treated as free text", () => {
+    expect(parseQuery("foo:bar").terms).toEqual(["foo:bar"])
+  })
+})
+
+describe("filterHistory", () => {
+  test("returns everything for an empty query", () => {
+    expect(filterHistory(history, "")).toHaveLength(4)
+    expect(filterHistory(history, "   ")).toHaveLength(4)
+  })
+
+  test("matches URL, method and status as free text", () => {
+    expect(filterHistory(history, "login")).toEqual([history[2]])
+    expect(filterHistory(history, "OTHER.dev")).toEqual([history[3]])
+    expect(filterHistory(history, "delete")).toEqual([history[3]])
+    expect(filterHistory(history, "201")).toEqual([history[1]])
+  })
+
+  test("method filter is exact and case-insensitive", () => {
+    expect(filterHistory(history, "method:post")).toEqual([history[1], history[2]])
+    expect(filterHistory(history, "method:PO")).toEqual([])
+  })
+
+  test("status filter supports exact codes and classes", () => {
+    expect(filterHistory(history, "status:404")).toEqual([history[2]])
+    expect(filterHistory(history, "status:2xx")).toEqual([history[0], history[1]])
+  })
+
+  test("status filter does not match the URL", () => {
+    expect(filterHistory(history, "status:404")).not.toContain(history[3])
+  })
+
+  test("combines terms with AND", () => {
+    expect(filterHistory(history, "users method:POST")).toEqual([history[1]])
+    expect(filterHistory(history, "users status:404")).toEqual([])
+  })
+
+  test("tolerates entries with missing fields", () => {
+    expect(filterHistory([{ method: "GET" }], "method:get")).toHaveLength(1)
+    expect(matchesEntry({}, parseQuery("x"))).toBe(false)
+  })
+})
+
+describe("highlightSegments", () => {
+  test("marks matches case-insensitively", () => {
+    expect(highlightSegments("/Users/users", ["user"])).toEqual([
+      { text: "/", match: false },
+      { text: "User", match: true },
+      { text: "s/", match: false },
+      { text: "user", match: true },
+      { text: "s", match: false },
+    ])
+  })
+
+  test("merges overlapping matches", () => {
+    expect(highlightSegments("abcd", ["ab", "bc"])).toEqual([
+      { text: "abc", match: true },
+      { text: "d", match: false },
+    ])
+  })
+
+  test("returns a single plain segment without terms", () => {
+    expect(highlightSegments("abc", [])).toEqual([{ text: "abc", match: false }])
+    expect(highlightSegments("", ["a"])).toEqual([])
+  })
+})
+
+describe("highlightTerms", () => {
+  test("includes filter values for the matching field only", () => {
+    const parsed = parseQuery("users method:post status:2xx")
+    expect(highlightTerms(parsed, "method")).toEqual(["users", "post"])
+    expect(highlightTerms(parsed, "status")).toEqual(["users"])
+    expect(highlightTerms(parsed, "url")).toEqual(["users"])
+  })
+})
diff --git a/helpers/historySearch.js b/helpers/historySearch.js
new file mode 100644
index 000000000..e6899b6d6
--- /dev/null
+++ b/helpers/historySearch.js
@@ -0,0 +1,94 @@
+// Search helpers for the History panel.
+// Supported syntax: free text terms (matched against URL, method and status code)
+// and `method:POST` / `status:404` (also `status:4xx`) filters. All terms must match.
+
+const FILTER_KEYS = ["method", "status"]
+
+export function parseQuery(query) {
+  const parsed = { terms: [], method: [], status: [] }
+  String(query || "")
+    .trim()
+    .split(/\s+/)
+    .filter(Boolean)
+    .forEach((token) => {
+      const sep = token.indexOf(":")
+      const key = sep > 0 ? token.slice(0, sep).toLowerCase() : ""
+      const value = sep > 0 ? token.slice(sep + 1).toLowerCase() : ""
+      if (FILTER_KEYS.includes(key)) {
+        // `method:` with no value yet (user is still typing) is ignored
+        if (value) parsed[key].push(value)
+      } else {
+        parsed.terms.push(token.toLowerCase())
+      }
+    })
+  return parsed
+}
+
+const entryUrl = (entry) => `${entry.url || ""}${entry.path || ""}`
+
+const statusMatches = (status, wanted) => {
+  const code = String(status)
+  if (/^[1-5]xx$/.test(wanted)) return code.startsWith(wanted[0])
+  return code === wanted
+}
+
+export function matchesEntry(entry, parsed) {
+  const url = entryUrl(entry).toLowerCase()
+  const method = String(entry.method || "").toLowerCase()
+  const status = String(entry.status === undefined || entry.status === null ? "" : entry.status)
+
+  return (
+    parsed.method.every((m) => method === m) &&
+    parsed.status.every((s) => statusMatches(status, s)) &&
+    parsed.terms.every((t) => url.includes(t) || method.includes(t) || status.includes(t))
+  )
+}
+
+export function filterHistory(history, query) {
+  const parsed = parseQuery(query)
+  if (!parsed.terms.length && !parsed.method.length && !parsed.status.length) return history
+  return history.filter((entry) => matchesEntry(entry, parsed))
+}
+
+// Splits `text` into [{ text, match }] segments so a template can highlight matches
+// without using v-html.
+export function highlightSegments(text, terms) {
+  text = String(text === undefined || text === null ? "" : text)
+  const lower = text.toLowerCase()
+  const ranges = []
+  terms
+    .filter(Boolean)
+    .map((t) => t.toLowerCase())
+    .forEach((term) => {
+      let from = 0
+      let at
+      while ((at = lower.indexOf(term, from)) !== -1) {
+        ranges.push([at, at + term.length])
+        from = at + term.length
+      }
+    })
+  ranges.sort((a, b) => a[0] - b[0])
+
+  const merged = []
+  ranges.forEach(([start, end]) => {
+    const last = merged[merged.length - 1]
+    if (last && start <= last[1]) last[1] = Math.max(last[1], end)
+    else merged.push([start, end])
+  })
+
+  const segments = []
+  let pos = 0
+  merged.forEach(([start, end]) => {
+    if (start > pos) segments.push({ text: text.slice(pos, start), match: false })
+    segments.push({ text: text.slice(start, end), match: true })
+    pos = end
+  })
+  if (pos < text.length) segments.push({ text: text.slice(pos), match: false })
+  return segments
+}
+
+// Terms to highlight for a given field: free text plus the matching filter values.
+export function highlightTerms(parsed, field) {
+  const own = field === "method" ? parsed.method : field === "status" ? parsed.status : []
+  return [...parsed.terms, ...own.filter((v) => !/^[1-5]xx$/.test(v))]
+}
