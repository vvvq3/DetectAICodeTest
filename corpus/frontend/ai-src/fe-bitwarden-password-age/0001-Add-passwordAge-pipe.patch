diff --git a/src/app/pipes/password-age.pipe.spec.ts b/src/app/pipes/password-age.pipe.spec.ts
new file mode 100644
index 00000000..2a088638
--- /dev/null
+++ b/src/app/pipes/password-age.pipe.spec.ts
@@ -0,0 +1,125 @@
+import { I18nService } from 'jslib/abstractions/i18n.service';
+
+import { PasswordAgePipe } from './password-age.pipe';
+
+const messages: { [id: string]: string } = {
+    passwordAgeToday: 'Today',
+    passwordAgeOneDay: '1 day',
+    passwordAgeDays: '__$1__ days',
+    passwordAgeOneMonth: '1 month',
+    passwordAgeMonths: '__$1__ months',
+    passwordAgeOneYear: '1 year',
+    passwordAgeYears: '__$1__ years',
+};
+
+describe('PasswordAgePipe', () => {
+    // All dates are built in local time so the expectations hold in any time zone.
+    const now = new Date(2020, 11, 15, 12, 0, 0);
+
+    let i18nService: jasmine.SpyObj<I18nService>;
+    let pipe: PasswordAgePipe;
+
+    beforeEach(() => {
+        jasmine.clock().install();
+        jasmine.clock().mockDate(now);
+
+        i18nService = jasmine.createSpyObj<I18nService>('I18nService', ['t']);
+        i18nService.t.and.callFake((id: string, p1?: string) => messages[id].replace('__$1__', p1));
+        pipe = new PasswordAgePipe(i18nService);
+    });
+
+    afterEach(() => {
+        jasmine.clock().uninstall();
+    });
+
+    describe('transform', () => {
+        it('returns null for missing or invalid dates', () => {
+            expect(pipe.transform(null)).toBeNull();
+            expect(pipe.transform(undefined)).toBeNull();
+            expect(pipe.transform('')).toBeNull();
+            expect(pipe.transform('not a date')).toBeNull();
+            expect(pipe.transform(new Date(NaN))).toBeNull();
+            expect(i18nService.t).not.toHaveBeenCalled();
+        });
+
+        it('shows "Today" for a password changed earlier today', () => {
+            expect(pipe.transform(new Date(2020, 11, 15, 0, 1))).toBe('Today');
+        });
+
+        it('shows "Today" for dates in the future', () => {
+            expect(pipe.transform(new Date(2020, 11, 20))).toBe('Today');
+            expect(pipe.transform(new Date(2021, 5, 1))).toBe('Today');
+        });
+
+        it('counts calendar days rather than elapsed hours', () => {
+            expect(pipe.transform(new Date(2020, 11, 14, 23, 59))).toBe('1 day');
+        });
+
+        it('uses the singular form for one day', () => {
+            expect(pipe.transform(new Date(2020, 11, 14))).toBe('1 day');
+            expect(i18nService.t).toHaveBeenCalledWith('passwordAgeOneDay');
+        });
+
+        it('shows days for passwords younger than a month', () => {
+            expect(pipe.transform(new Date(2020, 11, 12))).toBe('3 days');
+            expect(i18nService.t).toHaveBeenCalledWith('passwordAgeDays', '3');
+        });
+
+        it('does not count a month until the same day of the next month', () => {
+            expect(pipe.transform(new Date(2020, 10, 16))).toBe('29 days');
+            expect(pipe.transform(new Date(2020, 10, 15))).toBe('1 month');
+        });
+
+        it('shows months for passwords younger than a year', () => {
+            expect(pipe.transform(new Date(2020, 6, 15))).toBe('5 months');
+            expect(pipe.transform(new Date(2020, 6, 16))).toBe('4 months');
+            expect(i18nService.t).toHaveBeenCalledWith('passwordAgeMonths', '4');
+        });
+
+        it('rounds down to months just before the first anniversary', () => {
+            expect(pipe.transform(new Date(2019, 11, 16))).toBe('11 months');
+        });
+
+        it('shows years from the first anniversary on', () => {
+            expect(pipe.transform(new Date(2019, 11, 15))).toBe('1 year');
+            expect(i18nService.t).toHaveBeenCalledWith('passwordAgeOneYear');
+            expect(pipe.transform(new Date(2018, 5, 1))).toBe('2 years');
+            expect(pipe.transform(new Date(2010, 0, 1))).toBe('10 years');
+            expect(i18nService.t).toHaveBeenCalledWith('passwordAgeYears', '10');
+        });
+
+        it('accepts ISO date strings and timestamps', () => {
+            const threeDaysAgo = new Date(2020, 11, 12, 8, 30);
+            expect(pipe.transform(threeDaysAgo.toISOString())).toBe('3 days');
+            expect(pipe.transform(threeDaysAgo.getTime())).toBe('3 days');
+        });
+    });
+
+    describe('getAgeInDays', () => {
+        it('returns null for missing or invalid dates', () => {
+            expect(PasswordAgePipe.getAgeInDays(null)).toBeNull();
+            expect(PasswordAgePipe.getAgeInDays('not a date')).toBeNull();
+        });
+
+        it('defaults to the current date', () => {
+            expect(PasswordAgePipe.getAgeInDays(new Date(2020, 11, 5))).toBe(10);
+        });
+
+        it('counts calendar days relative to the given date', () => {
+            expect(PasswordAgePipe.getAgeInDays(new Date(2019, 0, 1), new Date(2020, 0, 1))).toBe(365);
+            // 2020 is a leap year.
+            expect(PasswordAgePipe.getAgeInDays(new Date(2020, 0, 1), new Date(2021, 0, 1))).toBe(366);
+        });
+
+        it('is not affected by daylight saving time changes', () => {
+            // Spans the end of DST in both Europe (25 Oct) and North America (1 Nov).
+            expect(PasswordAgePipe.getAgeInDays(new Date(2020, 9, 20), new Date(2020, 10, 3))).toBe(14);
+            // Spans the start of DST in both Europe (29 Mar) and North America (8 Mar).
+            expect(PasswordAgePipe.getAgeInDays(new Date(2020, 2, 1), new Date(2020, 3, 1))).toBe(31);
+        });
+
+        it('treats future dates as 0 days old', () => {
+            expect(PasswordAgePipe.getAgeInDays(new Date(2020, 11, 31))).toBe(0);
+        });
+    });
+});
diff --git a/src/app/pipes/password-age.pipe.ts b/src/app/pipes/password-age.pipe.ts
new file mode 100644
index 00000000..86926658
--- /dev/null
+++ b/src/app/pipes/password-age.pipe.ts
@@ -0,0 +1,84 @@
+import {
+    Pipe,
+    PipeTransform,
+} from '@angular/core';
+
+import { I18nService } from 'jslib/abstractions/i18n.service';
+
+export const DefaultPasswordAgeThreshold = 365;
+
+const MillisecondsPerDay = 24 * 60 * 60 * 1000;
+
+/**
+ * Formats the time elapsed since a date (typically a password revision date) as a short, localized age,
+ * e.g. "3 days", "5 months" or "2 years". Ages are counted in whole calendar days, months and years and
+ * are always rounded down, so a password changed 11 months and 29 days ago reads "11 months".
+ */
+@Pipe({
+    name: 'passwordAge',
+})
+export class PasswordAgePipe implements PipeTransform {
+    /**
+     * Number of calendar days between `date` and `now`, or null if `date` is not a valid date.
+     * Dates in the future (e.g. due to clock skew) count as 0 days old.
+     */
+    static getAgeInDays(date: Date | string | number, now: Date = new Date()): number {
+        const from = PasswordAgePipe.toDate(date);
+        if (from == null) {
+            return null;
+        }
+        // Compare calendar dates rather than elapsed milliseconds so that DST changes and the time of day
+        // do not shift the result by one.
+        const days = (PasswordAgePipe.toUtcDay(now) - PasswordAgePipe.toUtcDay(from)) / MillisecondsPerDay;
+        return Math.max(days, 0);
+    }
+
+    private static getAgeInMonths(from: Date, now: Date): number {
+        let months = (now.getFullYear() - from.getFullYear()) * 12 + now.getMonth() - from.getMonth();
+        if (now.getDate() < from.getDate()) {
+            // The current month is not complete yet.
+            months--;
+        }
+        return Math.max(months, 0);
+    }
+
+    private static toUtcDay(date: Date): number {
+        return Date.UTC(date.getFullYear(), date.getMonth(), date.getDate());
+    }
+
+    private static toDate(value: Date | string | number): Date {
+        if (value == null || value === '') {
+            return null;
+        }
+        const date = value instanceof Date ? value : new Date(value);
+        return isNaN(date.getTime()) ? null : date;
+    }
+
+    constructor(private i18nService: I18nService) { }
+
+    transform(value: Date | string | number): string {
+        const from = PasswordAgePipe.toDate(value);
+        if (from == null) {
+            return null;
+        }
+
+        const now = new Date();
+        const months = PasswordAgePipe.getAgeInMonths(from, now);
+        if (months >= 12) {
+            return this.format(Math.floor(months / 12), 'passwordAgeOneYear', 'passwordAgeYears');
+        }
+        if (months >= 1) {
+            return this.format(months, 'passwordAgeOneMonth', 'passwordAgeMonths');
+        }
+
+        const days = PasswordAgePipe.getAgeInDays(from, now);
+        if (days === 0) {
+            return this.i18nService.t('passwordAgeToday');
+        }
+        return this.format(days, 'passwordAgeOneDay', 'passwordAgeDays');
+    }
+
+    private format(count: number, singularKey: string, pluralKey: string): string {
+        return count === 1 ? this.i18nService.t(singularKey) : this.i18nService.t(pluralKey, count.toString());
+    }
+}
