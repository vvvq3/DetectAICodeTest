+    getPasswordDate(c: CipherView): Date {
+        if (c.type !== CipherType.Login || c.login.password == null || c.login.password === '' || c.isDeleted) {
+            return null;
+        }
+        // The password revision date is only set once the password has been changed after the item was
+        // created. Until then the item's revision date is the best estimate available, even though it also
+        // moves when other fields are edited (so the age shown can only be too young, never too old).
+        return c.login.passwordRevisionDate ?? c.revisionDate;
+    }
+
+    isPasswordOld(passwordDate: Date) {
+        return PasswordAgePipe.getAgeInDays(passwordDate) > this.passwordAgeThreshold;
+    }
+
+    getPasswordAgeTitle(passwordDate: Date) {
+        return this.isPasswordOld(passwordDate)
+            ? this.i18nService.t('passwordAgeExceedsThreshold', this.passwordAgeThreshold.toString())
+            : this.i18nService.t('passwordAge');
+    }
+
     protected deleteCipher(id: string, permanent: boolean) {
         return permanent ? this.cipherService.deleteWithServer(id) : this.cipherService.softDeleteWithServer(id);
     }
