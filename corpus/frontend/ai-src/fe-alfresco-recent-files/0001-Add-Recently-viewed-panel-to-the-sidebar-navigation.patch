+import { Component, ViewEncapsulation } from '@angular/core';
+import { Store } from '@ngrx/store';
+import { ThumbnailService } from '@alfresco/adf-core';
+import { AppStore, ViewNodeAction } from '@alfresco/aca-shared/store';
+import { RecentlyViewedItem, RecentlyViewedService } from '../../../services/recently-viewed.service';
+
+@Component({
+  selector: 'app-recently-viewed',
+  templateUrl: './recently-viewed.component.html',
+  encapsulation: ViewEncapsulation.None,
+  host: { class: 'app-recently-viewed' }
+})
+export class RecentlyViewedComponent {
+  items$ = this.recentlyViewed.items$;
+
+  constructor(private recentlyViewed: RecentlyViewedService, private store: Store<AppStore>, private thumbnailService: ThumbnailService) {}
+
+  getIcon(item: RecentlyViewedItem): string {
+    return this.thumbnailService.getMimeTypeIcon(item.mimeType);
+  }
+
+  open(item: RecentlyViewedItem): void {
+    this.store.dispatch(new ViewNodeAction(item.id));
+  }
+
+  trackById(_: number, item: RecentlyViewedItem) {
+    return item.id;
+  }
+}
