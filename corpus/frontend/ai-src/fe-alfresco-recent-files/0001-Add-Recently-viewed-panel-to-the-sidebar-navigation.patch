diff --git a/src/app/components/sidenav/components/recently-viewed.component.html b/src/app/components/sidenav/components/recently-viewed.component.html
new file mode 100644
index 00000000..519db617
--- /dev/null
+++ b/src/app/components/sidenav/components/recently-viewed.component.html
@@ -0,0 +1,17 @@
+<div class="recently-viewed__title">{{ 'APP.RECENTLY_VIEWED.TITLE' | translate }}</div>
+
+<ng-container *ngIf="items$ | async as items">
+  <div *ngIf="!items.length" class="recently-viewed__empty">{{ 'APP.RECENTLY_VIEWED.EMPTY' | translate }}</div>
+
+  <ul *ngIf="items.length" class="recently-viewed__list">
+    <li *ngFor="let item of items; trackBy: trackById">
+      <button type="button" class="recently-viewed__item" [attr.data-automation-id]="'recently-viewed-' + item.id" [title]="item.name" (click)="open(item)">
+        <img class="recently-viewed__icon" [src]="getIcon(item)" alt="" />
+        <span class="recently-viewed__text">
+          <span class="recently-viewed__name">{{ item.name }}</span>
+          <span class="recently-viewed__time">{{ item.viewedAt | adfTimeAgo }}</span>
+        </span>
+      </button>
+    </li>
+  </ul>
+</ng-container>
