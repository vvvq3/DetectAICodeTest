+  static readonly STORAGE_KEY = 'aca.recently-viewed';
+  static readonly MAX_ITEMS = 10;
+
+  private itemsSubject: BehaviorSubject<RecentlyViewedItem[]>;
+
+  get items$(): Observable<RecentlyViewedItem[]> {
+    return this.itemsSubject.asObservable();
+  }
+
+  get items(): RecentlyViewedItem[] {
+    return this.itemsSubject.value;
+  }
+
+  constructor() {
+    this.itemsSubject = new BehaviorSubject<RecentlyViewedItem[]>(this.load());
+  }
+
+  /**
+   * Registers a file as viewed. Moves it to the top of the list
+   * if already present and keeps only the latest items.
+   */
+  add(item: { id: string; name: string; mimeType?: string }): void {
+    if (!item || !item.id) {
+      return;
+    }
+
+    const entry: RecentlyViewedItem = {
+      id: item.id,
+      name: item.name,
+      mimeType: item.mimeType,
+      viewedAt: Date.now()
+    };
+
+    const items = [entry, ...this.items.filter((i) => i.id !== entry.id)].slice(0, RecentlyViewedService.MAX_ITEMS);
+    this.save(items);
+  }
+
+  remove(id: string): void {
+    this.save(this.items.filter((i) => i.id !== id));
+  }
+
+  clear(): void {
+    this.save([]);
+  }
+
+  private save(items: RecentlyViewedItem[]): void {
+    try {
+      localStorage.setItem(RecentlyViewedService.STORAGE_KEY, JSON.stringify(items));
+    } catch {
+      // storage may be unavailable or full, keep the in-memory list only
+    }
+    this.itemsSubject.next(items);
+  }
+
+  private load(): RecentlyViewedItem[] {
+    try {
+      const data = JSON.parse(localStorage.getItem(RecentlyViewedService.STORAGE_KEY));
+      if (Array.isArray(data)) {
+        return data.filter((i) => i && typeof i.id === 'string' && typeof i.name === 'string').slice(0, RecentlyViewedService.MAX_ITEMS);
+      }
+    } catch {}
+    return [];
+  }
+}
