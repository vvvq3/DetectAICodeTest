+
+import { TestBed } from '@angular/core/testing';
+import { RecentlyViewedService } from './recently-viewed.service';
+
+describe('RecentlyViewedService', () => {
+  const key = RecentlyViewedService.STORAGE_KEY;
+
+  beforeEach(() => {
+    localStorage.removeItem(key);
+  });
+
+  afterEach(() => {
+    localStorage.removeItem(key);
+  });
+
+  function createService(): RecentlyViewedService {
+    TestBed.configureTestingModule({});
+    return TestBed.inject(RecentlyViewedService);
+  }
+
+  it('should start with an empty list', () => {
+    expect(createService().items).toEqual([]);
+  });
+
+  it('should add an item and persist it to localStorage', () => {
+    const service = createService();
+    service.add({ id: 'a', name: 'a.txt', mimeType: 'text/plain' });
+
+    expect(service.items.length).toBe(1);
+    expect(service.items[0].id).toBe('a');
+    const stored = JSON.parse(localStorage.getItem(key));
+    expect(stored.length).toBe(1);
+    expect(stored[0].name).toBe('a.txt');
+  });
+
+  it('should move an already viewed item to the top without duplicating it', () => {
+    const service = createService();
+    service.add({ id: 'a', name: 'a.txt' });
+    service.add({ id: 'b', name: 'b.txt' });
+    service.add({ id: 'a', name: 'a.txt' });
+
+    expect(service.items.map((i) => i.id)).toEqual(['a', 'b']);
+  });
+
+  it('should keep only the last 10 items', () => {
+    const service = createService();
+    for (let i = 0; i < 12; i++) {
+      service.add({ id: `id-${i}`, name: `file-${i}` });
+    }
+
+    expect(service.items.length).toBe(10);
+    expect(service.items[0].id).toBe('id-11');
+    expect(service.items[9].id).toBe('id-2');
+  });
+
+  it('should ignore items without id', () => {
+    const service = createService();
+    service.add({ id: null, name: 'x' });
+    service.add(null);
+
+    expect(service.items).toEqual([]);
+  });
+
+  it('should load items stored previously', () => {
+    localStorage.setItem(key, JSON.stringify([{ id: 'a', name: 'a.txt', viewedAt: 1 }]));
+
+    expect(createService().items.length).toBe(1);
+  });
+
+  it('should ignore corrupted storage data', () => {
+    localStorage.setItem(key, '{not json');
+
+    expect(createService().items).toEqual([]);
+  });
+
+  it('should remove an item', () => {
+    const service = createService();
+    service.add({ id: 'a', name: 'a.txt' });
+    service.add({ id: 'b', name: 'b.txt' });
+    service.remove('a');
+
+    expect(service.items.map((i) => i.id)).toEqual(['b']);
+  });
+
+  it('should clear the list', () => {
+    const service = createService();
+    service.add({ id: 'a', name: 'a.txt' });
+    service.clear();
+
+    expect(service.items).toEqual([]);
+    expect(JSON.parse(localStorage.getItem(key))).toEqual([]);
+  });
+
+  it('should emit changes through items$', () => {
+    const service = createService();
+    let latest = [];
+    service.items$.subscribe((items) => (latest = items));
+    service.add({ id: 'a', name: 'a.txt' });
+
+    expect(latest.length).toBe(1);
+  });
+});
