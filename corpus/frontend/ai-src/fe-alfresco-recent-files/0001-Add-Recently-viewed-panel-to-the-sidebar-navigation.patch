+import { ComponentFixture, TestBed } from '@angular/core/testing';
+import { TranslateModule } from '@ngx-translate/core';
+import { Store } from '@ngrx/store';
+import { ThumbnailService } from '@alfresco/adf-core';
+import { ViewNodeAction } from '@alfresco/aca-shared/store';
+import { AppTestingModule } from '../../../testing/app-testing.module';
+import { AppSidenavModule } from '../sidenav.module';
+import { RecentlyViewedComponent } from './recently-viewed.component';
+import { RecentlyViewedService } from '../../../services/recently-viewed.service';
+
+describe('RecentlyViewedComponent', () => {
+  let fixture: ComponentFixture<RecentlyViewedComponent>;
+  let component: RecentlyViewedComponent;
+  let service: RecentlyViewedService;
+  let store: Store<any>;
+
+  beforeEach(() => {
+    localStorage.removeItem(RecentlyViewedService.STORAGE_KEY);
+
+    TestBed.configureTestingModule({
+      imports: [AppTestingModule, AppSidenavModule, TranslateModule.forRoot()]
+    });
+
+    service = TestBed.inject(RecentlyViewedService);
+    store = TestBed.inject(Store);
+    spyOn(TestBed.inject(ThumbnailService), 'getMimeTypeIcon').and.returnValue('icon.svg');
+    spyOn(store, 'dispatch');
+
+    fixture = TestBed.createComponent(RecentlyViewedComponent);
+    component = fixture.componentInstance;
+  });
+
+  afterEach(() => {
+    localStorage.removeItem(RecentlyViewedService.STORAGE_KEY);
+  });
+
+  it('should show the empty message when nothing was viewed', () => {
+    fixture.detectChanges();
+
+    const el: HTMLElement = fixture.nativeElement;
+    expect(el.querySelector('.recently-viewed__empty')).not.toBeNull();
+    expect(el.querySelectorAll('.recently-viewed__item').length).toBe(0);
+  });
+
+  it('should render a row with name, icon and time for each viewed file', () => {
+    service.add({ id: 'a', name: 'first.txt', mimeType: 'text/plain' });
+    service.add({ id: 'b', name: 'second.pdf', mimeType: 'application/pdf' });
+    fixture.detectChanges();
+
+    const el: HTMLElement = fixture.nativeElement;
+    const rows = el.querySelectorAll('.recently-viewed__item');
+    expect(rows.length).toBe(2);
+    expect(rows[0].querySelector('.recently-viewed__name').textContent).toBe('second.pdf');
+    expect(rows[1].querySelector('.recently-viewed__name').textContent).toBe('first.txt');
+    expect(rows[0].querySelector('.recently-viewed__icon').getAttribute('src')).toBe('icon.svg');
+    expect(rows[0].querySelector('.recently-viewed__time').textContent.trim()).not.toBe('');
+    expect(el.querySelector('.recently-viewed__empty')).toBeNull();
+  });
+
+  it('should open the file in the viewer on click', () => {
+    service.add({ id: 'a', name: 'first.txt' });
+    fixture.detectChanges();
+
+    (fixture.nativeElement.querySelector('.recently-viewed__item') as HTMLElement).click();
+
+    expect(store.dispatch).toHaveBeenCalledWith(new ViewNodeAction('a'));
+  });
+
+  it('should update the list when a new file is viewed', () => {
+    fixture.detectChanges();
+    service.add({ id: 'a', name: 'first.txt' });
+    fixture.detectChanges();
+
+    expect(fixture.nativeElement.querySelectorAll('.recently-viewed__item').length).toBe(1);
+  });
+
+  it('should track items by id', () => {
+    expect(component.trackById(0, { id: 'x', name: 'x', viewedAt: 0 })).toBe('x');
+  });
+});
