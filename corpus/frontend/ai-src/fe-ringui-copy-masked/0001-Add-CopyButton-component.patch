index 0000000000..faece2a224
--- /dev/null
+++ b/components/copy-button/copy-button.test.js
@@ -0,0 +1,68 @@
+import React from 'react';
+import {shallow, mount} from 'enzyme';
+
+import Button from '../button/button';
+import alert from '../alert-service/alert-service';
+
+import CopyButton from './copy-button';
+
+describe('Copy Button', () => {
+  const shallowCopyButton = params => shallow(<CopyButton {...params}/>);
+  const mountCopyButton = params => mount(<CopyButton {...params}/>);
+
+  let clock;
+  let writeText;
+
+  beforeEach(() => {
+    clock = sandbox.useFakeTimers({toFake: ['setTimeout']});
+    writeText = sandbox.stub().resolves();
+    sandbox.stub(navigator, 'clipboard').value({writeText});
+  });
+
+  it('should create component', () => {
+    mountCopyButton({text: 'foo'}).should.have.type(CopyButton);
+  });
+
+  it('should render button', () => {
+    shallowCopyButton({text: 'foo'}).should.have.type(Button);
+  });
+
+  it('should render children', () => {
+    mountCopyButton({text: 'foo', children: 'Copy me'}).should.have.text('Copy me');
+  });
+
+  it('should copy passed text', async () => {
+    const wrapper = mountCopyButton({text: 'foo'});
+    await wrapper.instance().copy();
+    writeText.should.have.been.calledWith('foo');
+  });
+
+  it('should call onCopy', async () => {
+    const onCopy = sandbox.spy();
+    const wrapper = mountCopyButton({text: 'foo', onCopy});
+    await wrapper.instance().copy();
+    onCopy.should.have.been.calledWith('foo');
+  });
+
+  it('should show copied state and reset it after timeout', async () => {
+    const wrapper = mountCopyButton({text: 'foo', copiedTimeout: 1000});
+    await wrapper.instance().copy();
+    wrapper.update();
+    wrapper.should.have.text('Copied');
+
+    clock.tick(1000);
+    wrapper.update();
+    wrapper.should.have.text('Copy');
+  });
+
+  it('should show alert on failure', async () => {
+    writeText.rejects(new Error('denied'));
+    sandbox.stub(alert, 'error');
+    const onCopy = sandbox.spy();
+    const wrapper = mountCopyButton({text: 'foo', onCopy});
+    await wrapper.instance().copy();
+    alert.error.should.have.been.called;
+    onCopy.should.not.have.been.called;
+    wrapper.should.have.text('Copy');
+  });
+});
