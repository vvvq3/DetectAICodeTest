+import React, {PureComponent} from 'react';
+import PropTypes from 'prop-types';
+
+import Button from '../button/button';
+import alert from '../alert-service/alert-service';
+
+/**
+ * @name Copy Button
+ */
+
+const COPIED_TIMEOUT = 2000;
+
+export default class CopyButton extends PureComponent {
+  static propTypes = {
+    text: PropTypes.string.isRequired,
+    copiedTimeout: PropTypes.number,
+    onCopy: PropTypes.func,
+    children: PropTypes.node
+  };
+
+  static defaultProps = {
+    copiedTimeout: COPIED_TIMEOUT,
+    onCopy: () => {},
+    children: 'Copy'
+  };
+
+  state = {
+    copied: false
+  };
+
+  componentWillUnmount() {
+    clearTimeout(this.copiedTimeout);
+  }
+
+  copy = async () => {
+    const {text, copiedTimeout, onCopy} = this.props;
+
+    try {
+      await navigator.clipboard.writeText(text);
+    } catch (e) {
+      alert.error('Failed to copy to the clipboard');
+      return;
+    }
+
+    onCopy(text);
+    this.setState({copied: true});
+    clearTimeout(this.copiedTimeout);
+    this.copiedTimeout = setTimeout(() => {
+      this.setState({copied: false});
+    }, copiedTimeout);
+  };
+
+  render() {
+    // eslint-disable-next-line no-unused-vars
+    const {text, copiedTimeout, onCopy, children, ...restProps} = this.props;
+    const {copied} = this.state;
+
+    return (
+      <Button
+        {...restProps}
+        onClick={this.copy}
+      >
+        {copied ? 'Copied' : children}
+      </Button>
+    );
+  }
+}
diff --git a/components/copy-button/copy-button.test.js b/components/copy-button/copy-button.test.js
