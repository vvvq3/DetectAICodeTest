+import { Component, Inject, Input, OnDestroy, ViewChild } from '@angular/core';
+import { DOCUMENT } from '@angular/common';
+import { NgbTooltip } from '@ng-bootstrap/ng-bootstrap';
+import { TranslateService } from '@ngx-translate/core';
+import { NativeWindowRef, NativeWindowService } from '../../core/services/window.service';
+import { NotificationsService } from '../notifications/notifications.service';
+import { hasValue, isEmpty } from '../empty.util';
+
+/**
+ * The amount of time (in ms) the "Copied!" feedback stays visible after a successful copy
+ */
+export const COPIED_FEEDBACK_DURATION = 2000;
+
+/**
+ * A small button that copies the given content to the user's clipboard.
+ * A "Copied!" tooltip is shown after a successful copy, an error notification
+ * is shown when the clipboard can't be accessed.
+ */
+@Component({
+  selector: 'ds-copy-to-clipboard',
+  templateUrl: './copy-to-clipboard.component.html'
+})
+export class CopyToClipboardComponent implements OnDestroy {
+
+  /**
+   * The text to copy to the clipboard
+   */
+  @Input() content: string;
+
+  /**
+   * A message for the tooltip and the accessible label of the button
+   * Supports i18n keys
+   */
+  @Input() tooltipMsg = 'copy-to-clipboard.button.tooltip';
+
+  /**
+   * The tooltip of the button, also used to give feedback after a successful copy
+   */
+  @ViewChild('copyTooltip', { static: false }) tooltip: NgbTooltip;
+
+  /**
+   * Whether the content has just been copied
+   */
+  copied = false;
+
+  /**
+   * The timeout that resets the "copied" state
+   */
+  private resetTimeout: any;
+
+  constructor(@Inject(NativeWindowService) protected _window: NativeWindowRef,
+              @Inject(DOCUMENT) protected document: Document,
+              protected notificationsService: NotificationsService,
+              protected translate: TranslateService) {
+  }
+
+  /**
+   * Copy the content to the clipboard and let the user know whether that worked
+   * @returns a promise that resolves once the user has been given feedback
+   */
+  copy(): Promise<void> {
+    if (isEmpty(this.content)) {
+      return Promise.resolve();
+    }
+    return this.writeToClipboard(this.content).then(
+      () => this.onCopySuccess(),
+      () => this.onCopyError()
+    );
+  }
+
+  /**
+   * Write the given text to the clipboard.
+   * Uses the asynchronous Clipboard API where available, and falls back to
+   * document.execCommand('copy') for browsers that don't support it or don't
+   * allow it (e.g. on pages that aren't served over https).
+   * @param text  The text to write to the clipboard
+   * @returns a promise that resolves when the text was copied, and rejects when it couldn't be
+   */
+  protected writeToClipboard(text: string): Promise<void> {
+    const nativeWindow = this._window.nativeWindow;
+    const clipboard = nativeWindow && nativeWindow.navigator ? nativeWindow.navigator.clipboard : undefined;
+    if (hasValue(clipboard) && typeof clipboard.writeText === 'function') {
+      return clipboard.writeText(text).catch(() => this.copyWithExecCommand(text));
+    }
+    return this.copyWithExecCommand(text);
+  }
+
+  /**
+   * Copy the given text using a temporary, invisible textarea and document.execCommand('copy')
+   * @param text  The text to write to the clipboard
+   * @returns a promise that resolves when the text was copied, and rejects when it couldn't be
+   */
+  protected copyWithExecCommand(text: string): Promise<void> {
+    const doc = this.document;
+    if (!hasValue(doc) || !hasValue(doc.body) || typeof doc.execCommand !== 'function') {
+      return Promise.reject(new Error('The clipboard is not available'));
+    }
+
+    const previouslyFocused = doc.activeElement as HTMLElement;
+    const textArea = doc.createElement('textarea');
+    textArea.value = text;
+    // Keep the textarea out of sight, and prevent the page from scrolling
+    // or a virtual keyboard from popping up while it's selected
+    textArea.setAttribute('readonly', '');
+    textArea.setAttribute('aria-hidden', 'true');
+    textArea.style.position = 'fixed';
+    textArea.style.top = '0';
+    textArea.style.left = '0';
+    textArea.style.opacity = '0';
+    doc.body.appendChild(textArea);
+
+    let succeeded: boolean;
+    try {
+      textArea.select();
+      textArea.setSelectionRange(0, text.length);
+      succeeded = doc.execCommand('copy');
+    } catch (e) {
+      succeeded = false;
+    } finally {
+      doc.body.removeChild(textArea);
+      if (hasValue(previouslyFocused) && typeof previouslyFocused.focus === 'function') {
+        previouslyFocused.focus();
+      }
+    }
+
+    return succeeded ? Promise.resolve() : Promise.reject(new Error('The clipboard is not available'));
+  }
+
+  /**
+   * Show the "Copied!" tooltip for a little while
+   */
+  protected onCopySuccess(): void {
+    this.copied = true;
+    if (hasValue(this.tooltip)) {
+      this.tooltip.open();
+    }
+    this.clearResetTimeout();
+    this.resetTimeout = setTimeout(() => {
+      this.copied = false;
+      this.resetTimeout = undefined;
+      if (hasValue(this.tooltip)) {
+        this.tooltip.close();
+      }
+    }, COPIED_FEEDBACK_DURATION);
+  }
+
+  /**
+   * Let the user know the content couldn't be copied
+   */
+  protected onCopyError(): void {
+    this.clearResetTimeout();
+    this.copied = false;
+    this.notificationsService.error(
+      this.translate.get('copy-to-clipboard.error.title'),
+      this.translate.get('copy-to-clipboard.error.content')
+    );
+  }
+
+  private clearResetTimeout(): void {
+    if (hasValue(this.resetTimeout)) {
+      clearTimeout(this.resetTimeout);
+      this.resetTimeout = undefined;
+    }
+  }
+
+  ngOnDestroy(): void {
+    this.clearResetTimeout();
+  }
+}
