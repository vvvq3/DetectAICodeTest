+<button type="button"
+        class="copy-to-clipboard btn btn-link btn-sm p-0 align-baseline"
+        [attr.aria-label]="tooltipMsg | translate"
+        [ngbTooltip]="tooltipContent"
+        #copyTooltip="ngbTooltip"
+        container="body"
+        (click)="copy()">
+  <i class="fa-fw" [ngClass]="copied ? 'fas fa-check' : 'far fa-copy'" aria-hidden="true"></i>
+</button>
+<span class="sr-only" aria-live="polite">{{ copied ? ('copy-to-clipboard.success' | translate) : '' }}</span>
