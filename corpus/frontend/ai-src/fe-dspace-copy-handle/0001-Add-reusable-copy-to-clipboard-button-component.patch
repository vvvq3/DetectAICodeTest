+import { async, ComponentFixture, fakeAsync, flush, flushMicrotasks, TestBed, tick } from '@angular/core/testing';
+import { By } from '@angular/platform-browser';
+import { NgbModule } from '@ng-bootstrap/ng-bootstrap';
+import { TranslateModule } from '@ngx-translate/core';
+import { COPIED_FEEDBACK_DURATION, CopyToClipboardComponent } from './copy-to-clipboard.component';
+import { NativeWindowService } from '../../core/services/window.service';
+import { NotificationsService } from '../notifications/notifications.service';
+import { NotificationsServiceStub } from '../testing/notifications-service.stub';
+
+describe('CopyToClipboardComponent', () => {
+  let component: CopyToClipboardComponent;
+  let fixture: ComponentFixture<CopyToClipboardComponent>;
+
+  let notificationsService: NotificationsServiceStub;
+  let clipboard: { writeText: jasmine.Spy };
+  let nativeWindow: any;
+
+  const content = 'http://localhost:4000/handle/123456789/2';
+
+  beforeEach(async(() => {
+    notificationsService = new NotificationsServiceStub();
+    clipboard = {
+      writeText: jasmine.createSpy('writeText').and.callFake(() => Promise.resolve())
+    };
+    nativeWindow = {
+      navigator: { clipboard }
+    };
+
+    TestBed.configureTestingModule({
+      imports: [TranslateModule.forRoot(), NgbModule],
+      declarations: [CopyToClipboardComponent],
+      providers: [
+        { provide: NativeWindowService, useFactory: () => ({ nativeWindow }) },
+        { provide: NotificationsService, useValue: notificationsService }
+      ]
+    }).compileComponents();
+  }));
+
+  beforeEach(() => {
+    fixture = TestBed.createComponent(CopyToClipboardComponent);
+    component = fixture.componentInstance;
+    component.content = content;
+    fixture.detectChanges();
+  });
+
+  /**
+   * Click the copy button and wait for the clipboard to respond
+   */
+  function clickCopyButton() {
+    fixture.debugElement.query(By.css('button')).triggerEventHandler('click', null);
+    flushMicrotasks();
+    fixture.detectChanges();
+  }
+
+  function getIcon() {
+    return fixture.debugElement.query(By.css('button i')).nativeElement;
+  }
+
+  it('should render a button labelled with the tooltip message', () => {
+    const button = fixture.debugElement.query(By.css('button'));
+    expect(button).not.toBeNull();
+    expect(button.nativeElement.getAttribute('aria-label')).toEqual('copy-to-clipboard.button.tooltip');
+  });
+
+  it('should display a copy icon', () => {
+    expect(getIcon().classList).toContain('fa-copy');
+  });
+
+  describe('when the Clipboard API is available', () => {
+
+    it('should write the content to the clipboard', fakeAsync(() => {
+      clickCopyButton();
+      expect(clipboard.writeText).toHaveBeenCalledWith(content);
+      flush();
+    }));
+
+    it('should show the "Copied!" feedback', fakeAsync(() => {
+      clickCopyButton();
+      expect(component.copied).toBe(true);
+      expect(component.tooltip.isOpen()).toBe(true);
+      expect(getIcon().classList).toContain('fa-check');
+      flush();
+    }));
+
+    it('should not show an error notification', fakeAsync(() => {
+      clickCopyButton();
+      expect(notificationsService.error).not.toHaveBeenCalled();
+      flush();
+    }));
+
+    it('should hide the "Copied!" feedback again after a while', fakeAsync(() => {
+      clickCopyButton();
+      tick(COPIED_FEEDBACK_DURATION);
+      fixture.detectChanges();
+      expect(component.copied).toBe(false);
+      expect(component.tooltip.isOpen()).toBe(false);
+      expect(getIcon().classList).toContain('fa-copy');
+    }));
+
+    describe('but writing to it fails', () => {
+      beforeEach(() => {
+        clipboard.writeText.and.callFake(() => Promise.reject(new Error('Write permission denied')));
+      });
+
+      it('should fall back to document.execCommand', fakeAsync(() => {
+        spyOn(document, 'execCommand').and.returnValue(true);
+        clickCopyButton();
+        expect(document.execCommand).toHaveBeenCalledWith('copy');
+        expect(component.copied).toBe(true);
+        expect(notificationsService.error).not.toHaveBeenCalled();
+        flush();
+      }));
+
+      it('should show an error notification when the fallback fails too', fakeAsync(() => {
+        spyOn(document, 'execCommand').and.returnValue(false);
+        clickCopyButton();
+        expect(component.copied).toBe(false);
+        expect(notificationsService.error).toHaveBeenCalled();
+        flush();
+      }));
+    });
+  });
+
+  describe('when the Clipboard API is not available', () => {
+    beforeEach(() => {
+      delete nativeWindow.navigator.clipboard;
+    });
+
+    describe('and document.execCommand succeeds', () => {
+      beforeEach(() => {
+        spyOn(document, 'execCommand').and.returnValue(true);
+      });
+
+      it('should copy the content using a temporary textarea', fakeAsync(() => {
+        const textAreaCount = document.querySelectorAll('textarea').length;
+        let copiedText: string;
+        (document.execCommand as jasmine.Spy).and.callFake(() => {
+          copiedText = (document.body.lastElementChild as HTMLTextAreaElement).value;
+          return true;
+        });
+
+        clickCopyButton();
+
+        expect(document.execCommand).toHaveBeenCalledWith('copy');
+        expect(copiedText).toEqual(content);
+        expect(document.querySelectorAll('textarea').length).toEqual(textAreaCount);
+        flush();
+      }));
+
+      it('should show the "Copied!" feedback', fakeAsync(() => {
+        clickCopyButton();
+        expect(component.copied).toBe(true);
+        expect(component.tooltip.isOpen()).toBe(true);
+        expect(notificationsService.error).not.toHaveBeenCalled();
+        flush();
+      }));
+    });
+
+    describe('and document.execCommand fails', () => {
+      beforeEach(() => {
+        spyOn(document, 'execCommand').and.returnValue(false);
+      });
+
+      it('should show an error notification', fakeAsync(() => {
+        clickCopyButton();
+        expect(notificationsService.error).toHaveBeenCalled();
+        flush();
+      }));
+
+      it('should not show the "Copied!" feedback', fakeAsync(() => {
+        clickCopyButton();
+        expect(component.copied).toBe(false);
+        expect(component.tooltip.isOpen()).toBe(false);
+        flush();
+      }));
+    });
+  });
+
+  describe('when there is no content to copy', () => {
+    beforeEach(() => {
+      component.content = undefined;
+      fixture.detectChanges();
+    });
+
+    it('should not touch the clipboard', fakeAsync(() => {
+      clickCopyButton();
+      expect(clipboard.writeText).not.toHaveBeenCalled();
+      expect(component.copied).toBe(false);
+      expect(notificationsService.error).not.toHaveBeenCalled();
+    }));
+  });
+});
