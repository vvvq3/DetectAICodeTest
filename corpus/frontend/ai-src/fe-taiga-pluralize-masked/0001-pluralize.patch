+import {TuiPluralize} from '../../../types/pluralize';
+import {TuiPluralizePipe} from '../pluralize.pipe';
+
+describe('TuiPluralize pipe', () => {
+    let pipe: TuiPluralizePipe;
+    const files: TuiPluralize = ['файл', 'файла', 'файлов'];
+
+    beforeEach(() => {
+        pipe = new TuiPluralizePipe();
+    });
+
+    it('1 файл', () => {
+        expect(pipe.transform(1, files)).toBe('файл');
+    });
+
+    it('2 файла', () => {
+        expect(pipe.transform(2, files)).toBe('файла');
+    });
+
+    it('5 файлов', () => {
+        expect(pipe.transform(5, files)).toBe('файлов');
+    });
+
+    it('111 файлов', () => {
+        expect(pipe.transform(111, files)).toBe('файлов');
+    });
+
+    it('-21 файл', () => {
+        expect(pipe.transform(-21, files)).toBe('файл');
+    });
+
+    it('-14 файлов', () => {
+        expect(pipe.transform(-14, files)).toBe('файлов');
+    });
+
+    it('1,5 файла', () => {
+        expect(pipe.transform(1.5, files)).toBe('файла');
+    });
+});
