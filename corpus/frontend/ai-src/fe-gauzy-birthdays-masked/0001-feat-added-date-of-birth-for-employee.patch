 			"APPLIED_DATE_LABEL": "Date when applied",
 			"IMAGE_URL": "Image URL (optional)",
 			"CV_URL": "CV URL (optional)",
diff --git a/libs/models/src/lib/employee.model.ts b/libs/models/src/lib/employee.model.ts
index a86f7a3564..6ba4d5a9c5 100644
