From: Dev <dev@example.local>
Date: Thu, 5 Nov 2026 22:13:48 +0000
Subject: [PATCH 1/2] feat: added date of birth for employee

---
 apps/api/src/app/employee/employee.entity.ts  |  6 ++++++
 .../edit-employee-employment.component.html   | 20 +++++++++++++++++++
 .../edit-employee-employment.component.ts     |  3 +++
 apps/gauzy/src/assets/i18n/en.json            |  1 +
 libs/models/src/lib/employee.model.ts         |  2 ++
 5 files changed, 32 insertions(+)

diff --git a/apps/api/src/app/employee/employee.entity.ts b/apps/api/src/app/employee/employee.entity.ts
index 10fb149944..78d4b619c7 100644
--- a/apps/api/src/app/employee/employee.entity.ts
+++ b/apps/api/src/app/employee/employee.entity.ts
@@ -182,6 +182,12 @@ export class Employee extends TenantOrganizationBase implements IEmployee {
 	@Column({ nullable: true })
 	rejectDate?: Date;
 
+	@ApiPropertyOptional({ type: Date })
+	@IsDate()
+	@IsOptional()
+	@Column({ nullable: true })
+	dateOfBirth?: Date;
+
 	@ManyToMany(
 		(type) => OrganizationDepartment,
 		(organizationDepartment) => organizationDepartment.members,
diff --git a/apps/gauzy/src/app/pages/employees/edit-employee/edit-employee-profile/edit-employee-employment/edit-employee-employment.component.html b/apps/gauzy/src/app/pages/employees/edit-employee/edit-employee-profile/edit-employee-employment/edit-employee-employment.component.html
index ff7d4af4fd..524c6f94da 100644
--- a/apps/gauzy/src/app/pages/employees/edit-employee/edit-employee-profile/edit-employee-employment/edit-employee-employment.component.html
+++ b/apps/gauzy/src/app/pages/employees/edit-employee/edit-employee-profile/edit-employee-employment/edit-employee-employment.component.html
@@ -34,6 +34,26 @@
 					</div>
 				</div>
 			</div>
+			<div class="row">
+				<div class="col-md-6">
+					<div class="form-group">
+						<label for="dateOfBirth" class="label">
+							{{ 'FORM.LABELS.DATE_OF_BIRTH' | translate }}
+						</label>
+						<input
+							id="dateOfBirth"
+							[nbDatepicker]="dateOfBirthPicker"
+							nbInput
+							fullWidth
+							placeholder="{{
+								'FORM.PLACEHOLDERS.PICK_DATE' | translate
+							}}"
+							formControlName="dateOfBirth"
+						/>
+						<nb-datepicker #dateOfBirthPicker></nb-datepicker>
+					</div>
+				</div>
+			</div>
 			<div class="row">
 				<div class="col">
 					<div class="form-group">
diff --git a/apps/gauzy/src/app/pages/employees/edit-employee/edit-employee-profile/edit-employee-employment/edit-employee-employment.component.ts b/apps/gauzy/src/app/pages/employees/edit-employee/edit-employee-profile/edit-employee-employment/edit-employee-employment.component.ts
index f57c63fab7..8e521d52d6 100644
--- a/apps/gauzy/src/app/pages/employees/edit-employee/edit-employee-profile/edit-employee-employment/edit-employee-employment.component.ts
+++ b/apps/gauzy/src/app/pages/employees/edit-employee/edit-employee-profile/edit-employee-employment/edit-employee-employment.component.ts
@@ -152,6 +152,9 @@ export class EditEmployeeEmploymentComponent implements OnInit, OnDestroy {
 				employee.startedWorkOn !== null
 					? new Date(employee.startedWorkOn)
 					: ''
+			],
+			dateOfBirth: [
+				employee.dateOfBirth ? new Date(employee.dateOfBirth) : null
 			]
 		});
 
diff --git a/apps/gauzy/src/assets/i18n/en.json b/apps/gauzy/src/assets/i18n/en.json
