@@ -36,6 +36,7 @@ export interface IEmployee extends IBasePerTenantAndOrganizationEntityModel {
 	offerDate?: Date;
 	acceptDate?: Date;
 	rejectDate?: Date;
+	dateOfBirth?: Date;
 	employeeLevel?: string;
 	anonymousBonus?: boolean;
 	organizationEmploymentTypes?: IOrganizationEmploymentType[];
@@ -93,6 +94,7 @@ export interface IEmployeeUpdateInput {
 	offerDate?: Date;
 	acceptDate?: Date;
 	rejectDate?: Date;
+	dateOfBirth?: Date;
 	short_description?: string;
 	description?: string;
 	averageIncome?: number;
