+<nb-card [nbSpinner]="loading" nbSpinnerSize="giant" nbSpinnerStatus="primary">
+	<nb-card-header>{{
+		'DASHBOARD_PAGE.UPCOMING_BIRTHDAYS.TITLE' | translate
+	}}</nb-card-header>
+	<ng-template [ngIf]="birthdays?.length > 0" [ngIfElse]="noBirthdays">
+		<nb-list>
+			<nb-list-item *ngFor="let birthday of birthdays">
+				<div class="w-100">
+					<div class="row align-items-center">
+						<div class="col">
+							<ngx-avatar
+								[name]="birthday.employee?.user?.name"
+								[src]="birthday.employee?.user?.imageUrl"
+								[caption]="birthday.date | date: 'MMMM d'"
+							></ngx-avatar>
+						</div>
+						<div class="col-auto">
+							<span *ngIf="birthday.daysLeft === 0">{{
+								'DASHBOARD_PAGE.UPCOMING_BIRTHDAYS.TODAY'
+									| translate
+							}}</span>
+							<span *ngIf="birthday.daysLeft === 1">{{
+								'DASHBOARD_PAGE.UPCOMING_BIRTHDAYS.TOMORROW'
+									| translate
+							}}</span>
+							<span *ngIf="birthday.daysLeft > 1">{{
+								'DASHBOARD_PAGE.UPCOMING_BIRTHDAYS.DAYS_LEFT'
+									| translate: { days: birthday.daysLeft }
+							}}</span>
+						</div>
+					</div>
+				</div>
+			</nb-list-item>
+		</nb-list>
+	</ng-template>
+	<ng-template #noBirthdays>
+		<div class="text-center p-3" *ngIf="!loading">
+			{{ 'DASHBOARD_PAGE.UPCOMING_BIRTHDAYS.NO_BIRTHDAYS' | translate }}
+		</div>
+	</ng-template>
+</nb-card>
diff --git a/apps/gauzy/src/app/pages/dashboard/upcoming-birthdays/upcoming-birthdays.component.ts b/apps/gauzy/src/app/pages/dashboard/upcoming-birthdays/upcoming-birthdays.component.ts
new file mode 100644
index 0000000000..7a6053c09b
--- /dev/null
+++ b/apps/gauzy/src/app/pages/dashboard/upcoming-birthdays/upcoming-birthdays.component.ts
@@ -0,0 +1,74 @@
+import { Component, OnDestroy, OnInit } from '@angular/core';
+import { IEmployee, IOrganization } from '@gauzy/models';
+import { UntilDestroy, untilDestroyed } from '@ngneat/until-destroy';
+import { filter, first } from 'rxjs/operators';
+import * as moment from 'moment';
+import { EmployeesService } from '../../../@core/services/employees.service';
+import { Store } from '../../../@core/services/store.service';
+
+@UntilDestroy({ checkProperties: true })
+@Component({
+	selector: 'ga-upcoming-birthdays',
+	templateUrl: './upcoming-birthdays.component.html'
+})
+export class UpcomingBirthdaysComponent implements OnInit, OnDestroy {
+	birthdays: { employee: IEmployee; date: Date; daysLeft: number }[] = [];
+	organization: IOrganization;
+	loading = true;
+
+	constructor(
+		private store: Store,
+		private employeesService: EmployeesService
+	) {}
+
+	ngOnInit() {
+		this.store.selectedOrganization$
+			.pipe(
+				filter((organization) => !!organization),
+				untilDestroyed(this)
+			)
+			.subscribe((organization) => {
+				this.organization = organization;
+				this.getBirthdays();
+			});
+	}
+
+	getBirthdays() {
+		const { id: organizationId, tenantId } = this.organization;
+		this.loading = true;
+		this.employeesService
+			.getAll(['user'], {
+				organization: { id: organizationId },
+				tenantId
+			})
+			.pipe(first())
+			.toPromise()
+			.then(({ items }) => {
+				const today = moment().startOf('day');
+				this.birthdays = items
+					.filter(
+						(employee) => employee.isActive && employee.dateOfBirth
+					)
+					.map((employee) => {
+						const date = moment(employee.dateOfBirth)
+							.year(today.year())
+							.startOf('day');
+						if (date.isBefore(today)) {
+							date.add(1, 'year');
+						}
+						return {
+							employee,
+							date: date.toDate(),
+							daysLeft: date.diff(today, 'days')
+						};
+					})
+					.filter((birthday) => birthday.daysLeft <= 30)
+					.sort((a, b) => a.daysLeft - b.daysLeft);
+			})
+			.finally(() => {
+				this.loading = false;
+			});
+	}
+
+	ngOnDestroy() {}
+}
