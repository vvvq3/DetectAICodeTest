@@ -0,0 +1,112 @@
+import { trim, get, size } from "lodash";
+import React, { useState } from "react";
+import PropTypes from "prop-types";
+import Modal from "antd/lib/modal";
+import Input from "antd/lib/input";
+import { wrap as wrapDialog, DialogPropType } from "@/components/DialogWrapper";
+import navigateTo from "@/components/ApplicationArea/navigateTo";
+import notification from "@/services/notification";
+import recordEvent from "@/services/recordEvent";
+import { duplicateDashboard } from "@/services/dashboard";
+
+function widgetsCount(count) {
+  return count === 1 ? "1 widget" : `${count} widgets`;
+}
+
+function getDuplicationIssues({ settingsCopied, skippedWidgets, failedWidgets }) {
+  const issues = [];
+  const failedCount = size(failedWidgets);
+  const skippedCount = size(skippedWidgets);
+  if (failedCount > 0) {
+    issues.push(`${widgetsCount(failedCount)} could not be copied.`);
+  }
+  if (skippedCount > 0) {
+    const verb = skippedCount === 1 ? "was" : "were";
+    issues.push(`${widgetsCount(skippedCount)} ${verb} skipped because you don't have access to their data sources.`);
+  }
+  if (!settingsCopied) {
+    issues.push("Dashboard tags and filters setting could not be copied.");
+  }
+  return issues;
+}
+
+function DuplicateDashboardDialog({ dialog, dashboard }) {
+  const [name, setName] = useState(`Copy of ${dashboard.name}`);
+  const [saveInProgress, setSaveInProgress] = useState(false);
+  const isValid = trim(name) !== "";
+
+  function save() {
+    if (!isValid || saveInProgress) {
+      return;
+    }
+
+    setSaveInProgress(true);
+    recordEvent("duplicate", "dashboard", dashboard.id);
+
+    duplicateDashboard(dashboard, trim(name)).then(
+      result => {
+        dialog.close();
+        navigateTo(result.dashboard.url);
+
+        const issues = getDuplicationIssues(result);
+        if (issues.length > 0) {
+          notification.warning("Dashboard duplicated, but not completely", issues.join(" "), { duration: null });
+        } else {
+          notification.success("Dashboard duplicated");
+        }
+      },
+      error => {
+        // Nothing has been created, so keep the dialog open to let the user retry
+        setSaveInProgress(false);
+        notification.error(
+          "Dashboard could not be duplicated",
+          get(error, "response.data.message") || "Please try again later."
+        );
+      }
+    );
+  }
+
+  return (
+    <Modal
+      {...dialog.props}
+      title="Duplicate Dashboard"
+      okText="Duplicate"
+      cancelText="Cancel"
+      okButtonProps={{
+        disabled: !isValid || saveInProgress,
+        loading: saveInProgress,
+        "data-test": "DuplicateDashboardSaveButton",
+      }}
+      cancelButtonProps={{
+        disabled: saveInProgress,
+      }}
+      onOk={save}
+      closable={!saveInProgress}
+      maskClosable={!saveInProgress}
+      keyboard={!saveInProgress}
+      wrapProps={{
+        "data-test": "DuplicateDashboardDialog",
+      }}>
+      <Input
+        value={name}
+        onChange={event => setName(event.target.value)}
+        onPressEnter={save}
+        placeholder="Dashboard Name"
+        aria-label="Dashboard name"
+        disabled={saveInProgress}
+        onFocus={event => event.target.select()}
+        autoFocus
+      />
+    </Modal>
+  );
+}
+
+DuplicateDashboardDialog.propTypes = {
+  dialog: DialogPropType.isRequired,
+  dashboard: PropTypes.shape({
+    id: PropTypes.number.isRequired,
+    name: PropTypes.string.isRequired,
+  }).isRequired,
+};
+
+export default wrapDialog(DuplicateDashboardDialog);
