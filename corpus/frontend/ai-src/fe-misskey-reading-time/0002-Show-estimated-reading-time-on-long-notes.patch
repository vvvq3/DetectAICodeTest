From 53422ab695e1bd1bbdef26225f8f95ce611ddd04 Mon Sep 17 00:00:00 2001
From: Dev <dev@example.local>
Date: Thu, 5 Nov 2026 22:17:31 +0000
Subject: [PATCH 2/2] Show estimated reading time on long notes

Display "n min read" next to the timestamp of long notes, in the note
header (timeline, replies, quoted notes) and in the detailed note view.
It can be hidden with the new "showReadingTime" appearance setting,
which takes effect without reloading.
---
 locales/ja-JP.yml                       |  3 +++
 src/client/components/note-detailed.vue | 13 ++++++++++++-
 src/client/components/note-header.vue   | 14 ++++++++++++++
 src/client/pages/settings/general.vue   |  2 ++
 src/client/store.ts                     |  4 ++++
 5 files changed, 35 insertions(+), 1 deletion(-)

diff --git a/locales/ja-JP.yml b/locales/ja-JP.yml
index 9135cfda8a..4eee7e6b99 100644
--- a/locales/ja-JP.yml
+++ b/locales/ja-JP.yml
@@ -677,6 +677,9 @@ clearCache: "キャッシュをクリア"
 onlineUsersCount: "{n}人がオンライン"
 nUsers: "{n}ユーザー"
 nNotes: "{n}ノート"
+readingTime: "{n}分で読了"
+estimatedReadingTime: "読了時間の目安"
+showReadingTime: "長いノートに読了時間の目安を表示"
 
 _aboutMisskey:
   about: "Misskeyはsyuiloによって2014年から開発されている、オープンソースのソフトウェアです。"
