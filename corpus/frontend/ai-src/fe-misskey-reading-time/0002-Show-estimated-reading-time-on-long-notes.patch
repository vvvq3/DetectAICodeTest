+					<span class="reading-time" v-if="readingTime != null" :title="$ts.estimatedReadingTime">{{ $t('readingTime', { n: readingTime }) }}</span>
 				</div>
 				<XReactionsViewer :note="appearNote" ref="reactionsViewer"/>
 				<button @click="reply()" class="button _button">
@@ -137,6 +138,7 @@ import { focusPrev, focusNext } from '@/scripts/focus';
 import { url } from '@/config';
 import copyToClipboard from '@/scripts/copy-to-clipboard';
 import { checkWordMute } from '@/scripts/check-word-mute';
+import { getReadingTime } from '@/scripts/reading-time';
 import { userPage } from '@/filters/user';
 import * as os from '@/os';
 import { noteActions, noteViewInterruptors } from '@/store';
@@ -275,7 +277,12 @@ export default defineComponent({
 			if (this.$store.state.instanceTicker === 'always') return true;
 			if (this.$store.state.instanceTicker === 'remote' && this.appearNote.user.instance) return true;
 			return false;
-		}
+		},
+
+		readingTime(): number | null {
+			if (!this.$store.reactiveState.showReadingTime.value) return null;
+			return getReadingTime(this.appearNote.text);
+		},
 	},
 
 	async created() {
@@ -1090,6 +1097,10 @@ export default defineComponent({
 					margin: 16px 0;
 					opacity: 0.7;
 					font-size: 0.9em;
+
+					> .reading-time {
+						margin-left: 8px;
+					}
 				}
 
 				> .button {
