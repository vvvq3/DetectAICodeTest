+// test is located in test/reading-time.ts
+
+import { MfmForest, MfmTree } from '../../mfm/prelude';
+import { parse } from '../../mfm/parse';
+
+/**
+ * この文字数(プレーンテキスト換算)を超えるノートにのみ読了時間を表示する
+ */
+export const READING_TIME_THRESHOLD = 500;
+
+/**
+ * 分かち書きされる言語(英語など)の1分あたりの読書速度(単語)
+ */
+export const WORDS_PER_MINUTE = 200;
+
+/**
+ * CJK(漢字・かな・ハングル)の1分あたりの読書速度(文字)
+ */
+export const CJK_CHARS_PER_MINUTE = 500;
+
+/**
+ * 単語ではなく1文字ずつ数える文字
+ * - Hangul Jamo (U+1100-11FF)
+ * - 々〆〇 (U+3005-3007)
+ * - Hiragana, Katakana (U+3040-30FF)
+ * - Bopomofo, Hangul Compatibility Jamo (U+3100-318F)
+ * - Katakana Phonetic Extensions (U+31F0-31FF)
+ * - CJK Unified Ideographs Extension A, CJK Unified Ideographs (U+3400-4DBF, U+4E00-9FFF)
+ * - Hangul Syllables (U+AC00-D7AF)
+ * - CJK Compatibility Ideographs (U+F900-FAFF)
+ * - Halfwidth Katakana (U+FF66-FF9F)
+ * - CJK Unified Ideographs Extension B-F, CJK Compatibility Ideographs Supplement (U+20000-2FA1F)
+ */
+const CJK_REGEX = /[ᄀ-ᇿ々-〇぀-ヿ㄀-㆏ㇰ-ㇿ㐀-䶿一-鿿가-힯豈-﫿ｦ-ﾟ\u{20000}-\u{2fa1f}]/gu;
+
+/**
+ * 句読点・記号・絵文字のみからなるトークンは単語として数えない
+ */
+const SYMBOLS_ONLY_REGEX = /^[\x21-\x2f\x3a-\x40\x5b-\x60\x7b-\x7e¡-¿×÷ -⯿　-〿︀-️︰-﹏！-／：-＠［-｀｛-･\u{1f000}-\u{1faff}]+$/u;
+
+function treeToPlainText(tree: MfmTree): string {
+	const { type, props } = tree.node;
+
+	switch (type) {
+		case 'text': return props.text;
+		case 'mention': return props.acct;
+		case 'hashtag': return `#${props.hashtag}`;
+		case 'inlineCode': return props.code;
+		case 'mathInline': return props.formula;
+
+		// ブロック要素は行として区切る
+		case 'blockCode': return `${props.code}\n`;
+		case 'mathBlock': return `${props.formula}\n`;
+		case 'search': return `${props.query}\n`;
+		case 'quote':
+		case 'center': return `${forestToPlainText(tree.children)}\n`;
+
+		// URLや絵文字は「読む」ものではないので除外する
+		case 'url':
+		case 'emoji': return '';
+
+		// bold, small, italic, strike, fn, link など
+		default: return forestToPlainText(tree.children);
+	}
+}
+
+function forestToPlainText(forest: MfmForest): string {
+	return forest.map(treeToPlainText).join('');
+}
+
+/**
+ * MFMの構文木から、装飾・URL・絵文字を取り除いたプレーンテキストを得ます
+ */
+export function toPlainText(forest: MfmForest | null): string {
+	if (forest == null) return '';
+	return forestToPlainText(forest).trim();
+}
+
+/**
+ * テキストに含まれるCJKの文字数と、それ以外の単語数を数えます
+ */
+export function countReadingUnits(text: string): { cjkChars: number; words: number; } {
+	const cjkChars = (text.match(CJK_REGEX) || []).length;
+
+	const words = text
+		.replace(CJK_REGEX, ' ')
+		.split(/\s+/)
+		.filter(token => token !== '' && !SYMBOLS_ONLY_REGEX.test(token))
+		.length;
+
+	return { cjkChars, words };
+}
+
+/**
+ * プレーンテキストを読むのに掛かる時間を分単位(切り上げ)で推定します
+ * 読むものが何もなければ0、そうでなければ最低でも1を返します
+ */
+export function estimateReadingMinutes(text: string): number {
+	const { cjkChars, words } = countReadingUnits(text);
+	if (cjkChars === 0 && words === 0) return 0;
+
+	const minutes = (cjkChars / CJK_CHARS_PER_MINUTE) + (words / WORDS_PER_MINUTE);
+	return Math.max(1, Math.ceil(minutes));
+}
+
+/**
+ * ノート本文(MFM)の読了時間を分単位で推定します
+ * 本文が短い(READING_TIME_THRESHOLD文字以下の)場合は null を返します
+ */
+export function getReadingTime(text: string | null | undefined): number | null {
+	// プレーンテキストが元の本文より長くなることはないので、短い本文はパースせずに弾く
+	if (text == null || text.length <= READING_TIME_THRESHOLD) return null;
+
+	const plainText = toPlainText(parse(text));
+	if (Array.from(plainText).length <= READING_TIME_THRESHOLD) return null;
+
+	return estimateReadingMinutes(plainText);
+}
