+/*
+ * Tests of reading time estimation
+ *
+ * How to run the tests:
+ * > npx cross-env TS_NODE_FILES=true TS_NODE_TRANSPILE_ONLY=true npx mocha test/reading-time.ts --require ts-node/register
+ *
+ * To specify test:
+ * > npx cross-env TS_NODE_FILES=true TS_NODE_TRANSPILE_ONLY=true npx mocha test/reading-time.ts --require ts-node/register -g 'test name'
+ */
+
+import * as assert from 'assert';
+
+import { parse } from '../src/mfm/parse';
+import { toPlainText, countReadingUnits, estimateReadingMinutes, getReadingTime } from '../src/client/scripts/reading-time';
+
+function words(n: number): string {
+	return Array(n).fill('word').join(' ');
+}
+
+describe('Reading time', () => {
+	describe('toPlainText', () => {
+		it('null', () => {
+			assert.strictEqual(toPlainText(null), '');
+		});
+
+		it('strips decorations', () => {
+			assert.strictEqual(toPlainText(parse('Hello **world** and <small>small</small> ~~text~~')), 'Hello world and small text');
+		});
+
+		it('strips urls and emojis', () => {
+			assert.strictEqual(toPlainText(parse('Hello :misskey: 🍮 https://example.com')), 'Hello');
+		});
+
+		it('keeps only the label of links', () => {
+			assert.strictEqual(toPlainText(parse('[Misskey](https://misskey.io) is fun')), 'Misskey is fun');
+		});
+
+		it('keeps mentions and hashtags', () => {
+			assert.strictEqual(toPlainText(parse('@alice #misskey')), '@alice #misskey');
+		});
+
+		it('keeps code', () => {
+			assert.strictEqual(toPlainText(parse('Run `yarn build` first')), 'Run yarn build first');
+		});
+
+		it('separates blocks with newlines', () => {
+			assert.strictEqual(toPlainText(parse('> quoted\nafter')), 'quoted\nafter');
+		});
+	});
+
+	describe('countReadingUnits', () => {
+		it('empty', () => {
+			assert.deepStrictEqual(countReadingUnits(''), { cjkChars: 0, words: 0 });
+		});
+
+		it('counts words separated by whitespace', () => {
+			assert.deepStrictEqual(countReadingUnits('The quick  brown\nfox\tjumps'), { cjkChars: 0, words: 5 });
+		});
+
+		it('does not count punctuation-only tokens as words', () => {
+			assert.deepStrictEqual(countReadingUnits('Hello , world ! — ...'), { cjkChars: 0, words: 2 });
+		});
+
+		it('counts non-latin words', () => {
+			assert.deepStrictEqual(countReadingUnits('Привет мир'), { cjkChars: 0, words: 2 });
+		});
+
+		it('counts japanese by characters', () => {
+			assert.deepStrictEqual(countReadingUnits('吾輩は猫である。名前はまだ無い。'), { cjkChars: 14, words: 0 });
+		});
+
+		it('counts chinese by characters', () => {
+			assert.deepStrictEqual(countReadingUnits('你好，世界'), { cjkChars: 4, words: 0 });
+		});
+
+		it('counts korean by characters', () => {
+			assert.deepStrictEqual(countReadingUnits('안녕하세요 세계'), { cjkChars: 7, words: 0 });
+		});
+
+		it('counts surrogate pair ideographs as one character', () => {
+			assert.deepStrictEqual(countReadingUnits('𠮷野家'), { cjkChars: 3, words: 0 });
+		});
+
+		it('mixed', () => {
+			assert.deepStrictEqual(countReadingUnits('今日はMisskeyのbuildを試した'), { cjkChars: 8, words: 2 });
+		});
+	});
+
+	describe('estimateReadingMinutes', () => {
+		it('nothing to read', () => {
+			assert.strictEqual(estimateReadingMinutes(''), 0);
+			assert.strictEqual(estimateReadingMinutes('... !!'), 0);
+		});
+
+		it('at least 1 minute', () => {
+			assert.strictEqual(estimateReadingMinutes('word'), 1);
+		});
+
+		it('words', () => {
+			assert.strictEqual(estimateReadingMinutes(words(400)), 2);
+			assert.strictEqual(estimateReadingMinutes(words(401)), 3);
+		});
+
+		it('cjk characters', () => {
+			assert.strictEqual(estimateReadingMinutes('あ'.repeat(1000)), 2);
+			assert.strictEqual(estimateReadingMinutes('あ'.repeat(1001)), 3);
+		});
+
+		it('mixed', () => {
+			// 250 / 500 + 100 / 200 = 1
+			assert.strictEqual(estimateReadingMinutes(`${'あ'.repeat(250)} ${words(100)}`), 1);
+			assert.strictEqual(estimateReadingMinutes(`${'あ'.repeat(251)} ${words(100)}`), 2);
+		});
+	});
+
+	describe('getReadingTime', () => {
+		it('no text', () => {
+			assert.strictEqual(getReadingTime(null), null);
+			assert.strictEqual(getReadingTime(undefined), null);
+			assert.strictEqual(getReadingTime(''), null);
+		});
+
+		it('short note', () => {
+			assert.strictEqual(getReadingTime('Hello, world!'), null);
+		});
+
+		it('threshold', () => {
+			assert.strictEqual(getReadingTime('a'.repeat(500)), null);
+			assert.strictEqual(getReadingTime('a'.repeat(501)), 1);
+		});
+
+		it('long english note', () => {
+			// 9 words * 50 = 450 words
+			const text = 'The quick brown fox jumps over the lazy dog. '.repeat(50);
+			assert.strictEqual(getReadingTime(text), 3);
+		});
+
+		it('long japanese note', () => {
+			// 14 chars * 50 = 700 chars
+			const text = '吾輩は猫である。名前はまだ無い。'.repeat(50);
+			assert.strictEqual(getReadingTime(text), 2);
+		});
+
+		it('ignores markup when deciding whether the note is long', () => {
+			const text = `Look at this https://example.com/${'a'.repeat(600)}`;
+			assert.strictEqual(getReadingTime(text), null);
+		});
+	});
+});
