+Компонент для выставления и отображения оценки в виде звёзд. По умолчанию звёзд пять, их количество задаётся свойством `max`.
+
+Компонент может быть контролируемым (`value` + `onChange`) и неконтролируемым (`defaultValue`). При наведении мышью звёзды
+подсвечиваются до той, что под курсором, — так пользователь видит оценку до клика. Оценку можно менять с клавиатуры:
+`←` и `↓` уменьшают её, `→` и `↑` увеличивают, `Home` и `End` выставляют минимальную и максимальную.
+
+В режиме `readOnly` компонент только отображает оценку. В этом режиме `value` может быть дробным — например, средняя оценка 4.3.
+
+```jsx
+const RatingExample = () => {
+  const [rating, setRating] = React.useState(4);
+
+  return (
+    <View activePanel="rating">
+      <Panel id="rating">
+        <PanelHeader>Rating</PanelHeader>
+        <Group>
+          <FormItem top="Оцените приложение" bottom={rating ? `Ваша оценка: ${rating}` : 'Оценка не выставлена'}>
+            <Rating value={rating} onChange={setRating} />
+          </FormItem>
+          <FormItem top="Неконтролируемый, 10 звёзд">
+            <Rating defaultValue={7} max={10} size="s" />
+          </FormItem>
+          <FormItem top="Недоступен">
+            <Rating defaultValue={3} disabled />
+          </FormItem>
+        </Group>
+        <Group header={<Header mode="secondary">Размеры</Header>}>
+          <FormItem top="s">
+            <Rating defaultValue={3} size="s" />
+          </FormItem>
+          <FormItem top="m">
+            <Rating defaultValue={3} size="m" />
+          </FormItem>
+          <FormItem top="l">
+            <Rating defaultValue={3} size="l" />
+          </FormItem>
+        </Group>
+        <Group header={<Header mode="secondary">Только для чтения</Header>}>
+          <SimpleCell
+            before={<Avatar src={getAvatarUrl('app_shorm_online')} mode="app" />}
+            description={<Rating value={4.3} readOnly size="s" />}
+            indicator="4.3"
+          >
+            Шторм онлайн
+          </SimpleCell>
+          <SimpleCell
+            before={<Avatar src={getAvatarUrl('app_zagadki')} mode="app" />}
+            description={<Rating value={3.5} readOnly size="s" />}
+            indicator="3.5"
+          >
+            Загадки детства
+          </SimpleCell>
+        </Group>
+      </Panel>
+    </View>
+  );
+};
+
+<RatingExample />
+```
