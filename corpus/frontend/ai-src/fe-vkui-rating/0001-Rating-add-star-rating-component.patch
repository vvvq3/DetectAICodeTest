diff --git a/src/components/Rating/Rating.tsx b/src/components/Rating/Rating.tsx
new file mode 100644
index 0000000000..4410651b2e
--- /dev/null
+++ b/src/components/Rating/Rating.tsx
@@ -0,0 +1,198 @@
+import React, {
+  FunctionComponent,
+  HTMLAttributes,
+  KeyboardEvent,
+  MouseEvent,
+  ReactElement,
+  SyntheticEvent,
+  useState,
+} from 'react';
+import classNames from '../../lib/classNames';
+import getClassName from '../../helpers/getClassName';
+import usePlatform from '../../hooks/usePlatform';
+import withAdaptivity, { AdaptivityProps } from '../../hoc/withAdaptivity';
+import { HasRootRef } from '../../types';
+
+export interface RatingProps extends
+  Omit<HTMLAttributes<HTMLDivElement>, 'onChange' | 'defaultValue'>,
+  HasRootRef<HTMLDivElement>,
+  Pick<AdaptivityProps, 'hasMouse'> {
+  /**
+   * Текущая оценка, если компонент контролируемый. `0` — оценка не выставлена.
+   *
+   * В режиме `readOnly` значение может быть дробным: последняя звезда закрашивается частично.
+   */
+  value?: number;
+  /**
+   * Начальная оценка, если компонент неконтролируемый
+   */
+  defaultValue?: number;
+  /**
+   * Максимальная оценка, она же количество звёзд
+   */
+  max?: number;
+  /**
+   * Режим только для чтения: оценку нельзя изменить, звёзды не реагируют на наведение и клавиатуру
+   */
+  readOnly?: boolean;
+  disabled?: boolean;
+  size?: 's' | 'm' | 'l';
+  /**
+   * Если передано, рядом рендерится `<input type="hidden" />` с этим именем и текущей оценкой —
+   * чтобы значение отправлялось вместе с формой
+   */
+  name?: string;
+  onChange?(value: number, e: SyntheticEvent<HTMLDivElement>): void;
+}
+
+const starIcon: ReactElement = (
+  <svg className="Rating__icon" viewBox="0 0 24 24" aria-hidden="true">
+    <path d="M12 1.9l2.88 7.04 7.58.56-5.8 4.91 1.81 7.39L12 17.8l-6.47 4 1.81-7.39-5.8-4.91 7.58-.56z" />
+  </svg>
+);
+
+function clamp(value: number, min: number, max: number) {
+  return Math.min(Math.max(value, min), max);
+}
+
+/**
+ * Возвращает оценку, которую нужно выставить по нажатию клавиши,
+ * или `null`, если клавиша не управляет компонентом
+ */
+export function getValueByKey(key: string, value: number, max: number): number | null {
+  switch (key) {
+    case 'ArrowRight':
+    case 'ArrowUp':
+      return Math.min(Math.floor(value) + 1, max);
+    case 'ArrowLeft':
+    case 'ArrowDown':
+      // С клавиатуры оценку можно уменьшить до 1, но не сбросить
+      return value > 1 ? Math.ceil(value) - 1 : value;
+    case 'Home':
+      return 1;
+    case 'End':
+      return max;
+    default:
+      return null;
+  }
+}
+
+export const Rating: FunctionComponent<RatingProps> = (props: RatingProps) => {
+  const {
+    value,
+    defaultValue,
+    max,
+    readOnly,
+    disabled,
+    size,
+    name,
+    onChange,
+    className,
+    getRootRef,
+    onKeyDown,
+    onMouseLeave,
+    hasMouse,
+    ...restProps
+  } = props;
+  const platform = usePlatform();
+
+  const [innerValue, setInnerValue] = useState(defaultValue);
+  // 0 — курсор не над звёздами
+  const [hoveredValue, setHoveredValue] = useState(0);
+
+  const isControlled = value !== undefined;
+  const currentValue = clamp(isControlled ? value : innerValue, 0, max);
+  const interactive = !readOnly && !disabled;
+  const displayedValue = interactive && hoveredValue > 0 ? hoveredValue : currentValue;
+
+  const select = (nextValue: number, e: SyntheticEvent<HTMLDivElement>) => {
+    if (nextValue === currentValue) {
+      return;
+    }
+    if (!isControlled) {
+      setInnerValue(nextValue);
+    }
+    onChange && onChange(nextValue, e);
+  };
+
+  const handleKeyDown = (e: KeyboardEvent<HTMLDivElement>) => {
+    onKeyDown && onKeyDown(e);
+
+    if (!interactive || e.defaultPrevented) {
+      return;
+    }
+
+    const nextValue = getValueByKey(e.key, currentValue, max);
+    if (nextValue === null) {
+      return;
+    }
+
+    // Стрелки не должны прокручивать страницу
+    e.preventDefault();
+    setHoveredValue(0);
+    select(nextValue, e);
+  };
+
+  const handleMouseLeave = (e: MouseEvent<HTMLDivElement>) => {
+    onMouseLeave && onMouseLeave(e);
+    setHoveredValue(0);
+  };
+
+  const stars: ReactElement[] = [];
+  for (let starValue = 1; starValue <= max; starValue++) {
+    const fill = clamp(displayedValue - starValue + 1, 0, 1);
+
+    stars.push(
+      <div
+        key={starValue}
+        className={classNames('Rating__star', { 'Rating__star--active': fill > 0 })}
+        onClick={interactive ? (e) => select(starValue, e) : undefined}
+        // На тач-устройствах наведения нет, а эмуляция mouseenter при тапе только мешает
+        onMouseEnter={interactive && hasMouse ? () => setHoveredValue(starValue) : undefined}
+      >
+        {starIcon}
+        <div className="Rating__fill" style={{ width: `${fill * 100}%` }}>
+          {starIcon}
+        </div>
+      </div>,
+    );
+  }
+
+  return (
+    <div
+      // В режиме чтения это просто картинка, иначе — слайдер со значением от 0 до max
+      role={readOnly ? 'img' : 'slider'}
+      aria-label={readOnly ? `${currentValue} / ${max}` : undefined}
+      tabIndex={interactive ? 0 : undefined}
+      aria-valuemin={readOnly ? undefined : 0}
+      aria-valuemax={readOnly ? undefined : max}
+      aria-valuenow={readOnly ? undefined : currentValue}
+      aria-disabled={disabled || undefined}
+      {...restProps}
+      ref={getRootRef}
+      className={classNames(getClassName('Rating', platform), `Rating--${size}`, {
+        'Rating--interactive': interactive,
+        'Rating--readonly': readOnly,
+        'Rating--disabled': disabled,
+      }, className)}
+      onKeyDown={handleKeyDown}
+      onMouseLeave={handleMouseLeave}
+    >
+      {stars}
+      {name !== undefined &&
+        <input type="hidden" name={name} value={currentValue} disabled={disabled} />
+      }
+    </div>
+  );
+};
+
+Rating.defaultProps = {
+  defaultValue: 0,
+  max: 5,
+  size: 'm',
+  hasMouse: true,
+};
+
+export default withAdaptivity(Rating, {
+  hasMouse: true,
+});
