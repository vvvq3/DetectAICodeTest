+import { CommonModule } from '@angular/common';
+import { NgModule } from '@angular/core';
+import { CmsConfig, I18nModule, provideDefaultConfig } from '@spartacus/core';
+import { IconModule } from '../../misc/icon/icon.module';
+import { BackToTopComponent } from './back-to-top.component';
+import { defaultBackToTopConfig } from './config/default-back-to-top-config';
+
+@NgModule({
+  imports: [CommonModule, I18nModule, IconModule],
+  providers: [
+    provideDefaultConfig(<CmsConfig>{
+      cmsComponents: {
+        BackToTopComponent: {
+          component: BackToTopComponent,
+        },
+      },
+    }),
+    provideDefaultConfig(defaultBackToTopConfig),
+  ],
+  declarations: [BackToTopComponent],
+  exports: [BackToTopComponent],
+  entryComponents: [BackToTopComponent],
+})
+export class BackToTopModule {}
