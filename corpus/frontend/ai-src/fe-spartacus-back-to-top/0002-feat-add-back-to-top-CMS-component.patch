@@ -0,0 +1,161 @@
+import {
+  ChangeDetectionStrategy,
+  ChangeDetectorRef,
+  Component,
+  NgZone,
+  OnDestroy,
+  OnInit,
+} from '@angular/core';
+import { WindowRef } from '@spartacus/core';
+import { combineLatest, fromEvent, Observable, Subscription } from 'rxjs';
+import {
+  auditTime,
+  distinctUntilChanged,
+  map,
+  startWith,
+} from 'rxjs/operators';
+import { CmsComponentData } from '../../../cms-structure/page/model/cms-component-data';
+import { ICON_TYPE } from '../../misc/icon/icon.model';
+import { CmsBackToTopComponent } from './back-to-top.model';
+import { BackToTopConfig } from './config/back-to-top-config';
+import { defaultBackToTopConfig } from './config/default-back-to-top-config';
+
+/**
+ * Time (in ms) used to throttle the evaluation of scroll events.
+ */
+const SCROLL_AUDIT_TIME = 100;
+
+/**
+ * Renders a floating button that brings the user back to the top of the page.
+ *
+ * The button is only rendered once the page is scrolled beyond the display
+ * threshold, which is taken from the CMS component data, or the global
+ * `backToTop.displayThreshold` configuration otherwise.
+ */
+@Component({
+  selector: 'cx-back-to-top',
+  templateUrl: './back-to-top.component.html',
+  changeDetection: ChangeDetectionStrategy.OnPush,
+})
+export class BackToTopComponent implements OnInit, OnDestroy {
+  iconType = ICON_TYPE;
+
+  /**
+   * Indicates whether the page is scrolled beyond the display threshold.
+   */
+  isVisible = false;
+
+  protected subscription = new Subscription();
+
+  constructor(
+    protected componentData: CmsComponentData<CmsBackToTopComponent>,
+    protected config: BackToTopConfig,
+    protected winRef: WindowRef,
+    protected ngZone: NgZone,
+    protected cd: ChangeDetectorRef
+  ) {}
+
+  ngOnInit(): void {
+    const win = this.winRef.nativeWindow;
+    if (!win) {
+      // there's nothing to scroll during server side rendering
+      return;
+    }
+
+    // Scroll events fire at a high rate, so we listen to them outside of the
+    // Angular zone and only re-enter the zone when the visibility changes.
+    this.ngZone.runOutsideAngular(() => {
+      this.subscription.add(
+        combineLatest([this.getThreshold(), this.getScrollPosition(win)])
+          .pipe(
+            map(([threshold, position]) => position > threshold),
+            distinctUntilChanged()
+          )
+          .subscribe((visible) =>
+            this.ngZone.run(() => {
+              this.isVisible = visible;
+              this.cd.markForCheck();
+            })
+          )
+      );
+    });
+  }
+
+  /**
+   * Scrolls (smoothly) to the top of the page and moves the focus to the
+   * start of the document, so that keyboard users continue from the top
+   * rather than from the button, which disappears once the top is reached.
+   */
+  scrollToTop(): void {
+    const win = this.winRef.nativeWindow;
+    if (!win) {
+      return;
+    }
+    win.scrollTo({ top: 0, behavior: this.getScrollBehavior(win) });
+    this.focusDocumentStart();
+  }
+
+  ngOnDestroy(): void {
+    this.subscription.unsubscribe();
+  }
+
+  protected getThreshold(): Observable<number> {
+    return this.componentData.data$.pipe(
+      map((data) => this.resolveThreshold(data?.displayThreshold)),
+      distinctUntilChanged()
+    );
+  }
+
+  protected getScrollPosition(win: Window): Observable<number> {
+    return fromEvent(win, 'scroll', { passive: true }).pipe(
+      auditTime(SCROLL_AUDIT_TIME),
+      map(() => win.pageYOffset),
+      // emit the initial position, as the page might be scrolled already
+      startWith(win.pageYOffset)
+    );
+  }
+
+  /**
+   * Resolves the threshold from the CMS data. Falls back to the configured
+   * threshold when the CMS value is missing or invalid.
+   */
+  protected resolveThreshold(cmsThreshold?: number | string): number {
+    const threshold = parseFloat(String(cmsThreshold));
+    if (threshold >= 0) {
+      return threshold;
+    }
+    return (
+      this.config.backToTop?.displayThreshold ??
+      defaultBackToTopConfig.backToTop.displayThreshold
+    );
+  }
+
+  /**
+   * Returns a smooth scroll behavior, unless the user has asked the system
+   * to minimize non-essential motion.
+   */
+  protected getScrollBehavior(win: Window): ScrollBehavior {
+    const reducedMotion = win.matchMedia?.('(prefers-reduced-motion: reduce)');
+    return reducedMotion?.matches ? 'auto' : 'smooth';
+  }
+
+  /**
+   * Moves the focus to the document body, so that the next tab stop is the
+   * first focusable element of the page.
+   */
+  protected focusDocumentStart(): void {
+    const body = this.winRef.document.body;
+    if (!body) {
+      return;
+    }
+    // the body is only focusable with a tabindex, which we add temporarily
+    const hasTabindex = body.hasAttribute('tabindex');
+    if (!hasTabindex) {
+      body.setAttribute('tabindex', '-1');
+    }
+    body.focus({ preventScroll: true });
+    if (!hasTabindex) {
+      body.removeAttribute('tabindex');
+    }
+  }
+}
