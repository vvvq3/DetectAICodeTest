+import { CmsComponent } from '@spartacus/core';
+
+export interface CmsBackToTopComponent extends CmsComponent {
+  /**
+   * The vertical scroll distance (in pixels) after which the button is shown.
+   * Overrides the global `backToTop.displayThreshold` configuration.
+   *
+   * CMS attributes are not always delivered as numbers, which is why a
+   * string representation is accepted as well.
+   */
+  displayThreshold?: number | string;
+}
