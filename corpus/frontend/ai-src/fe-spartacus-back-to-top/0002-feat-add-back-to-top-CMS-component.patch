+import { Component, Input } from '@angular/core';
+import {
+  ComponentFixture,
+  fakeAsync,
+  TestBed,
+  tick,
+  waitForAsync,
+} from '@angular/core/testing';
+import { I18nTestingModule, WindowRef } from '@spartacus/core';
+import { BehaviorSubject } from 'rxjs';
+import { CmsComponentData } from '../../../cms-structure/page/model/cms-component-data';
+import { BackToTopComponent } from './back-to-top.component';
+import { CmsBackToTopComponent } from './back-to-top.model';
+import { BackToTopConfig } from './config/back-to-top-config';
+
+const SCROLL_AUDIT_TIME = 100;
+
+@Component({
+  selector: 'cx-icon',
+  template: '',
+})
+class MockIconComponent {
+  @Input() type: string;
+}
+
+/**
+ * Minimal window replacement, which allows to control the scroll position
+ * and dispatch scroll events without scrolling the test runner page.
+ */
+class MockWindow {
+  pageYOffset = 0;
+  scrollTo = jasmine.createSpy('scrollTo');
+  matchMedia = jasmine
+    .createSpy('matchMedia')
+    .and.returnValue({ matches: false });
+
+  protected eventTarget = document.createElement('div');
+
+  addEventListener(type: string, listener: any, options?: any): void {
+    this.eventTarget.addEventListener(type, listener, options);
+  }
+
+  removeEventListener(type: string, listener: any, options?: any): void {
+    this.eventTarget.removeEventListener(type, listener, options);
+  }
+
+  scroll(position: number): void {
+    this.pageYOffset = position;
+    this.eventTarget.dispatchEvent(new Event('scroll'));
+  }
+}
+
+describe('BackToTopComponent', () => {
+  let component: BackToTopComponent;
+  let fixture: ComponentFixture<BackToTopComponent>;
+  let mockWindow: MockWindow;
+  let componentData$: BehaviorSubject<CmsBackToTopComponent>;
+  let winRef: { nativeWindow: any; document: Document };
+
+  beforeEach(
+    waitForAsync(() => {
+      mockWindow = new MockWindow();
+      componentData$ = new BehaviorSubject<CmsBackToTopComponent>({});
+      winRef = { nativeWindow: mockWindow, document };
+
+      TestBed.configureTestingModule({
+        imports: [I18nTestingModule],
+        declarations: [BackToTopComponent, MockIconComponent],
+        providers: [
+          { provide: WindowRef, useValue: winRef },
+          {
+            provide: CmsComponentData,
+            useValue: { data$: componentData$.asObservable() },
+          },
+          {
+            provide: BackToTopConfig,
+            useValue: { backToTop: { displayThreshold: 400 } },
+          },
+        ],
+      }).compileComponents();
+    })
+  );
+
+  function createComponent(): void {
+    fixture = TestBed.createComponent(BackToTopComponent);
+    component = fixture.componentInstance;
+    fixture.detectChanges();
+  }
+
+  function scrollTo(position: number): void {
+    mockWindow.scroll(position);
+    tick(SCROLL_AUDIT_TIME);
+    fixture.detectChanges();
+  }
+
+  function getButton(): HTMLButtonElement {
+    return fixture.nativeElement.querySelector('button');
+  }
+
+  it('should create', () => {
+    createComponent();
+    expect(component).toBeTruthy();
+  });
+
+  describe('visibility', () => {
+    it('should not render the button at the top of the page', () => {
+      createComponent();
+      expect(component.isVisible).toBe(false);
+      expect(getButton()).toBeNull();
+    });
+
+    it('should render the button when scrolled beyond the default threshold', fakeAsync(() => {
+      createComponent();
+
+      scrollTo(400);
+      expect(getButton()).toBeNull();
+
+      scrollTo(401);
+      expect(component.isVisible).toBe(true);
+      expect(getButton()).toBeTruthy();
+    }));
+
+    it('should remove the button when scrolled back above the threshold', fakeAsync(() => {
+      createComponent();
+
+      scrollTo(800);
+      expect(getButton()).toBeTruthy();
+
+      scrollTo(100);
+      expect(component.isVisible).toBe(false);
+      expect(getButton()).toBeNull();
+    }));
+
+    it('should render the button when the page is initially scrolled', () => {
+      mockWindow.pageYOffset = 1000;
+      createComponent();
+      expect(getButton()).toBeTruthy();
+    });
+
+    it('should only evaluate the scroll position once per audit time', fakeAsync(() => {
+      createComponent();
+
+      mockWindow.scroll(500);
+      mockWindow.scroll(1000);
+      fixture.detectChanges();
+      expect(getButton()).toBeNull();
+
+      tick(SCROLL_AUDIT_TIME);
+      fixture.detectChanges();
+      expect(getButton()).toBeTruthy();
+    }));
+
+    it('should not render anything when there is no window (SSR)', () => {
+      winRef.nativeWindow = undefined;
+      createComponent();
+
+      expect(component.isVisible).toBe(false);
+      expect(getButton()).toBeNull();
+      expect(() => component.scrollToTop()).not.toThrow();
+    });
+  });
+
+  describe('threshold', () => {
+    it('should use the threshold from the CMS component data', fakeAsync(() => {
+      componentData$.next({ displayThreshold: 100 });
+      createComponent();
+
+      scrollTo(150);
+      expect(getButton()).toBeTruthy();
+    }));
+
+    it('should accept a threshold string from the CMS component data', fakeAsync(() => {
+      componentData$.next({ displayThreshold: '1000' });
+      createComponent();
+
+      scrollTo(500);
+      expect(getButton()).toBeNull();
+
+      scrollTo(1001);
+      expect(getButton()).toBeTruthy();
+    }));
+
+    it('should fall back to the configured threshold for an invalid CMS value', fakeAsync(() => {
+      componentData$.next({ displayThreshold: 'invalid' });
+      createComponent();
+
+      scrollTo(300);
+      expect(getButton()).toBeNull();
+
+      scrollTo(500);
+      expect(getButton()).toBeTruthy();
+    }));
+
+    it('should re-evaluate the visibility when the CMS data changes', fakeAsync(() => {
+      createComponent();
+
+      scrollTo(300);
+      expect(getButton()).toBeNull();
+
+      componentData$.next({ displayThreshold: 200 });
+      fixture.detectChanges();
+      expect(getButton()).toBeTruthy();
+    }));
+  });
+
+  describe('scrollToTop', () => {
+    it('should smoothly scroll to the top of the page on click', fakeAsync(() => {
+      createComponent();
+      scrollTo(1000);
+
+      getButton().click();
+
+      expect(mockWindow.scrollTo).toHaveBeenCalledWith({
+        top: 0,
+        behavior: 'smooth',
+      });
+    }));
+
+    it('should not animate the scroll when the user prefers reduced motion', fakeAsync(() => {
+      mockWindow.matchMedia.and.returnValue({ matches: true });
+      createComponent();
+      scrollTo(1000);
+
+      getButton().click();
+
+      expect(mockWindow.matchMedia).toHaveBeenCalledWith(
+        '(prefers-reduced-motion: reduce)'
+      );
+      expect(mockWindow.scrollTo).toHaveBeenCalledWith({
+        top: 0,
+        behavior: 'auto',
+      });
+    }));
+
+    it('should move the focus to the start of the document', fakeAsync(() => {
+      createComponent();
+      scrollTo(1000);
+
+      const button = getButton();
+      button.focus();
+      expect(document.activeElement).toBe(button);
+
+      button.click();
+
+      expect(document.activeElement).toBe(document.body);
+      expect(document.body.hasAttribute('tabindex')).toBe(false);
+    }));
+  });
+
+  describe('accessibility', () => {
+    it('should render a native button, so that it is keyboard accessible', fakeAsync(() => {
+      createComponent();
+      scrollTo(1000);
+
+      const button = getButton();
+      expect(button.tagName).toEqual('BUTTON');
+      expect(button.getAttribute('type')).toEqual('button');
+    }));
+
+    it('should provide an accessible label', fakeAsync(() => {
+      createComponent();
+      scrollTo(1000);
+
+      expect(getButton().getAttribute('aria-label')).toEqual('backToTop.label');
+    }));
+  });
+
+  describe('ngOnDestroy', () => {
+    it('should remove the scroll listener', fakeAsync(() => {
+      spyOn(mockWindow, 'removeEventListener').and.callThrough();
+      createComponent();
+
+      fixture.destroy();
+
+      expect(mockWindow.removeEventListener).toHaveBeenCalledWith(
+        'scroll',
+        jasmine.any(Function),
+        jasmine.objectContaining({ passive: true })
+      );
+    }));
+
+    it('should no longer react to scroll events', fakeAsync(() => {
+      createComponent();
+      fixture.destroy();
+
+      mockWindow.scroll(1000);
+      tick(SCROLL_AUDIT_TIME);
+
+      expect(component.isVisible).toBe(false);
+    }));
+  });
+});
