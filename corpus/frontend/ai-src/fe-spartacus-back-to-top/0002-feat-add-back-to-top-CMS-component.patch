+import { Injectable } from '@angular/core';
+import { Config } from '@spartacus/core';
+
+/**
+ * Configuration options for the back to top component.
+ */
+@Injectable({
+  providedIn: 'root',
+  useExisting: Config,
+})
+export abstract class BackToTopConfig {
+  backToTop?: {
+    /**
+     * The vertical scroll distance (in pixels) after which the back to top
+     * button is shown. The value can be overridden for a single component
+     * by the `displayThreshold` property of the CMS component data.
+     *
+     * Defaults to 400.
+     */
+    displayThreshold?: number;
+  };
+}
